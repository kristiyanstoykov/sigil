# Template for .env — copy to .env and fill in real values (.env is git-ignored).
#
# Env file loading (later overrides earlier):
#   .env            committed-in-spirit defaults (here .env is git-ignored; this
#                   .env.example is the committed template)
#   .env.local      uncommitted local overrides + REAL secrets
#   .env.test       committed test defaults (no secrets)
#
# Real environment variables win over all .env files.
# DO NOT put production secrets in any committed file — use .env.local / a vault.

###> symfony/framework-bundle ###
APP_ENV=dev
# Any non-empty string for dev; generate a real one for prod.
APP_SECRET=change_me_dev_secret
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Non-Docker local dev talks to the host-exposed DB on 5433 (see CLAUDE.md).
# In Docker, compose.yaml overrides this to db:5432.
DATABASE_URL="postgresql://sigil:sigil@127.0.0.1:5433/sigil?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Real Brevo key goes in .env.local (never committed). null://null drops mail.
MAILER_DSN=null://null
# Sender identity (not secret). Override MAILER_FROM in .env.local with an
# address verified in your Brevo account, or Brevo rejects delivery.
MAILER_FROM=noreply@example.com
MAILER_FROM_NAME=Sigil
###< symfony/mailer ###

###> sigil/certificate ###
# CA token User PIN — override with a strong secret outside dev.
SIGIL_CA_PIN=changeme-ca-pin
# Delivery-seal token User PIN (ADR-012). The application's own signing credential:
# it seals delivery receipts unattended, so unlike a user PIN it is held
# server-side. It never signs a user's document. Override outside dev.
SIGIL_SEAL_PIN=changeme-seal-pin
# PKCS#11 module for key custody (kryoptic in dev/CI; vendor lib in prod, ADR-005/014).
PKCS11_MODULE=/usr/lib/libkryoptic_pkcs11.so
# Slot list + per-token SQLite files (ADR-014); written only by bin/kryoptic_slots.py.
KRYOPTIC_CONF=/var/lib/kryoptic/token.conf
###< sigil/certificate ###

###> sigil/document ###
# Application root key (ADR-004) — base64 of 32 random bytes. Wraps every
# per-user KEK; lives ONLY in env/KMS, NEVER in the DB. Left BLANK on purpose:
# a real key must never sit in a committed file. Generate your own into .env:
#   php -r "echo base64_encode(random_bytes(32));"
# (The app fails closed with this hint until you set one. CI generates its own.)
# Application secret key (ADR-004): base64 of 32 random bytes, read by
# RootKeyProvider. NOT legacy. It is the key three things are derived from
# (HKDF, distinct contexts): the content fingerprint every receipt names
# (ContentHasher), the seal on every TOTP seed (TotpSecretVault) and the MAC on
# the audit-chain anchors (AuditAnchorSigner). Rotating or dropping it locks
# every user out of 2FA and invalidates every anchor and receipt fingerprint.
# It is also the "env" KEK-wrapping scheme (tests; pre-ADR-010 rows), while the
# token wrapper holds a separate, non-exportable AES key. Host-resident by
# nature: whoever reads this file has it - see ADR-010's addendum.
SIGIL_ROOT_KEY=
# Root wrapping key custody (ADR-010). Non-exportable AES-256 key inside a PKCS#11
# token (kryoptic in dev, real HSM/KMS in prod). Provision: `sigil:root-key:init`.
# The PIN opens the token to (un)wrap; the key itself never leaves the token.
SIGIL_ROOT_TOKEN_LABEL=sigil-root
SIGIL_ROOT_KEY_LABEL=root-kek-wrap
SIGIL_ROOT_TOKEN_PIN=
# Local-filesystem backend path (used by the "local" backend / tests).
# Empty = default %kernel.project_dir%/var/documents.
SIGIL_DOCUMENT_STORAGE_PATH=
# Active storage backend for NEW writes (ADR-009): minio | aws | local.
SIGIL_STORAGE_ACTIVE_BACKEND=minio
# MinIO (dev, S3-compatible). In Docker the app talks to http://minio:9000;
# this localhost value is for non-Docker local runs.
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=sigil-documents
MINIO_ACCESS_KEY=sigil
MINIO_SECRET_KEY=sigil_minio_dev
# AWS S3 (real). Fill in .env.local (never commit), then set
# SIGIL_STORAGE_ACTIVE_BACKEND=aws. Leave AWS_ENDPOINT empty for real AWS.
AWS_ENDPOINT=
AWS_REGION=eu-central-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
###< sigil/document ###

###> sigil/signing ###
# Active RFC-3161 TSA for new signatures (ADR-009 style): local_uts | freetsa | none.
# "none" => PAdES-B-B (no timestamp). local_uts = fast offline dev responder.
SIGIL_TSA_ACTIVE_BACKEND=local_uts
SIGIL_TSA_LOCAL_UTS_URL=http://tsa:8318/
SIGIL_TSA_FREETSA_URL=https://freetsa.org/tsr
###< sigil/signing ###

###> symfony/mercure-bundle ###
# The live push behind the notification bell (ADR-013). Nothing is lost without a
# hub: the stored row is the notification, the push only makes it arrive sooner.
# The test suite never opens a socket (RecordingHub decorates the hub), so these
# only have to be present, not reachable.
MERCURE_URL=http://localhost:3000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:3000/.well-known/mercure
# Shared HMAC key between the app and the hub. Dev value - a real deployment sets
# its own and never commits it.
MERCURE_JWT_SECRET="sigil_dev_mercure_jwt_secret_change_in_production"
###< symfony/mercure-bundle ###

###> sigil/signature-suite ###
# The suite NEW keys are generated with (ADR-006, ADR-014): ECDSA-P384-SHA384/v1
# or ML-DSA-65/v1. Every certificate carries the id it was issued under, so
# switching only redirects new issuance; existing keys keep signing and
# validating with their own suite.
SIGIL_SIGNATURE_ACTIVE_ALGORITHM=ECDSA-P384-SHA384/v1
###< sigil/signature-suite ###

###> sigil/cipher-suite ###
# The AEAD suite NEW encryptions use (ADR-006). Every envelope names its own
# suite, so switching only redirects new writes; old ciphertext stays readable.
SIGIL_CIPHER_ACTIVE_ALGORITHM=AES-256-GCM/v1
###< sigil/cipher-suite ###

###> sigil/audit-anchor ###
# Where `sigil:audit:anchor` appends signed checkpoints of the audit chain head.
# The point is a copy the database cannot reach: ship this file off the host.
SIGIL_AUDIT_ANCHOR_PATH=%kernel.project_dir%/var/audit/anchors.jsonl
###< sigil/audit-anchor ###

###> sigil/root-wrapper ###
# Which scheme wraps NEW per-user KEKs under the root key (ADR-010): pkcs11 (the
# root key lives in the token) or env (SIGIL_ROOT_KEY, pre-ADR-010). Stored KEKs
# carry their scheme byte and unwrap with the scheme that made them.
SIGIL_ROOT_WRAPPER_ACTIVE=pkcs11
###< sigil/root-wrapper ###

###> symfony/trusted-hosts ###
# Regex the Host header must match (Host-header poisoning guard for the
# absolute URLs in emails). Empty = any host, for dev only. Production:
# TRUSTED_HOSTS='^sigil\.example\.com$'
TRUSTED_HOSTS=
###< symfony/trusted-hosts ###
