# Production configuration for compose.prod.yaml. On the server:
#
#   cp .env.prod.example .env && chmod 600 .env
#
# then fill every blank. Compose refuses to start while a required one is
# empty, and Symfony reads this same file inside the container. It never goes
# into git (.env is ignored) and never comes from a dev machine.
#
# Generate the secrets on the server, one fresh value each:
#   openssl rand -hex 32        -> APP_SECRET, MERCURE_JWT_SECRET, POSTGRES_PASSWORD
#   openssl rand -base64 32     -> SIGIL_ROOT_KEY
#   openssl rand -base64 24     -> SIGIL_ROOT_TOKEN_PIN, SIGIL_CA_PIN, SIGIL_SEAL_PIN
#
# Back these up somewhere that is not this server. The token PINs and the root
# key cannot be recovered: lose them and every stored document is unreadable.

APP_ENV=prod
APP_SECRET=

# Public address. SERVER_NAME is the bare domain FrankenPHP gets a Let's
# Encrypt certificate for (DNS must already point at this server, ports 80 and
# 443 open). TRUSTED_HOSTS is a regex for the Host header.
SERVER_NAME=sigil.example.com
DEFAULT_URI=https://sigil.example.com
TRUSTED_HOSTS='^sigil\.example\.com$'
# Optional Caddy global options, e.g. an address for expiry notices:
# CADDY_GLOBAL_OPTIONS="email you@example.com"

# Only used to build DATABASE_URL in compose.prod.yaml; Postgres takes it on
# its first start, so changing it later means changing it in the database too.
POSTGRES_PASSWORD=

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mail is required: an invited user verifies their address by email.
MAILER_DSN=
MAILER_FROM=
MAILER_FROM_NAME=Sigil

# Key custody (ADR-005/010/014). The tokens live on the kryoptic_tokens volume.
PKCS11_MODULE=/usr/lib/libkryoptic_pkcs11.so
KRYOPTIC_CONF=/var/lib/kryoptic/token.conf
SIGIL_ROOT_KEY=
SIGIL_ROOT_WRAPPER_ACTIVE=pkcs11
SIGIL_ROOT_TOKEN_LABEL=sigil-root
SIGIL_ROOT_KEY_LABEL=root-kek-wrap
SIGIL_ROOT_TOKEN_PIN=
SIGIL_CA_PIN=
SIGIL_SEAL_PIN=

# Algorithms. ECDSA is what Adobe Reader validates today; ML-DSA-65/v1 is the
# post-quantum suite (ADR-014). Switching later only affects new certificates.
SIGIL_SIGNATURE_ACTIVE_ALGORITHM=ECDSA-P384-SHA384/v1
SIGIL_CIPHER_ACTIVE_ALGORITHM=AES-256-GCM/v1

# Object storage: AWS S3 only (compose.prod.yaml pins the backend to aws).
# Use an IAM key limited to this one bucket (s3:GetObject, PutObject,
# DeleteObject on bucket/*, ListBucket on the bucket) - never a dev key.
AWS_ENDPOINT=
AWS_REGION=eu-central-1
AWS_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SIGIL_DOCUMENT_STORAGE_PATH=

# Timestamps: freetsa (public, slow-ish), or local_uts together with
# `--profile local-tsa` (a responder on this same host - weaker evidence).
SIGIL_TSA_ACTIVE_BACKEND=freetsa
SIGIL_TSA_FREETSA_URL=https://freetsa.org/tsr
SIGIL_TSA_LOCAL_UTS_URL=http://tsa:8318/

# Live notifications. The app publishes inside the network (compose sets
# MERCURE_URL); the browser subscribes on the app's own origin, where Caddy
# proxies /.well-known/mercure to the hub.
MERCURE_PUBLIC_URL=https://sigil.example.com/.well-known/mercure
MERCURE_JWT_SECRET=
# Pin a release from https://github.com/dunglas/mercure/releases (e.g. the one
# dev has been running) - never `latest` in prod.
MERCURE_IMAGE_TAG=

# Inside var/, which is a container-local volume today: ship it off the host.
SIGIL_AUDIT_ANCHOR_PATH=%kernel.project_dir%/var/audit/anchors.jsonl
