# OpenSSL RFC-3161 TSA config for the Sigil DEV local timestamp responder.
# Signs TimeStampReq -> TimeStampResp via `openssl ts -reply`. Dev-only: the
# TSA key/cert are generated on first start (see entrypoint.sh) and are NOT a
# trusted authority - this exists to give fast, offline PAdES-B-T timestamps
# for development. Production uses a real qualified TSA.

[ tsa ]
default_tsa = tsa_config1

[ tsa_config1 ]
dir             = /tsa
serial          = /tsa/tsa_serial
crypto_device   = builtin
signer_cert     = /tsa/tsa.crt
certs           = /tsa/tsa.crt
signer_key      = /tsa/tsa.key
signer_digest   = sha256
default_policy  = 1.3.6.1.4.1.99999.1.1
digests         = sha256, sha384, sha512
accuracy        = secs:1
ordering        = yes
tsa_name        = yes
ess_cert_id_alg = sha256
