
###> symfony/framework-bundle ###
# .env holds real dev values (root key, PINs) so it stays out of git — copy
# .env.example to .env and fill in. .env.test is committed (no secrets).
/.env
/.env.local
/.env.local.php
/.env.*.local
/config/secrets/prod/prod.decrypt.private.php
# Dev vault holds a real Brevo API key, so keep its decrypt key out of git too.
# Encrypted secrets (config/secrets/dev/*.MAILER_DSN.*.php) stay committed; without
# this private key they cannot be decrypted. Share the key out of band.
/config/secrets/dev/dev.decrypt.private.php
/public/bundles/
/var/
/vendor/
###< symfony/framework-bundle ###

###> phpunit/phpunit ###
/phpunit.xml
/.phpunit.cache/
###< phpunit/phpunit ###

###> symfony/asset-mapper ###
/public/assets/
/assets/vendor/
###< symfony/asset-mapper ###

# Instanced Sofia Sans faces for the signature stamp (derived, regenerated on demand)
/assets/fonts/Sofia_Sans/.instanced/

# Python bytecode (bin/ driver scripts)
__pycache__/
*.py[cod]
