{% extends 'emails/base.html.twig' %}

{% block heading %}
    {% if status == 'declined' %}
        A signature request was declined
    {% elseif expired %}
        A signature request expired
    {% else %}
        A signature request was cancelled
    {% endif %}
{% endblock %}
{% block preheader %}The request to sign {{ title }} is closed.{% endblock %}

{% block body %}
    <p style="margin:0 0 16px;">
        The request to sign <strong>{{ title }}</strong> is closed
        {% if status == 'declined' %}
            because {{ declinedBy }} declined to sign it.
        {% elseif expired %}
            because its deadline of {{ deadline|date('j M Y, H:i') }} passed before everyone signed.
        {% else %}
            because {{ requester }} withdrew it.
        {% endif %}
    </p>

    {% if status == 'declined' %}
        {% if declineReason %}
            <p style="margin:0 0 16px;">They gave this reason:</p>
            <p style="margin:0 0 16px;"><em>{{ declineReason }}</em></p>
        {% else %}
            <p style="margin:0 0 16px;">They did not give a reason.</p>
        {% endif %}
        <p style="margin:0 0 16px;">Nobody further down the list was asked to sign.</p>
    {% endif %}

    {% if signed > 0 %}
        <p style="margin:0 0 16px;">{{ signed }} signature(s) were collected and are kept with the document.</p>
    {% endif %}
{% endblock %}
