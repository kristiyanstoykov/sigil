{% extends 'emails/base.html.twig' %}

{% block heading %}{{ signedBy }} signed your document{% endblock %}

{% block body %}
    <p>
        <strong>{{ title }}</strong> was signed by {{ signedBy }}. The signature was added as a new
        version; every earlier version is kept as part of the record.
    </p>

    {% if remaining is defined and remaining > 0 %}
        <p>{{ remaining }} signer(s) still have to sign before the request is complete.</p>
    {% endif %}
{% endblock %}

{% block action_url %}{{ url }}{% endblock %}
{% block action_label %}Open the document{% endblock %}
