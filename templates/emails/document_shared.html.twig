{% extends 'emails/base.html.twig' %}

{% block heading %}A document was shared with you{% endblock %}

{% block body %}
    <p>
        {{ sharedBy }} shared <strong>{{ title }}</strong> with you on Sigil. You can read and
        download it; signing it is a separate request, which nobody has made of you here.
    </p>
{% endblock %}

{% block action_url %}{{ url }}{% endblock %}
{% block action_label %}View the document{% endblock %}
