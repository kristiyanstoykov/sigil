{#
    One stat tile, on Able Pro's dashboard card pattern (dist/dashboard/index.html,
    the "All Earnings" block): icon chip + label on top, then a tinted inner panel
    carrying the number. Able Pro puts a sparkline in that panel; Sigil has no
    per-tile timeseries worth drawing, so the panel carries the number and the
    action it leads to instead.

    Params: label, value, icon, tone ('primary'|'warning'|'success'|'info'),
            hint, url, cta
#}
{% set tones = {
    'primary': 'bg-primary-500/10 text-primary-500',
    'warning': 'bg-warning-500/10 text-warning-600',
    'success': 'bg-success-500/10 text-success-600',
    'info':    'bg-info-500/10 text-info-600',
} %}

<div class="card !mb-0 p-4">
    <div class="flex items-center gap-3">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl {{ tones[tone] }}">
            <i class="ti {{ icon }} text-xl leading-none" aria-hidden="true"></i>
        </span>
        <h3 class="grow text-sm font-semibold text-theme-headings">{{ label }}</h3>
    </div>

    <div class="mt-4 rounded-lg bg-theme-bodybg/70 p-3">
        <div class="flex items-end justify-between gap-3">
            <span class="text-2xl font-extrabold leading-none text-theme-headings">{{ value }}</span>
            {% if value > 0 and url %}
                <a href="{{ url }}" class="text-xs font-semibold text-primary-500 hover:underline">{{ cta }} →</a>
            {% endif %}
        </div>
        <p class="mt-1.5 text-xs text-theme-secondarytextcolor">{{ hint }}</p>
    </div>
</div>
