{% extends 'layout/app.html.twig' %}

{% block title %}Dashboard - Sigil{% endblock %}

{# status label → Able Pro badge classes #}
{% set chip_classes = {
    'Signed':      'bg-success-500/10 text-success-600',
    'Pending':     'bg-warning-500/10 text-warning-600',
    'In progress': 'bg-info-500/10 text-info-600',
    'Awaiting':    'bg-secondary-500/10 text-secondary-600',
    'Draft':       'bg-secondary-500/10 text-secondary-600',
} %}

{% block content %}
<div class="max-w-5xl mx-auto">

    <div class="mb-5">
        <h1 class="text-2xl font-bold text-theme-headings">
            {{ 'now'|date('H') < 12 ? 'Good morning' : ('now'|date('H') < 18 ? 'Good afternoon' : 'Good evening') }}, {{ app.user.firstName }}
        </h1>
        <p class="mt-1 text-sm text-theme-secondarytextcolor">{{ 'now'|date('l, j F') }} · here's what needs you today.</p>
    </div>

    {% set onboarding = certificates is empty and stats.documents == 0 %}

    {% if not onboarding %}

        {# ── ① Attention strip ─────────────────────────────────────────── #}
        {% if stats.awaiting_me > 0 %}
            <div class="alert alert-info flex items-center gap-3 !mb-5" role="alert">
                <i class="ti ti-signature shrink-0 text-lg leading-none" aria-hidden="true"></i>
                <span class="flex-1 text-sm font-medium">
                    <strong>{{ stats.awaiting_me }} document{{ stats.awaiting_me > 1 ? 's' }}</strong>
                    {{ stats.awaiting_me > 1 ? 'are' : 'is' }} waiting for your signature.
                </span>
                <a href="#" class="text-sm font-semibold hover:underline whitespace-nowrap">Review now →</a>
            </div>
        {% endif %}

        {% if stats.awaiting_delivery|default(0) > 0 %}
            <div class="alert alert-success flex items-center gap-3 !mb-5" role="alert">
                <i class="ti ti-package shrink-0 text-lg leading-none" aria-hidden="true"></i>
                <span class="flex-1 text-sm font-medium">
                    <strong>{{ stats.awaiting_delivery }} document{{ stats.awaiting_delivery > 1 ? 's' }}</strong>
                    {{ stats.awaiting_delivery > 1 ? 'have' : 'has' }} been delivered to you.
                </span>
                <a href="#" class="text-sm font-semibold hover:underline whitespace-nowrap">View →</a>
            </div>
        {% endif %}

        {# ── ② Two-column zone ─────────────────────────────────────────── #}
        <div class="grid lg:grid-cols-[1.9fr_1fr] gap-4 mb-6">

            {# LEFT: needs your action (Inbox / Sent tabs) #}
            <div class="card !mb-0 overflow-hidden flex flex-col" data-controller="tabs">
                <div class="flex items-center justify-between px-4 pt-4 pb-2">
                    <h3 class="text-base font-semibold text-theme-headings">Needs your action</h3>
                    <div class="text-sm font-medium text-center text-theme-secondarytextcolor">
                        <ul class="flex flex-wrap -mb-px border-b-0">
                            <li class="me-2">
                                <button type="button" data-tabs-target="tab" data-action="tabs#show" data-tabs-name-param="inbox"
                                        class="inline-block px-3 py-1.5 rounded-lg text-primary-500 bg-primary-500/10 cursor-pointer">Inbox</button>
                            </li>
                            <li>
                                <button type="button" data-tabs-target="tab" data-action="tabs#show" data-tabs-name-param="sent"
                                        class="inline-block px-3 py-1.5 rounded-lg hover:text-theme-headings hover:bg-theme-activebg cursor-pointer">Sent</button>
                            </li>
                        </ul>
                    </div>
                </div>

                <div data-tabs-target="panel" data-tab-name="inbox" class="flex-1 flex flex-col">
                    {# deliveries always listed before signing requests #}
                    {% set inbox_sorted = inbox_requests|filter(r => r.type|default('sign') == 'deliver')
                                          |merge(inbox_requests|filter(r => r.type|default('sign') != 'deliver')) %}
                    {% for req in inbox_sorted %}
                        {% set delivery = req.type|default('sign') == 'deliver' %}
                        <div class="flex items-center gap-3 px-4 py-3 border-t border-theme-border/60">
                            <span class="inline-flex w-9 h-9 shrink-0 items-center justify-center rounded-lg {{ delivery ? 'bg-success-500/10 text-success-600' : 'bg-danger-500/10 text-danger-600' }}">
                                <i class="ti {{ delivery ? 'ti-package' : 'ti-file-text' }} text-lg leading-none" aria-hidden="true"></i>
                            </span>
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-semibold text-theme-headings truncate">{{ req.document }}</div>
                                <div class="text-sm text-theme-secondarytextcolor">from {{ req.from }} · {{ req.due }}</div>
                            </div>
                            {% if delivery %}
                                <span class="badge rounded-full bg-success-500/10 text-success-600">Delivery</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary">View</button>
                            {% else %}
                                <span class="badge rounded-full bg-warning-500/10 text-warning-600">Pending</span>
                                <button type="button" class="btn btn-sm btn-primary">Review &amp; sign</button>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="px-4 py-6 border-t border-theme-border/60 text-sm text-theme-secondarytextcolor">Nothing waiting on you. 🎉</p>
                    {% endfor %}
                    <a href="#" class="block mt-auto px-4 py-3 border-t border-theme-border/60 text-sm font-medium text-primary-500 hover:underline">View all signing requests →</a>
                </div>

                <div data-tabs-target="panel" data-tab-name="sent" class="flex-1 flex-col [&:not([hidden])]:flex" hidden>
                    {% for req in sent_requests %}
                        <div class="flex items-center gap-3 px-4 py-3 border-t border-theme-border/60">
                            <span class="inline-flex w-9 h-9 shrink-0 items-center justify-center rounded-lg bg-info-500/10 text-info-600">
                                <i class="ti ti-send text-base leading-none" aria-hidden="true"></i>
                            </span>
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-semibold text-theme-headings truncate">{{ req.document }}</div>
                                <div class="text-sm text-theme-secondarytextcolor">to {{ req.to }} · {{ req.meta }}</div>
                            </div>
                            <span class="badge rounded-full {{ chip_classes[req.status] }}">{{ req.status }}</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary">
                                {{ req.status == 'Awaiting' ? 'Remind' : 'Track' }}
                            </button>
                        </div>
                    {% else %}
                        <p class="px-4 py-6 border-t border-theme-border/60 text-sm text-theme-secondarytextcolor">You haven't sent any signing requests yet.</p>
                    {% endfor %}
                    <a href="#" class="block mt-auto px-4 py-3 border-t border-theme-border/60 text-sm font-medium text-primary-500 hover:underline">View everything you've sent →</a>
                </div>
            </div>

            {# RIGHT: certificates slider + activity #}
            <div class="flex flex-col gap-4">

                <div class="card !mb-0 px-4 pt-4 pb-3" data-controller="slider">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-base font-semibold text-theme-headings">Your certificates</h3>
                        <div class="flex gap-1.5 {{ certificates|length < 2 ? 'hidden' }}">
                            <button type="button" data-action="slider#prev" title="Previous"
                                    class="inline-flex items-center justify-center w-7 h-7 border border-theme-border bg-white rounded-lg text-theme-secondarytextcolor hover:bg-theme-activebg cursor-pointer">
                                <i class="ti ti-chevron-left text-sm leading-none" aria-hidden="true"></i>
                            </button>
                            <button type="button" data-action="slider#next" title="Next"
                                    class="inline-flex items-center justify-center w-7 h-7 border border-theme-border bg-white rounded-lg text-theme-secondarytextcolor hover:bg-theme-activebg cursor-pointer">
                                <i class="ti ti-chevron-right text-sm leading-none" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    {% if certificates is empty %}
                        <div class="border border-dashed border-theme-inputborder rounded-lg px-5 py-7 text-center">
                            <p class="text-sm font-semibold text-theme-headings mb-1">No certificates yet</p>
                            <p class="text-sm text-theme-secondarytextcolor mb-3">You need one to sign or send documents.</p>
                            <a href="{{ path('app_certificate_new') }}" class="btn btn-primary btn-sm">Create your certificate</a>
                        </div>
                    {% endif %}

                    <div class="overflow-hidden">
                        <div class="flex transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]" data-slider-target="track">
                            {% for cert in certificates %}
                                {% set expiring = cert.status.expiring %}
                                <div class="shrink-0 w-full box-border">
                                    <div class="border border-theme-border rounded-lg overflow-hidden">
                                        <div class="h-1 {{ cert.status.accentClass }}"></div>
                                        <div class="p-4">
                                        <div class="flex items-center justify-between">
                                            <span class="text-sm font-semibold text-theme-headings">{{ cert.name }}</span>
                                            <span class="badge rounded-full {{ cert.status.badgeClass }}">{{ expiring ? 'Expires in ' ~ cert.expires_in : cert.status.label }}</span>
                                        </div>
                                        <div class="mt-3 flex flex-col gap-2 text-sm">
                                            <div class="flex justify-between"><span class="text-theme-secondarytextcolor">Algorithm</span><span class="font-medium text-theme-headings">{{ cert.algorithm }}</span></div>
                                            <div class="flex justify-between"><span class="text-theme-secondarytextcolor">Valid until</span><span class="font-medium {{ expiring ? 'text-warning-600' : 'text-theme-headings' }}">{{ cert.valid_until }}</span></div>
                                        </div>
                                        {% if expiring %}
                                            <button type="button" class="btn btn-warning btn-sm w-full mt-3">Renew certificate</button>
                                        {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="flex items-center justify-center gap-1.5 mt-3 {{ certificates|length < 2 ? 'hidden' }}">
                        {% for cert in certificates %}
                            <button type="button" data-slider-target="dot" data-action="slider#set" data-slider-index-param="{{ loop.index0 }}"
                                    title="Certificate {{ loop.index }}"
                                    class="h-1.5 p-0 border-none rounded-full cursor-pointer transition-all duration-200 {{ loop.first ? 'w-5 bg-primary-500' : 'w-1.5 bg-theme-border' }}"></button>
                        {% endfor %}
                    </div>

                    <a href="{{ path('app_certificates') }}" class="block mt-2 pt-2.5 -mx-4 px-4 border-t border-theme-border/60 text-sm font-medium text-primary-500 hover:underline">View all certificates →</a>
                </div>

                {# Activity feed #}
                <div class="card !mb-0 px-4 py-4">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-base font-semibold text-theme-headings">Activity</h3>
                        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-theme-secondarytextcolor">
                            <span class="inline-flex text-primary-500">{% include 'components/s_loader.html.twig' with {size: 17} only %}</span>LIVE
                        </span>
                    </div>
                    <div class="flex flex-col gap-3">
                        {% set activity_icons = {
                            signed:   {classes: 'bg-success-500/10 text-success-600', icon: 'ti-check'},
                            uploaded: {classes: 'bg-info-500/10 text-info-600', icon: 'ti-upload'},
                            shared:   {classes: 'bg-secondary-500/10 text-secondary-600', icon: 'ti-share'},
                        } %}
                        {% for event in activity %}
                            <div class="flex gap-3">
                                <span class="w-7 h-7 shrink-0 rounded-lg flex items-center justify-center {{ activity_icons[event.type].classes }}">
                                    <i class="ti {{ activity_icons[event.type].icon }} text-sm leading-none" aria-hidden="true"></i>
                                </span>
                                <div>
                                    <div class="text-sm font-medium text-theme-headings">{{ event.text|raw }}</div>
                                    <div class="text-xs text-theme-secondarytextcolor">{{ event.when }}</div>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-sm text-theme-secondarytextcolor">No activity yet.</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# ── ③ Recent documents ────────────────────────────────────────── #}
        <div class="flex items-center justify-between mb-3">
            <h3 class="text-base font-semibold text-theme-headings">Recent documents</h3>
            <a href="{{ path('app_documents') }}" class="text-sm font-medium text-primary-500 hover:underline">All documents →</a>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            {% set avatar_colors = ['bg-primary-400', 'bg-success-500', 'bg-primary-500'] %}
            {% for doc in recent_documents %}
                {# glass on hover — the brief allows glass on hovered document cards #}
                <div class="card !mb-0 p-4 cursor-pointer transition hover:bg-white/70 hover:backdrop-blur-xl hover:shadow-md hover:border-white/70">
                    <div class="flex items-center justify-between">
                        <span class="inline-flex w-9 h-9 items-center justify-center rounded-lg bg-primary-500/10 text-primary-500">
                            <i class="ti ti-file-text text-base leading-none" aria-hidden="true"></i>
                        </span>
                        <span class="badge rounded-full {{ chip_classes[doc.status] }}">{{ doc.status }}</span>
                    </div>
                    <div class="text-sm font-semibold text-theme-headings mt-3 truncate">{{ doc.name }}</div>
                    <div class="text-xs text-theme-secondarytextcolor mt-0.5">{{ doc.version }} · updated {{ doc.updated }}</div>
                    <div class="flex items-center mt-3">
                        {% for person in doc.people %}
                            <span class="w-6 h-6 rounded-full text-[10px] font-semibold flex items-center justify-center border-2 border-white {{ loop.index0 > 0 ? '-ms-2' }}
                                         {{ person starts with '+' ? 'bg-theme-activebg text-theme-secondarytextcolor' : avatar_colors[loop.index0 % 3] ~ ' text-white' }}">{{ person }}</span>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {# ── ④ Document activity chart (ApexCharts, colors via theme tokens) ── #}
        {% set series = [
            {key: 'signed',   label: 'Signed',   token: '--color-info-500',    chip: 'bg-info-500'},
            {key: 'sent',     label: 'Sent',     token: '--color-warning-500', chip: 'bg-warning-500'},
            {key: 'received', label: 'Received', token: '--color-success-500', chip: 'bg-success-500'},
        ] %}
        <div class="card !mb-0 p-4 mt-6">
            <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
                <h3 class="text-base font-semibold text-theme-headings">Documents · last 6 months</h3>
                <div class="flex items-center gap-4">
                    {% for s in series %}
                        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-theme-secondarytextcolor">
                            <span class="w-2.5 h-2.5 rounded-sm {{ s.chip }}"></span>{{ s.label }}
                        </span>
                    {% endfor %}
                </div>
            </div>
            {% set chart_data = {
                labels: monthly|map(m => m.label),
                series: series|map(s => {label: s.label, token: s.token, values: monthly|map(m => m[s.key])}),
            } %}
            <div data-controller="chart" data-chart-data-value="{{ chart_data|json_encode|e('html_attr') }}"></div>
            {# screen-reader table equivalent of the chart #}
            <table class="sr-only">
                <caption>Documents signed, sent and received per month, last 6 months</caption>
                <thead><tr><th>Month</th>{% for s in series %}<th>{{ s.label }}</th>{% endfor %}</tr></thead>
                <tbody>
                    {% for month in monthly %}
                        <tr><th>{{ month.label }}</th>{% for s in series %}<td>{{ month[s.key] }}</td>{% endfor %}</tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    {% else %}

        {# ── Onboarding empty state ────────────────────────────────────── #}
        <div class="alert alert-primary flex items-center gap-3 !mb-5" role="alert">
            <i class="ti ti-shield-check shrink-0 text-lg leading-none" aria-hidden="true"></i>
            <span class="flex-1 text-sm font-medium">Welcome to Sigil. Finish setup to start signing - it takes about two minutes.</span>
        </div>

        <div class="card !mb-0 p-8 text-center">
            <div class="inline-flex w-14 h-14 items-center justify-center rounded-lg bg-primary-500 text-white mb-4 mx-auto">
                <i class="ti ti-shield-check text-3xl leading-none" aria-hidden="true"></i>
            </div>
            <h2 class="text-xl font-bold text-theme-headings">Let's get you ready to sign</h2>
            <p class="mt-1.5 mb-6 mx-auto text-sm text-theme-secondarytextcolor max-w-md">Three quick steps and you'll be able to sign and send documents securely.</p>

            <div class="grid md:grid-cols-3 gap-4 text-left max-w-3xl mx-auto">
                {% for step in [
                    {n: 1, title: 'Set up your certificate', text: 'Issue your signing certificate and protect it with a PIN.', cta: 'Start setup', active: true},
                    {n: 2, title: 'Upload a document', text: "Bring in your first PDF - it's encrypted and versioned.", cta: 'Upload', active: false},
                    {n: 3, title: 'Sign or send', text: 'Sign it yourself, or route it to someone for signature.', cta: 'Send', active: false},
                ] %}
                    <div class="rounded-lg border p-5 {{ step.active ? 'border-primary-500 bg-primary-500/5' : 'border-theme-border opacity-60' }}">
                        <span class="w-8 h-8 rounded-full text-sm font-bold flex items-center justify-center {{ step.active ? 'bg-primary-500 text-white' : 'bg-theme-activebg text-theme-secondarytextcolor' }}">{{ step.n }}</span>
                        <div class="text-base font-semibold text-theme-headings mt-3">{{ step.title }}</div>
                        <div class="text-sm text-theme-secondarytextcolor mt-1">{{ step.text }}</div>
                        {% if step.active %}
                            <a href="{{ path('app_certificate_new') }}" class="btn btn-primary w-full mt-4 text-center">{{ step.cta }}</a>
                        {% else %}
                            <button type="button" disabled class="btn btn-outline-secondary w-full mt-4 opacity-60">{{ step.cta }}</button>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

    {% endif %}

</div>
{% endblock %}
