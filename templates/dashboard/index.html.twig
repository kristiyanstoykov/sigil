{% extends 'layout/app.html.twig' %}

{% block title %}Dashboard — Sigil{% endblock %}

{# status label → chip utility classes #}
{% set chip_classes = {
    'Signed':      'text-success bg-success/10',
    'Pending':     'text-warning bg-warning/10',
    'In progress': 'text-info bg-info/10',
    'Awaiting':    'text-label bg-body/8',
    'Draft':       'text-label bg-body/8',
} %}

{% block content %}
<div class="max-w-5xl mx-auto">

    <div class="mb-5">
        <h1 class="text-2xl font-extrabold tracking-tight text-body">
            {{ 'now'|date('H') < 12 ? 'Good morning' : ('now'|date('H') < 18 ? 'Good afternoon' : 'Good evening') }}, {{ app.user.firstName }}
        </h1>
        <p class="mt-1 text-sm text-muted">{{ 'now'|date('l, j F') }} · here's what needs you today.</p>
    </div>

    {% set onboarding = certificates is empty and stats.documents == 0 %}

    {% if not onboarding %}

        {# ── ① Attention strip ─────────────────────────────────────────── #}
        {% if stats.awaiting_me > 0 %}
            <div class="flex items-center gap-3.5 px-4.5 py-3.5 mb-5 bg-info/7 border border-info/22 rounded-modal">
                <span class="inline-flex w-[34px] h-[34px] shrink-0 items-center justify-center rounded-[10px] bg-info/14 text-info">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13h4l2 3h4l2-3h4"/><path d="M5 13V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7"/></svg>
                </span>
                <span class="flex-1 text-[14.5px] font-semibold text-body">
                    <strong class="font-extrabold">{{ stats.awaiting_me }} document{{ stats.awaiting_me > 1 ? 's' }}</strong>
                    {{ stats.awaiting_me > 1 ? 'are' : 'is' }} waiting for your signature.
                </span>
                <a href="#" class="inline-flex items-center gap-1.5 text-[13.5px] font-bold text-info hover:text-primary transition-colors">
                    Review now
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            </div>
        {% endif %}

        {# ── ② Stat tiles ──────────────────────────────────────────────── #}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            {% for tile in [
                {label: 'Awaiting me', value: stats.awaiting_me, note: 'signing requests', accent: 'text-primary'},
                {label: 'Sent, pending', value: stats.sent_pending, note: 'awaiting others', accent: 'text-body'},
                {label: 'Signed · 30d', value: stats.signed_30d, note: 'completed', accent: 'text-success'},
                {label: 'Documents', value: stats.documents, note: 'in your vault', accent: 'text-body'},
            ] %}
                <div class="bg-surface border border-line rounded-2xl p-[18px] shadow-sm">
                    <div class="text-[11.5px] font-bold tracking-[0.09em] uppercase text-[color:var(--sigil-text-disabled)]">{{ tile.label }}</div>
                    <div class="text-[32px] font-extrabold tracking-tight mt-1.5 {{ tile.accent }}">{{ tile.value }}</div>
                    <div class="text-[12.5px] text-muted mt-0.5">{{ tile.note }}</div>
                </div>
            {% endfor %}
        </div>

        {# ── ③ Two-column zone ─────────────────────────────────────────── #}
        <div class="grid lg:grid-cols-[1.9fr_1fr] gap-[18px] mb-6">

            {# LEFT: needs your action (Inbox / Sent tabs) #}
            <div class="bg-surface border border-line rounded-2xl shadow-sm overflow-hidden flex flex-col" data-controller="tabs">
                <div class="flex items-center justify-between px-[18px] pt-4 pb-3">
                    <h3 class="text-[15px] font-extrabold text-body">Needs your action</h3>
                    <div class="flex gap-0.5 bg-[var(--sigil-bg)] p-[3px] rounded-[10px]">
                        <button type="button" data-tabs-target="tab" data-action="tabs#show" data-tabs-name-param="inbox"
                                class="px-3.5 py-1.5 rounded-[7px] text-[12.5px] font-bold cursor-pointer bg-surface text-primary shadow-sm">Inbox</button>
                        <button type="button" data-tabs-target="tab" data-action="tabs#show" data-tabs-name-param="sent"
                                class="px-3.5 py-1.5 rounded-[7px] text-[12.5px] font-bold cursor-pointer text-muted">Sent</button>
                    </div>
                </div>

                <div data-tabs-target="panel" data-tab-name="inbox" class="flex-1 flex flex-col">
                    {% for req in inbox_requests %}
                        <div class="flex items-center gap-3.5 px-[18px] py-3.5 border-t border-line/60">
                            <span class="inline-flex w-[38px] h-[38px] shrink-0 items-center justify-center rounded-[10px] bg-danger/8 text-danger">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
                            </span>
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-bold text-body truncate">{{ req.document }}</div>
                                <div class="text-[12.5px] text-muted">from {{ req.from }} · {{ req.due }}</div>
                            </div>
                            <span class="text-[11.5px] font-bold text-warning bg-warning/12 px-2.5 py-1 rounded-full">Pending</span>
                            <button type="button" class="btn-primary !w-auto !py-2 !px-3.5 !text-[13px]">Review &amp; sign</button>
                        </div>
                    {% else %}
                        <p class="px-[18px] py-6 border-t border-line/60 text-[13px] text-muted">Nothing waiting on you. 🎉</p>
                    {% endfor %}
                    <a href="#" class="block mt-auto px-[18px] py-3 border-t border-line/60 text-[13px] font-semibold text-primary hover:text-primary-hover transition-colors">View all signing requests →</a>
                </div>

                <div data-tabs-target="panel" data-tab-name="sent" class="flex-1 flex-col [&:not([hidden])]:flex" hidden>
                    {% for req in sent_requests %}
                        <div class="flex items-center gap-3.5 px-[18px] py-3.5 border-t border-line/60">
                            <span class="inline-flex w-[38px] h-[38px] shrink-0 items-center justify-center rounded-[10px] bg-info/8 text-info">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>
                            </span>
                            <div class="flex-1 min-w-0">
                                <div class="text-sm font-bold text-body truncate">{{ req.document }}</div>
                                <div class="text-[12.5px] text-muted">to {{ req.to }} · {{ req.meta }}</div>
                            </div>
                            <span class="text-[11.5px] font-bold px-2.5 py-1 rounded-full {{ chip_classes[req.status] }}">{{ req.status }}</span>
                            <button type="button" class="px-3.5 py-2 border border-line rounded-[10px] bg-surface text-[13px] font-semibold text-label cursor-pointer hover:border-primary/40 transition-colors">
                                {{ req.status == 'Awaiting' ? 'Remind' : 'Track' }}
                            </button>
                        </div>
                    {% else %}
                        <p class="px-[18px] py-6 border-t border-line/60 text-[13px] text-muted">You haven't sent any signing requests yet.</p>
                    {% endfor %}
                    <a href="#" class="block mt-auto px-[18px] py-3 border-t border-line/60 text-[13px] font-semibold text-primary hover:text-primary-hover transition-colors">View everything you've sent →</a>
                </div>
            </div>

            {# RIGHT: certificates slider + activity #}
            <div class="flex flex-col gap-[18px]">

                <div class="bg-surface border border-line rounded-2xl shadow-sm px-4 pt-3.5 pb-3" data-controller="slider">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-[15px] font-extrabold text-body">Your certificates</h3>
                        <div class="flex gap-1.5">
                            <button type="button" data-action="slider#prev" title="Previous"
                                    class="inline-flex items-center justify-center w-7 h-7 border border-line bg-surface rounded-lg text-label cursor-pointer">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
                            </button>
                            <button type="button" data-action="slider#next" title="Next"
                                    class="inline-flex items-center justify-center w-7 h-7 border border-line bg-surface rounded-lg text-label cursor-pointer">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                            </button>
                        </div>
                    </div>

                    <div class="overflow-hidden">
                        <div class="flex transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]" data-slider-target="track">
                            {% for cert in certificates %}
                                {% set expiring = cert.status == 'expiring' %}
                                <div class="shrink-0 w-full box-border">
                                    <div class="border rounded-[13px] overflow-hidden {{ expiring ? 'border-warning/35' : 'border-line' }}">
                                        <div class="h-1 {{ expiring ? 'bg-warning' : 'bg-success' }}"></div>
                                        <div class="px-[15px] py-3.5">
                                            <div class="flex items-center justify-between">
                                                <span class="text-[13.5px] font-extrabold text-body">{{ cert.name }}</span>
                                                {% if expiring %}
                                                    <span class="text-[11px] font-bold text-warning bg-warning/12 px-2 py-0.5 rounded-full">Expires in {{ cert.expires_in }}</span>
                                                {% else %}
                                                    <span class="inline-flex items-center gap-1 text-[11px] font-bold text-success bg-success/10 px-2 py-0.5 rounded-full">
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>Active
                                                    </span>
                                                {% endif %}
                                            </div>
                                            <div class="mt-3 flex flex-col gap-2 text-[12.5px]">
                                                <div class="flex justify-between"><span class="text-[color:var(--sigil-text-disabled)]">CN</span><span class="font-semibold text-body">{{ cert.cn }}</span></div>
                                                <div class="flex justify-between"><span class="text-[color:var(--sigil-text-disabled)]">Algorithm</span><span class="font-semibold text-body">{{ cert.algorithm }}</span></div>
                                                <div class="flex justify-between"><span class="text-[color:var(--sigil-text-disabled)]">Valid until</span><span class="font-semibold {{ expiring ? 'text-warning font-bold' : 'text-body' }}">{{ cert.valid_until }}</span></div>
                                            </div>
                                            {% if expiring %}
                                                <button type="button" class="w-full mt-3 py-2 border-none rounded-[9px] text-white text-[13px] font-semibold cursor-pointer bg-warning hover:opacity-90 transition-opacity">Renew certificate</button>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="flex items-center justify-center gap-1.5 mt-3">
                        {% for cert in certificates %}
                            <button type="button" data-slider-target="dot" data-action="slider#set" data-slider-index-param="{{ loop.index0 }}"
                                    title="Certificate {{ loop.index }}"
                                    class="h-[7px] p-0 border-none rounded-full cursor-pointer transition-all duration-200 {{ loop.first ? 'w-[22px] bg-primary' : 'w-[7px] bg-line' }}"></button>
                        {% endfor %}
                    </div>

                    <a href="#" class="block mt-2 pt-2.5 -mx-4 px-4 border-t border-line/60 text-[13px] font-semibold text-primary hover:text-primary-hover transition-colors">View all certificates →</a>
                </div>

                {# Activity feed #}
                <div class="bg-surface border border-line rounded-2xl shadow-sm px-[18px] py-4">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-[15px] font-extrabold text-body">Activity</h3>
                        <span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-[color:var(--sigil-text-disabled)]">
                            <span class="inline-flex text-primary">{% include 'components/s_loader.html.twig' with {size: 17} only %}</span>LIVE
                        </span>
                    </div>
                    <div class="flex flex-col gap-3">
                        {% set activity_icons = {
                            signed:   {classes: 'bg-success/10 text-success', path: '<path d="M20 6 9 17l-5-5"/>'},
                            uploaded: {classes: 'bg-info/10 text-info', path: '<path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 20h14"/>'},
                            shared:   {classes: 'bg-body/8 text-label', path: '<path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><path d="M16 6l-4-4-4 4M12 2v14"/>'},
                        } %}
                        {% for event in activity %}
                            <div class="flex gap-3">
                                <span class="w-[26px] h-[26px] shrink-0 rounded-lg flex items-center justify-center {{ activity_icons[event.type].classes }}">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">{{ activity_icons[event.type].path|raw }}</svg>
                                </span>
                                <div>
                                    <div class="text-[13px] font-semibold text-body">{{ event.text|raw }}</div>
                                    <div class="text-[11.5px] text-[color:var(--sigil-text-disabled)]">{{ event.when }}</div>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-[13px] text-muted">No activity yet.</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# ── ④ Recent documents ────────────────────────────────────────── #}
        <div class="flex items-center justify-between mb-3.5">
            <h3 class="text-base font-extrabold text-body">Recent documents</h3>
            <a href="#" class="text-[13px] font-semibold text-primary hover:text-primary-hover transition-colors">All documents →</a>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            {% set avatar_colors = ['bg-primary-light', 'bg-success', 'bg-primary'] %}
            {% for doc in recent_documents %}
                <div class="bg-surface border border-line rounded-[14px] p-4 cursor-pointer transition-all duration-150 hover:-translate-y-[3px] hover:shadow-[0_14px_30px_-14px_rgba(30,58,138,0.32)] hover:bg-white/85">
                    <div class="flex items-center justify-between">
                        <span class="inline-flex w-[34px] h-[34px] items-center justify-center rounded-[9px] bg-primary/7 text-primary">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
                        </span>
                        <span class="text-[11px] font-bold px-2 py-0.5 rounded-full {{ chip_classes[doc.status] }}">{{ doc.status }}</span>
                    </div>
                    <div class="text-[13.5px] font-bold text-body mt-3 truncate">{{ doc.name }}</div>
                    <div class="text-[11.5px] text-[color:var(--sigil-text-disabled)] mt-0.5">{{ doc.version }} · updated {{ doc.updated }}</div>
                    <div class="flex items-center mt-3">
                        {% for person in doc.people %}
                            <span class="w-[22px] h-[22px] rounded-full text-[10px] font-bold flex items-center justify-center border-2 border-surface {{ loop.index0 > 0 ? '-ml-[7px]' }}
                                         {{ person starts with '+' ? 'bg-line text-label' : avatar_colors[loop.index0 % 3] ~ ' text-white' }}">{{ person }}</span>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        </div>

    {% else %}

        {# ── Onboarding empty state ────────────────────────────────────── #}
        <div class="flex items-center gap-3.5 px-4.5 py-3.5 mb-5 bg-primary/6 border border-primary/18 rounded-modal">
            <span class="inline-flex w-[34px] h-[34px] shrink-0 items-center justify-center rounded-[10px] bg-primary/12 text-primary">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/></svg>
            </span>
            <span class="flex-1 text-[14.5px] font-semibold text-body">Welcome to Sigil. Finish setup to start signing — it takes about two minutes.</span>
        </div>

        <div class="bg-surface border border-line rounded-2xl shadow-sm p-8 text-center">
            <div class="inline-flex w-14 h-14 items-center justify-center rounded-modal bg-linear-to-b from-[var(--sigil-primary-gradient-top)] to-primary text-white mb-3.5">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
            </div>
            <h2 class="text-[21px] font-extrabold tracking-tight text-body">Let's get you ready to sign</h2>
            <p class="mt-1.5 mb-6 mx-auto text-sm text-muted max-w-md">Three quick steps and you'll be able to sign and send documents securely.</p>

            <div class="grid md:grid-cols-3 gap-4 text-left max-w-3xl mx-auto">
                {% for step in [
                    {n: 1, title: 'Set up your certificate', text: 'Issue your signing certificate and protect it with a PIN.', cta: 'Start setup', active: true},
                    {n: 2, title: 'Upload a document', text: "Bring in your first PDF — it's encrypted and versioned.", cta: 'Upload', active: false},
                    {n: 3, title: 'Sign or send', text: 'Sign it yourself, or route it to someone for signature.', cta: 'Send', active: false},
                ] %}
                    <div class="rounded-2xl p-5 {{ step.active ? 'border-[1.5px] border-primary bg-primary/3' : 'border border-line opacity-60' }}">
                        <span class="w-[30px] h-[30px] rounded-full text-sm font-extrabold flex items-center justify-center {{ step.active ? 'bg-primary text-white' : 'bg-[var(--sigil-bg)] text-[color:var(--sigil-text-disabled)]' }}">{{ step.n }}</span>
                        <div class="text-[15px] font-extrabold text-body mt-3.5">{{ step.title }}</div>
                        <div class="text-[12.5px] text-muted mt-1 leading-normal">{{ step.text }}</div>
                        {% if step.active %}
                            <button type="button" class="btn-primary mt-4 !py-2.5 !text-[13.5px]">{{ step.cta }}</button>
                        {% else %}
                            <button type="button" disabled class="w-full mt-4 py-2.5 border border-line rounded-[10px] bg-[var(--sigil-bg)] text-[13.5px] font-semibold text-[color:var(--sigil-text-disabled)]">{{ step.cta }}</button>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

    {% endif %}

</div>
{% endblock %}
