{% extends 'layout/app.html.twig' %}

{% block title %}Dashboard — Sigil{% endblock %}

{% block content %}
<div class="max-w-5xl mx-auto px-6 py-8">

    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-xl font-bold" style="color: var(--sigil-text);">Dashboard</h1>
            <p class="mt-0.5 text-sm" style="color: var(--sigil-text-secondary);">
                Welcome back, {{ app.user.fullName }}
            </p>
        </div>
        <form method="post" action="{{ path('app_logout') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit"
               class="px-4 py-2 text-sm font-medium rounded-btn border transition-colors
                      hover:bg-danger/5 hover:border-danger/30 hover:text-danger"
               style="border-color: var(--sigil-border); color: var(--sigil-text-secondary);">
                Sign out
            </button>
        </form>
    </div>

    {% if false %}
        {# Mandatory 2FA (TwoFactorEnrollmentSubscriber) means the dashboard is only
           reachable once TOTP is enabled, so this nudge banner is never shown. Kept
           disabled rather than deleted in case an admin-reset UX needs it later. #}
        <div class="mb-6 flex items-start gap-3 px-4 py-4 rounded-card border bg-warning/5 border-warning/20">
            <svg class="w-5 h-5 text-warning mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.068 16.5c-.77.833.192 2.5 1.732 2.5z"/>
            </svg>
            <div>
                <p class="text-sm font-medium text-warning">Two-factor authentication is not enabled</p>
                <p class="text-sm mt-0.5" style="color: var(--sigil-text-secondary);">
                    Secure your account before signing documents.
                    <a href="{{ path('app_2fa_setup') }}" class="font-medium text-primary hover:text-primary-hover transition-colors">Set up now →</a>
                </p>
            </div>
        </div>
    {% endif %}

    <div class="grid grid-cols-3 gap-4">
        <div class="rounded-card border p-5" style="background: var(--sigil-surface); border-color: var(--sigil-border);">
            <p class="text-sm font-medium" style="color: var(--sigil-text-secondary);">Documents</p>
            <p class="text-2xl font-bold mt-1" style="color: var(--sigil-text);">0</p>
        </div>
        <div class="rounded-card border p-5" style="background: var(--sigil-surface); border-color: var(--sigil-border);">
            <p class="text-sm font-medium" style="color: var(--sigil-text-secondary);">Signed</p>
            <p class="text-2xl font-bold mt-1" style="color: var(--sigil-text);">0</p>
        </div>
        <div class="rounded-card border p-5" style="background: var(--sigil-surface); border-color: var(--sigil-border);">
            <p class="text-sm font-medium" style="color: var(--sigil-text-secondary);">Pending</p>
            <p class="text-2xl font-bold mt-1" style="color: var(--sigil-text);">0</p>
        </div>
    </div>

</div>
{% endblock %}
