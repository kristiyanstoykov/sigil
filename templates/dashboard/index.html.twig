{% extends 'layout/app.html.twig' %}
{% import 'documents/_macros.html.twig' as docs %}
{% import 'signing/_macros.html.twig' as signing %}

{% block title %}Dashboard - Sigil{% endblock %}

{% block content %}
{#
    Built on Able Pro's Default dashboard (dist/dashboard/index.html): a 12-column
    stat row, then a wide panel beside a narrow rail, then the chart. Their grid
    and card patterns, Sigil's tokens and content - no demo markup is carried over.

    Everything here is a real query. This is the one page that mixes roles on
    purpose; every other page answers a single question.
#}
<div class="mx-auto max-w-6xl">

    <div class="mb-5">
        <h1 class="text-2xl font-bold text-theme-headings">
            {{ 'now'|date('H') < 12 ? 'Good morning' : ('now'|date('H') < 18 ? 'Good afternoon' : 'Good evening') }}, {{ app.user.firstName }}
        </h1>
        <p class="mt-1 text-sm text-theme-secondarytextcolor">{{ 'now'|date('l, j F') }} · here's what needs you today.</p>
    </div>

    {% if onboarding %}

        {# ── first run ──────────────────────────────────────────────────── #}
        <div class="alert alert-primary flex items-center gap-3 !mb-5" role="alert">
            <i class="ti ti-shield-check shrink-0 text-lg leading-none" aria-hidden="true"></i>
            <span class="flex-1 text-sm font-medium">Welcome to Sigil. Finish setup to start signing - it takes about two minutes.</span>
        </div>

        <div class="card !mb-0 p-8 text-center">
            <div class="mx-auto mb-4 inline-flex h-14 w-14 items-center justify-center rounded-lg bg-primary-500 text-white">
                <i class="ti ti-shield-check text-3xl leading-none" aria-hidden="true"></i>
            </div>
            <h2 class="text-xl font-bold text-theme-headings">Let's get you ready to sign</h2>
            <p class="mx-auto mb-6 mt-1.5 max-w-md text-sm text-theme-secondarytextcolor">Three quick steps and you'll be able to sign and send documents securely.</p>

            <div class="mx-auto grid max-w-3xl gap-4 text-left md:grid-cols-3">
                {% for step in [
                    {n: 1, title: 'Set up your certificate', text: 'Issue your signing certificate and protect it with a PIN.', cta: 'Start setup', url: path('app_certificate_new'), active: true},
                    {n: 2, title: 'Upload a document', text: "Bring in your first PDF - it's encrypted and versioned.", cta: 'Upload', url: path('app_documents'), active: false},
                    {n: 3, title: 'Sign or send', text: 'Sign it yourself, send it for signature, or deliver it.', cta: 'Send', url: path('app_documents'), active: false},
                ] %}
                    <div class="rounded-lg border p-5 {{ step.active ? 'border-primary-500 bg-primary-500/5' : 'border-theme-border opacity-60' }}">
                        <span class="inline-flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold {{ step.active ? 'bg-primary-500 text-white' : 'bg-theme-activebg text-theme-secondarytextcolor' }}">{{ step.n }}</span>
                        <p class="mt-3 text-sm font-semibold text-theme-headings">{{ step.title }}</p>
                        <p class="mt-1 text-sm text-theme-secondarytextcolor">{{ step.text }}</p>
                        {% if step.active %}
                            <a href="{{ step.url }}" class="btn btn-primary btn-sm mt-4">{{ step.cta }}</a>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>

    {% else %}

        {# ── attention strip: only ever about work that is actually yours ── #}
        {% if stats.awaiting_me > 0 %}
            <div class="alert alert-info flex items-center gap-3 !mb-5" role="alert">
                <i class="ti ti-signature shrink-0 text-lg leading-none" aria-hidden="true"></i>
                <span class="flex-1 text-sm font-medium">
                    <strong>{{ stats.awaiting_me }} document{{ stats.awaiting_me > 1 ? 's' }}</strong>
                    {{ stats.awaiting_me > 1 ? 'are' : 'is' }} waiting for your signature.
                </span>
                <a href="{{ path('app_signing_requests') }}" class="whitespace-nowrap text-sm font-semibold hover:underline">Review now →</a>
            </div>
        {% endif %}

        {# ── ① stat row ─────────────────────────────────────────────────── #}
        <div class="mb-6 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
            {{ include('dashboard/_stat.html.twig', {
                label: 'Waiting on you', value: stats.awaiting_me, icon: 'ti-signature', tone: 'warning',
                hint: 'Signature requests where it is your turn.',
                url: path('app_signing_requests'), cta: 'Sign',
            }, with_context: false) }}
            {{ include('dashboard/_stat.html.twig', {
                label: 'Out for signature', value: stats.sent_pending, icon: 'ti-send', tone: 'info',
                hint: 'Requests you sent that are still open.',
                url: path('app_signing_requests', {tab: 'sent'}), cta: 'Track',
            }, with_context: false) }}
            {{ include('dashboard/_stat.html.twig', {
                label: 'Delivered to you', value: stats.delivered, icon: 'ti-mail-forward', tone: 'primary',
                hint: 'Documents served on you. Nothing to do.',
                url: path('app_documents', {role: 'others'}), cta: 'Open',
            }, with_context: false) }}
            {{ include('dashboard/_stat.html.twig', {
                label: 'Documents', value: stats.documents, icon: 'ti-files', tone: 'success',
                hint: 'Everything you can open, encrypted at rest.',
                url: path('app_documents'), cta: 'Browse',
            }, with_context: false) }}
        </div>

        {# ── ② wide panel + rail ────────────────────────────────────────── #}
        <div class="mb-6 grid gap-4 lg:grid-cols-[1.9fr_1fr]">

            <div class="flex flex-col gap-4">

                {# Your turn: the only list on this page that is work to do. #}
                <div class="card !mb-0 overflow-hidden">
                    <div class="flex items-center justify-between px-4 pb-2 pt-4">
                        <h3 class="text-base font-semibold text-theme-headings">Needs your action</h3>
                        <a href="{{ path('app_signing_requests') }}" class="text-sm font-medium text-primary-500 hover:underline">All requests →</a>
                    </div>
                    <ul class="divide-y divide-theme-border/60">
                        {% for request in myTurn %}
                            <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
                                {{ docs.pdf_icon('sm') }}
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-semibold text-theme-headings">{{ request.document.title }}</span>
                                    <span class="block truncate text-xs text-theme-secondarytextcolor">from {{ request.requester.fullName }}</span>
                                </span>
                                {{ signing.due(request.deadline, true) }}
                                <a href="{{ path('app_document_sign', {id: request.document.id}) }}"
                                   class="btn btn-sm btn-primary inline-flex shrink-0 items-center gap-1.5">
                                    <i class="ti ti-signature text-sm leading-none" aria-hidden="true"></i>
                                    Sign
                                </a>
                            </li>
                        {% else %}
                            <li class="px-4 py-8 text-center text-sm text-theme-secondarytextcolor">Nothing is waiting on you.</li>
                        {% endfor %}
                    </ul>
                </div>

                {# What you are waiting on other people for. Not work - a status. #}
                {% if sent is not empty %}
                    <div class="card !mb-0 overflow-hidden">
                        <div class="flex items-center justify-between px-4 pb-2 pt-4">
                            <h3 class="text-base font-semibold text-theme-headings">Waiting on others</h3>
                            <a href="{{ path('app_signing_requests', {tab: 'sent'}) }}" class="text-sm font-medium text-primary-500 hover:underline">All sent →</a>
                        </div>
                        <ul class="divide-y divide-theme-border/60">
                            {% for request in sent %}
                                <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
                                    {{ docs.pdf_icon('sm') }}
                                    <span class="min-w-0 flex-1">
                                        <a href="{{ path('app_document_show', {id: request.document.id}) }}"
                                           class="block truncate text-sm font-semibold text-theme-headings hover:text-primary-500">{{ request.document.title }}</a>
                                        <span class="block truncate text-xs text-theme-secondarytextcolor">
                                            {{ request.signedCount }} of {{ request.signers|length }} signed
                                            {%- if request.currentSigner %} · waiting for {{ request.currentSigner.user.fullName }}{% endif %}
                                        </span>
                                    </span>
                                    {{ signing.due(request.deadline, true) }}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            {# ── ③ activity chart ───────────────────────────────────────────── #}
            {% set series = [
                {key: 'uploaded',  label: 'Uploaded',  token: '--color-info-500',    chip: 'bg-info-500'},
                {key: 'signed',    label: 'Signed',    token: '--color-success-500', chip: 'bg-success-500'},
                {key: 'delivered', label: 'Delivered', token: '--color-primary-500', chip: 'bg-primary-500'},
            ] %}
            <div class="card !mb-0 p-4">
                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                    <h3 class="text-base font-semibold text-theme-headings">Your activity · last 6 months</h3>
                    <div class="flex items-center gap-4">
                        {% for s in series %}
                            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-theme-secondarytextcolor">
                                <span class="h-2.5 w-2.5 rounded-sm {{ s.chip }}"></span>{{ s.label }}
                            </span>
                        {% endfor %}
                    </div>
                </div>
                {% set chart_data = {
                    labels: monthly|map(m => m.label),
                    series: series|map(s => {label: s.label, token: s.token, values: monthly|map(m => m[s.key])}),
                } %}
                <div data-controller="chart" data-chart-data-value="{{ chart_data|json_encode|e('html_attr') }}"></div>
                {# Screen-reader equivalent of the chart. #}
                <table class="sr-only">
                    <caption>Documents uploaded, signed and delivered per month, last 6 months</caption>
                    <thead><tr><th>Month</th>{% for s in series %}<th>{{ s.label }}</th>{% endfor %}</tr></thead>
                    <tbody>
                        {% for month in monthly %}
                            <tr><th>{{ month.label }}</th>{% for s in series %}<td>{{ month[s.key] }}</td>{% endfor %}</tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            </div>

            {# RIGHT rail: certificates, then what you have been doing. #}
            <div class="flex flex-col gap-4">

                <div class="card !mb-0 px-4 pb-3 pt-4" data-controller="slider">
                    <div class="mb-3 flex items-center justify-between">
                        <h3 class="text-base font-semibold text-theme-headings">Your certificates</h3>
                        <div class="flex gap-1.5 {{ certificates|length < 2 ? 'hidden' }}">
                            <button type="button" data-action="slider#prev" title="Previous"
                                    class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg border border-theme-border bg-white text-theme-secondarytextcolor hover:bg-theme-activebg">
                                <i class="ti ti-chevron-left text-sm leading-none" aria-hidden="true"></i>
                            </button>
                            <button type="button" data-action="slider#next" title="Next"
                                    class="inline-flex h-7 w-7 cursor-pointer items-center justify-center rounded-lg border border-theme-border bg-white text-theme-secondarytextcolor hover:bg-theme-activebg">
                                <i class="ti ti-chevron-right text-sm leading-none" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    {% if certificates is empty %}
                        <div class="rounded-lg border border-dashed border-theme-inputborder px-5 py-7 text-center">
                            <p class="mb-1 text-sm font-semibold text-theme-headings">No certificates yet</p>
                            <p class="mb-3 text-sm text-theme-secondarytextcolor">You need one to sign a document. Receiving one needs nothing.</p>
                            <a href="{{ path('app_certificate_new') }}" class="btn btn-primary btn-sm">Create your certificate</a>
                        </div>
                    {% endif %}

                    <div class="overflow-hidden">
                        <div class="flex transition-transform duration-300 ease-[cubic-bezier(0.4,0,0.2,1)]" data-slider-target="track">
                            {% for cert in certificates %}
                                {% set expiring = cert.status.expiring %}
                                <div class="box-border w-full shrink-0">
                                    <div class="overflow-hidden rounded-lg border border-theme-border">
                                        <div class="h-1 {{ cert.status.accentClass }}"></div>
                                        <div class="p-4">
                                            <div class="flex items-center justify-between">
                                                <span class="text-sm font-semibold text-theme-headings">{{ cert.name }}</span>
                                                <span class="badge rounded-full {{ cert.status.badgeClass }}">{{ expiring ? 'Expires in ' ~ cert.expires_in : cert.status.label }}</span>
                                            </div>
                                            <div class="mt-3 flex flex-col gap-2 text-sm">
                                                <div class="flex justify-between"><span class="text-theme-secondarytextcolor">Algorithm</span><span class="font-medium text-theme-headings">{{ cert.algorithm }}</span></div>
                                                <div class="flex justify-between"><span class="text-theme-secondarytextcolor">Valid until</span><span class="font-medium {{ expiring ? 'text-warning-600' : 'text-theme-headings' }}">{{ cert.valid_until }}</span></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="mt-3 flex items-center justify-center gap-1.5 {{ certificates|length < 2 ? 'hidden' }}">
                        {% for cert in certificates %}
                            <button type="button" data-slider-target="dot" data-action="slider#set" data-slider-index-param="{{ loop.index0 }}"
                                    title="Certificate {{ loop.index }}"
                                    class="h-1.5 cursor-pointer rounded-full border-none p-0 transition-all duration-200 {{ loop.first ? 'w-5 bg-primary-500' : 'w-1.5 bg-theme-border' }}"></button>
                        {% endfor %}
                    </div>

                    <a href="{{ path('app_certificates') }}" class="-mx-4 mt-2 block border-t border-theme-border/60 px-4 pt-2.5 text-sm font-medium text-primary-500 hover:underline">View all certificates →</a>
                </div>

                {#
                    The activity feed is a read of the audit log, not a second
                    store: everything Sigil does is already recorded there.
                #}
                <div class="card !mb-0 px-4 py-4">
                    <h3 class="mb-3 text-base font-semibold text-theme-headings">Recent activity</h3>
                    {% set activity_styles = {
                        'document.uploaded':                {classes: 'bg-info-500/10 text-info-600',       icon: 'ti-upload',       label: 'Uploaded a document'},
                        'document.signed':                  {classes: 'bg-success-500/10 text-success-600', icon: 'ti-signature',    label: 'Signed a document'},
                        'document.accessed':                {classes: 'bg-theme-activebg text-theme-secondarytextcolor', icon: 'ti-eye', label: 'Opened a document'},
                        'document.version_access_granted':  {classes: 'bg-primary-500/10 text-primary-500', icon: 'ti-key',          label: 'Handed over a key'},
                        'delivery.served':                  {classes: 'bg-primary-500/10 text-primary-500', icon: 'ti-mail-forward', label: 'Delivered a document'},
                        'signing_request.created':          {classes: 'bg-info-500/10 text-info-600',       icon: 'ti-send',         label: 'Sent for signature'},
                        'signing_request.completed':        {classes: 'bg-success-500/10 text-success-600', icon: 'ti-circle-check', label: 'A request completed'},
                        'signing_request.declined':         {classes: 'bg-danger-500/10 text-danger-600',   icon: 'ti-ban',          label: 'A request was declined'},
                        'signing_request.expired':          {classes: 'bg-warning-500/10 text-warning-600', icon: 'ti-clock-x',      label: 'A request expired'},
                        'signing_request.cancelled':        {classes: 'bg-theme-activebg text-theme-secondarytextcolor', icon: 'ti-arrow-back-up', label: 'A request was withdrawn'},
                        'receipt.sealed':                   {classes: 'bg-primary-500/10 text-primary-500', icon: 'ti-receipt',      label: 'A receipt was sealed'},
                        'certificate.issued':               {classes: 'bg-success-500/10 text-success-600', icon: 'ti-shield-check', label: 'Certificate issued'},
                    } %}
                    <div class="flex flex-col gap-3">
                        {% for entry in activity %}
                            {% set style = activity_styles[entry.action]|default({classes: 'bg-theme-activebg text-theme-secondarytextcolor', icon: 'ti-point', label: entry.action}) %}
                            <div class="flex gap-3">
                                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg {{ style.classes }}">
                                    <i class="ti {{ style.icon }} text-sm leading-none" aria-hidden="true"></i>
                                </span>
                                <div class="min-w-0">
                                    <div class="text-sm font-medium text-theme-headings">{{ style.label }}</div>
                                    <div class="text-xs text-theme-secondarytextcolor">{{ entry.occurredAt|date('d M Y, H:i') }}</div>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-sm text-theme-secondarytextcolor">No activity yet.</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

    {% endif %}
</div>
{% endblock %}
