{% extends 'layout/app.html.twig' %}

{% block title %}Signing requests · Sigil{% endblock %}
{% block main_class %}docs-gradient{% endblock %}

{% block content %}
{#
    One page for the whole life of a signature request, from this user's side:
    what is waiting on them, what they are waiting on other people for, and what
    is settled. Shaped as cards rather than a table - a request is an envelope
    with a deadline, not a row in a library.
#}
<div class="docs-rise mx-auto max-w-5xl">

    <div class="mb-5 flex flex-wrap items-end justify-between gap-x-4 gap-y-3">
        <div class="min-w-0">
            <h1 class="text-2xl font-extrabold tracking-tight text-theme-headings">Signing requests</h1>
            <p class="mt-1 text-sm text-theme-secondarytextcolor">Documents people have asked you to sign, and the ones you asked for.</p>
        </div>
        {% if counts.sign %}
            <span class="inline-flex shrink-0 items-center gap-2 rounded-full bg-primary-500/10 px-3 py-1.5 text-sm font-bold text-primary-500">
                <i class="ti ti-pen text-base leading-none" aria-hidden="true"></i>
                {{ counts.sign }} waiting on you
            </span>
        {% endif %}
    </div>

    {# Tabs by ?tab= rather than client-side toggling, like the documents list. #}
    <div class="mb-5 flex items-center gap-6 border-b border-theme-border">
        {% for key, label in {'sign': 'To sign', 'sent': 'Sent', 'history': 'History'} %}
            {% set count = counts[key]|default(0) %}
            <a href="{{ path('app_signing_requests', key == 'sign' ? {} : {tab: key}) }}"
               class="inline-flex items-center gap-2 pb-3 text-sm font-semibold {{ tab == key
                   ? 'border-b-2 border-primary-500 text-primary-500'
                   : 'text-theme-secondarytextcolor hover:text-theme-headings' }}">
                {{ label }}
                {% if count %}
                    <span class="rounded-full bg-theme-activebg px-2 py-0.5 text-[11px] font-bold text-theme-secondarytextcolor">{{ count }}</span>
                {% endif %}
            </a>
        {% endfor %}
    </div>

    {% if tab == 'sent' %}
        {{ include('signing/_tab_sent.html.twig') }}
    {% elseif tab == 'history' %}
        {{ include('signing/_tab_history.html.twig') }}
    {% else %}
        {{ include('signing/_tab_to_sign.html.twig') }}
    {% endif %}
</div>
{% endblock %}
