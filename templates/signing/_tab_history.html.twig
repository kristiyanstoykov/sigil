{% import 'signing/_macros.html.twig' as signing %}

{#
    Settled requests, both roles, one row each: what it was, how it ended, your
    part in it, when. The eye opens the whole story - who was asked, in what
    order, what they did - in a modal, with the receipt and the document.
    Includes the ones you declined - closing revoked your grant on the document,
    so this row and its receipt are the only trace left to you.

    Search, sort, paging and rows-per-page are Able Pro's datatable, mounted by
    history_table_controller.js; every row is rendered, so the list still reads
    without JavaScript. Below md the rows restyle as cards (documents-table.css),
    hence data-label on every cell. The modals live OUTSIDE the table: the
    library re-renders rows as it pages and sorts, and a modal inside one would
    be re-rendered with it.
#}
{% if history is empty %}
    {{ signing.empty(
        'ti-history',
        'Nothing settled yet',
        'Completed, declined, expired and withdrawn requests collect here - yours and the ones you were asked to sign.'
    ) }}
{% else %}
    {# The controller sits on this wrapper, not on the <table> - see the controller. #}
    <div class="docs-table"
         data-controller="history-table"
         data-history-table-per-page-value="10"
         data-history-table-date-column-value="3"
         data-history-table-actions-column-value="4">
        <div class="card !mb-0 overflow-hidden !bg-white/90">
            <div class="table-responsive">
                <table class="table w-full text-left" data-history-table-target="table">
                    <thead class="border-b border-theme-border bg-theme-bodybg/70 text-[11px] font-bold uppercase tracking-wider text-theme-secondarytextcolor">
                        <tr>
                            <th class="px-5 py-3 font-bold">Document</th>
                            <th class="px-5 py-3 font-bold">Outcome</th>
                            <th class="px-5 py-3 font-bold">Your part</th>
                            <th class="px-5 py-3 font-bold">Closed</th>
                            <th class="px-5 py-3 text-right font-bold">View</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-theme-border/60">
                        {% for request in history %}
                            {% set me = request.signerFor(app.user) %}
                            {% set total = request.signers|length %}
                            <tr class="hover:bg-theme-activebg/60">
                                <td class="px-5 py-3.5" data-label="Document">
                                    <span class="block text-sm font-semibold text-theme-headings">{{ request.document.title }}</span>
                                    <span class="mt-0.5 block text-xs text-theme-secondarytextcolor">
                                        {{ me ? 'From ' ~ request.requester.fullName : 'Sent to ' ~ total ~ ' signer' ~ (total == 1 ? '' : 's') }}
                                    </span>
                                </td>
                                <td class="px-5 py-3.5" data-label="Outcome">{{ signing.outcome_badge(request.status) }}</td>
                                <td class="px-5 py-3.5 text-sm text-theme-bodycolor" data-label="Your part">
                                    {{ me ? 'Signer ' ~ me.position ~ ' of ' ~ total : 'Requester' }}
                                </td>
                                <td class="px-5 py-3.5 text-sm text-theme-bodycolor whitespace-nowrap" data-label="Closed">{{ request.closedAt|date('d M Y H:i') }}</td>
                                <td class="px-5 py-3.5" data-label="View">
                                    <div class="flex justify-end">
                                        {# The theme's square icon button, in the same outline as the row actions elsewhere. #}
                                        <button type="button"
                                                class="btn btn-icon btn-outline-secondary inline-flex"
                                                data-pc-toggle="modal" data-pc-target="#history-{{ request.id }}"
                                                title="View request" aria-label="View request">
                                            <i class="ti ti-eye text-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# One modal per row, the theme's own (elements/ac_modal.html). #}
    {% for request in history %}
        {% set me = request.signerFor(app.user) %}
        {% set receipt = request_receipt(request) %}
        {% set canOpen = readable[request.id]|default(false) %}
        {% set total = request.signers|length %}
        {% set modalId = 'history-' ~ request.id %}

        <div id="{{ modalId }}" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="{{ modalId }}-title" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="min-w-0">
                            <h5 class="modal-title truncate" id="{{ modalId }}-title">{{ request.document.title }}</h5>
                            <p class="mt-0.5 text-xs text-theme-secondarytextcolor">
                                {{ me
                                    ? 'From ' ~ request.requester.fullName ~ ' · you were signer ' ~ me.position ~ ' of ' ~ total
                                    : 'You sent this to ' ~ total ~ ' signer' ~ (total == 1 ? '' : 's') }}
                            </p>
                        </div>
                        <button type="button" data-pc-modal-dismiss="#{{ modalId }}" aria-label="Close"
                                class="flex h-7 w-7 shrink-0 items-center justify-center rounded text-lg text-theme-secondarytextcolor hover:bg-danger-500/10 hover:text-danger-500">
                            <i class="ti ti-x" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="modal-body max-h-[70vh] overflow-y-auto">
                        {{ signing.request_timeline(request, false) }}
                    </div>
                    <div class="modal-footer flex flex-wrap items-center gap-2">
                        {% if receipt %}
                            <a href="{{ path('app_receipt_download', {id: receipt.id}) }}" data-turbo="false"
                               class="btn btn-sm btn-outline-secondary inline-flex items-center gap-1.5">
                                <i class="ti ti-receipt text-sm leading-none" aria-hidden="true"></i>
                                Receipt
                            </a>
                        {% endif %}
                        {% if canOpen %}
                            <a href="{{ path('app_document_show', {id: request.document.id}) }}"
                               class="btn btn-sm btn-outline-secondary inline-flex items-center gap-1.5">
                                <i class="ti ti-file-text text-sm leading-none" aria-hidden="true"></i>
                                Open document
                            </a>
                        {% else %}
                            {# Never offer a link this user cannot follow: a decliner
                               lost their grant when the request closed. #}
                            <span class="inline-flex items-center gap-1.5 rounded-lg bg-theme-activebg px-3 py-1.5 text-xs font-medium text-theme-secondarytextcolor">
                                <i class="ti ti-lock text-sm leading-none" aria-hidden="true"></i>
                                You no longer hold this document
                            </span>
                        {% endif %}
                        <button type="button" class="btn btn-sm btn-primary ml-auto" data-pc-modal-dismiss="#{{ modalId }}">Close</button>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

    {# A request whose document was erased is erased with it (the FK cascades),
       so the expired-and-never-signed case only survives as a receipt. #}
    <p class="mt-5 text-xs leading-relaxed text-theme-secondarytextcolor">
        Requests whose document has since been destroyed are not listed here. Their sealed receipts remain under
        <a href="{{ path('app_receipts') }}" class="font-semibold text-primary-500 hover:underline">Receipts</a>.
    </p>
{% endif %}
