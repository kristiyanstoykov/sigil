{#
    Signing-request macros. Import with:
      {% import 'signing/_macros.html.twig' as signing %}

    Class strings are written out in full, never interpolated: Tailwind scans
    templates for literal utilities.
#}

{#
    The outcome of a closed request. Only History renders this: on the Sent tab
    every card is pending by definition, and the progress bar says it better.
#}
{% macro outcome_badge(status) %}
    {% set style = {
        'completed': {classes: 'bg-success-500/10 text-success-600', icon: 'ti-circle-check'},
        'declined':  {classes: 'bg-danger-500/10 text-danger-600',   icon: 'ti-ban'},
        'expired':   {classes: 'bg-warning-500/10 text-warning-600', icon: 'ti-alert-triangle'},
        'cancelled': {classes: 'bg-theme-activebg text-theme-secondarytextcolor', icon: 'ti-arrow-back-up'},
        'pending':   {classes: 'bg-primary-500/10 text-primary-500', icon: 'ti-clock'},
    }[status.value] %}
    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-[11px] font-bold {{ style.classes }}">
        <i class="ti {{ style.icon }} text-xs leading-none" aria-hidden="true"></i>
        {{ status.label }}
    </span>
{% endmacro %}

{# How many of the list have signed, as a bar plus a count. #}
{% macro progress(request) %}
    {% set total = request.signers|length %}
    {% set done = request.signedCount %}
    <div class="min-w-0">
        <div class="flex items-baseline justify-between gap-3">
            <span class="text-xs font-medium uppercase tracking-wide text-theme-secondarytextcolor">Progress</span>
            <span class="text-xs font-bold text-theme-headings">{{ done }} of {{ total }} signed</span>
        </div>
        <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-theme-activebg">
            <div class="h-full rounded-full bg-primary-500" style="width: {{ total ? (done / total * 100)|round : 0 }}%"></div>
        </div>
    </div>
{% endmacro %}

{#
    Due date with a countdown, coloured by how little time is left.

    daysLeft counts calendar days between the two dates, not 24-hour blocks: a
    deadline is minted as "now + N days" and read minutes or hours later, so
    elapsed-time maths floors a 3-day deadline to "in 2 days" while the date
    printed right beside it still says the third day. Rounded because a DST
    change makes one of those days 23 or 25 hours long. (An inline expression
    rather than a shared macro - a Twig macro returns Markup, which compares as
    0 against an integer.)
#}
{% macro due(deadline, loud) %}
    {% set daysLeft = ((deadline|date('Y-m-d')|date('U') - "now"|date('Y-m-d')|date('U')) / 86400)|round %}
    {# Overdue is the clock, not the calendar: a deadline at 09:00 has passed by
       lunchtime, while the calendar still calls it today. #}
    {% set overdue = deadline.timestamp < "now"|date('U') %}
    {% set tone = not loud
        ? 'text-theme-secondarytextcolor'
        : (overdue or daysLeft <= 1 ? 'text-danger-600' : (daysLeft <= 3 ? 'text-warning-600' : 'text-primary-500')) %}
    <div class="min-w-0">
        <div class="text-xs font-medium uppercase tracking-wide text-theme-secondarytextcolor">Due</div>
        <div class="mt-0.5 text-sm font-bold {{ tone }}">
            {{ deadline|date('d M Y') }}
            {%- if loud %}
                <span class="font-semibold">
                    · {% if overdue %}overdue{% elseif daysLeft == 0 %}today{% elseif daysLeft == 1 %}tomorrow{% else %}in {{ daysLeft }} days{% endif %}
                </span>
            {%- endif %}
        </div>
    </div>
{% endmacro %}

{# An empty tab. Same shape as the documents list's empty states. #}
{% macro empty(icon, heading, body) %}
    <div class="card !mb-0 !bg-white/80 p-14 text-center">
        <div class="mb-4 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-500/10 text-primary-500 mx-auto">
            <i class="ti {{ icon }} text-3xl leading-none" aria-hidden="true"></i>
        </div>
        <h2 class="text-lg font-extrabold text-theme-headings">{{ heading }}</h2>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-theme-secondarytextcolor">{{ body }}</p>
    </div>
{% endmacro %}

{#
    The ordered signer list, read-only. Top is first: each row shows whether that
    signer has signed, holds the turn, or is still waiting behind someone.
#}
{% macro signer_queue(request) %}
    {% set current = request.currentSigner %}
    <div class="card !mb-0 overflow-hidden !bg-white/90">
        <ol class="divide-y divide-theme-border/60">
            {% for signer in request.orderedSigners %}
                {% set isCurrent = current and current.position == signer.position and request.isPending %}
                <li class="flex items-center gap-3 p-4">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold
                                 {{ signer.hasSigned ? 'bg-success-500/10 text-success-600' : (isCurrent ? 'bg-info-500/10 text-info-600' : 'bg-theme-activebg text-theme-secondarytextcolor') }}">
                        {{ signer.position }}
                    </span>
                    <span class="min-w-0 flex-1">
                        <span class="block truncate text-sm font-semibold text-theme-headings">{{ signer.user.fullName }}</span>
                        <span class="block truncate text-xs text-theme-secondarytextcolor">{{ signer.user.email }}</span>
                    </span>
                    {% if signer.hasSigned %}
                        <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-success-500/20 bg-success-500/10 px-2.5 py-0.5 text-xs font-semibold text-success-600">
                            <i class="ti ti-circle-check text-sm leading-none" aria-hidden="true"></i>
                            Signed {{ signer.signedAt|date('d M Y') }}
                        </span>
                    {% elseif isCurrent %}
                        <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border border-info-500/20 bg-info-500/10 px-2.5 py-0.5 text-xs font-semibold text-info-600">
                            <i class="ti ti-clock text-sm leading-none" aria-hidden="true"></i>
                            Their turn
                        </span>
                    {% else %}
                        <span class="shrink-0 rounded-full bg-theme-activebg px-2.5 py-0.5 text-[11px] font-semibold text-theme-secondarytextcolor">Waiting</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </div>
{% endmacro %}

{# Deadline line, with the days left when the request is still open. #}
{% macro deadline_note(request) %}
    <p class="mt-3 text-xs text-theme-secondarytextcolor">
        {% if request.isPending %}
            Expires {{ request.deadline|date('d M Y, H:i') }}. If it is not signed by then, the request lapses
            and any signatures already collected are kept.
        {% else %}
            {{ request.status.label }}{% if request.closedAt %} on {{ request.closedAt|date('d M Y') }}{% endif %}.
        {% endif %}
    </p>
{% endmacro %}

{#
    A closed (or open) request as a vertical timeline: who was asked, what each
    of them did, and how it ended. Built from the request's own rows rather than
    the audit log - the signer carries signedAt/declinedAt and the version it
    produced, which is exactly the story.

    `heading` is false on the document page, where the header card has already
    said which document this is. `subtitle` carries the viewer's own role, which
    a macro cannot work out for itself.
#}
{% macro request_timeline(request, heading = true, subtitle = null) %}
    {% import 'signing/_macros.html.twig' as signing %}
    {% set total = request.signers|length %}
    {% set declined = request.declinedBy %}
    {% set ordered = request.orderedSigners %}

    <div class="card !mb-0 overflow-hidden !bg-white/90">
        <div class="flex flex-wrap items-start justify-between gap-3 border-b border-theme-border/60 p-5">
            <div class="min-w-0">
                <p class="text-sm font-bold text-theme-headings">
                    {{ heading ? request.document.title : 'Signature request' }}
                </p>
                <p class="mt-0.5 text-xs text-theme-secondarytextcolor">
                    {{ subtitle ?? 'Sent to ' ~ total ~ ' signer' ~ (total == 1 ? '' : 's') }} ·
                    deadline {{ request.isPending ? '' : 'was ' }}{{ request.deadline|date('d M Y') }}
                </p>
            </div>
            {{ signing.outcome_badge(request.status) }}
        </div>

        <ol class="divide-y divide-theme-border/60">
            {# 1. sent #}
            <li class="flex gap-3 p-5">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary-500/10 text-primary-500">
                    <i class="ti ti-send text-sm leading-none" aria-hidden="true"></i>
                </span>
                <div class="min-w-0">
                    <p class="text-sm font-semibold text-theme-headings">Request sent to {{ total }} signer{{ total == 1 ? '' : 's' }}</p>
                    <p class="mt-0.5 font-mono text-xs text-theme-secondarytextcolor">{{ request.createdAt|date('d M Y, H:i') }}</p>
                    <p class="mt-1.5 text-xs leading-relaxed text-theme-secondarytextcolor">
                        {% for signer in ordered %}{{ signer.user.fullName }}{% if not loop.last %}, then {% endif %}{% endfor %}.
                        {{ total == 1 ? 'They were' : 'Every one of them was' }} checked for a verified account
                        and a usable certificate at this moment.
                    </p>
                </div>
            </li>

            {# 2. what each signer did, in queue order - which is also time order #}
            {% for signer in ordered %}
                {% if signer.hasSigned %}
                    <li class="flex gap-3 p-5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-success-500/10 text-success-600">
                            <i class="ti ti-circle-check text-sm leading-none" aria-hidden="true"></i>
                        </span>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-theme-headings">{{ signer.user.fullName }} signed</p>
                            <p class="mt-0.5 font-mono text-xs text-theme-secondarytextcolor">{{ signer.signedAt|date('d M Y, H:i:s') }}</p>
                            <p class="mt-1.5 text-xs leading-relaxed text-theme-secondarytextcolor">
                                Signer {{ signer.position }} of {{ total }}{% if signer.version %} · produced v{{ signer.version.versionNumber }}{% endif %}.
                                {% if not loop.last %}The turn passed on, and only then could the next signer decrypt the document.{% endif %}
                            </p>
                        </div>
                    </li>
                {% elseif signer.declinedAt %}
                    <li class="flex gap-3 p-5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-danger-500/10 text-danger-600">
                            <i class="ti ti-ban text-sm leading-none" aria-hidden="true"></i>
                        </span>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-theme-headings">{{ signer.user.fullName }} declined</p>
                            <p class="mt-0.5 font-mono text-xs text-theme-secondarytextcolor">{{ signer.declinedAt|date('d M Y, H:i:s') }}</p>
                            <p class="mt-1.5 text-xs leading-relaxed text-theme-secondarytextcolor">
                                Signer {{ signer.position }} of {{ total }}. Nobody after them was asked, and nobody after them ever held a key.
                            </p>
                            {% if signer.declineReason %}
                                <p class="mt-2 rounded-lg bg-danger-500/[0.06] px-3 py-2 text-xs italic leading-relaxed text-theme-bodycolor">
                                    "{{ signer.declineReason }}"
                                </p>
                            {% endif %}
                        </div>
                    </li>
                {% endif %}
            {% endfor %}

            {# 3. nobody at all - the expiry that destroys the file #}
            {% if not request.hasAnySignature and not declined and not request.isPending %}
                <li class="flex gap-3 p-5">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-theme-activebg text-theme-secondarytextcolor">
                        <i class="ti ti-clock text-sm leading-none" aria-hidden="true"></i>
                    </span>
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-theme-headings">Nobody signed</p>
                        <p class="mt-1.5 text-xs leading-relaxed text-theme-secondarytextcolor">
                            The turn never left signer 1, so nobody behind them was ever handed the document.
                        </p>
                    </div>
                </li>
            {% endif %}

            {# 4. how it closed #}
            {% if not request.isPending %}
                {% set closing = {
                    'completed': {icon: 'ti-circle-check', classes: 'bg-success-500/10 text-success-600', title: 'Closed as completed · receipt sealed', body: 'Everyone on the list signed. The receipt names the audience as sent, and the request cannot be re-opened or re-sent.'},
                    'declined':  {icon: 'ti-ban', classes: 'bg-danger-500/10 text-danger-600', title: 'Closed as declined · receipt sealed', body: 'A refusal closes the whole queue. Signatures already collected are kept as versions of the document.'},
                    'expired':   {icon: 'ti-alert-triangle', classes: 'bg-warning-500/10 text-warning-600', title: 'Deadline passed · request expired', body: 'With at least one signature the document is kept and marked Expired. With none at all it is destroyed, and the receipt is the only surviving record.'},
                    'cancelled': {icon: 'ti-arrow-back-up', classes: 'bg-theme-activebg text-theme-secondarytextcolor', title: 'Withdrawn · receipt sealed', body: 'The sender closed their own request. Whoever held the turn lost access; signatures already made were kept.'},
                }[request.status.value] %}
                {% if closing %}
                    <li class="flex gap-3 p-5">
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full {{ closing.classes }}">
                            <i class="ti {{ closing.icon }} text-sm leading-none" aria-hidden="true"></i>
                        </span>
                        <div class="min-w-0">
                            <p class="text-sm font-semibold text-theme-headings">{{ closing.title }}</p>
                            {% if request.closedAt %}
                                <p class="mt-0.5 font-mono text-xs text-theme-secondarytextcolor">{{ request.closedAt|date('d M Y, H:i:s') }}</p>
                            {% endif %}
                            <p class="mt-1.5 text-xs leading-relaxed text-theme-secondarytextcolor">{{ closing.body }}</p>
                        </div>
                    </li>
                {% endif %}
            {% endif %}
        </ol>
    </div>
{% endmacro %}
