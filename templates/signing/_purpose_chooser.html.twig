{#
    What is this document for? Shown to the owner of a document that has no
    signature request yet - the moment an upload lands here.

    Each option opens its own Able Pro modal (_purpose_modal.html.twig);
    ?purpose=<key> opens that one with the page.

    Context: document, form, hasUsableCertificate, canRequest, openPurpose.
#}
{% import 'documents/_macros.html.twig' as docs %}

{% set canSelfSign = hasUsableCertificate %}
{% set requestBlocked = not canRequest %}

<div>

    <div class="card !mb-0 !bg-white/90 p-5">
        <div class="flex items-start justify-between gap-3">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-wider text-theme-secondarytextcolor">This document</p>
                <h2 class="mt-0.5 text-base font-bold text-theme-headings">What is it for?</h2>
            </div>
            {{ docs.doc_status_badge(document_status(document)) }}
        </div>
        <p class="mt-2 text-sm text-theme-secondarytextcolor">
            Asked once, right after upload: it decides which of the three paths this file takes. A document
            carries one signature request for its whole life, so this is a decision rather than a menu.
        </p>

        <div class="mt-4 space-y-2.5">
            <button type="button" data-pc-toggle="modal" data-pc-target="#purpose-self" {{ canSelfSign ? '' : 'disabled' }}
                    class="block w-full rounded-lg border border-theme-border p-4 text-left transition-colors hover:bg-theme-activebg disabled:pointer-events-none disabled:opacity-50">
                <span class="flex items-start gap-3">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-500/10 text-primary-500"><i class="ti ti-signature text-xl leading-none" aria-hidden="true"></i></span>
                    <span class="min-w-0">
                        <span class="block text-sm font-bold text-theme-headings">I sign it myself</span>
                        <span class="mt-0.5 block text-sm text-theme-secondarytextcolor">Certificate and PIN, now. One signature, one new version.</span>
                        <span class="mt-1.5 block text-[11px] font-semibold uppercase tracking-wide text-theme-secondarytextcolor">Ends as Signed · delivery still open</span>
                    </span>
                </span>
            </button>
            {% if not canSelfSign %}
                <p class="-mt-1 flex flex-wrap items-center gap-1.5 pl-1 text-xs text-warning-600">
                    <i class="ti ti-lock text-sm leading-none" aria-hidden="true"></i> Needs a usable certificate.
                    <a href="{{ path('app_certificate_new') }}" class="font-semibold underline">Add a certificate</a>
                </p>
            {% endif %}

            <button type="button" data-pc-toggle="modal" data-pc-target="#purpose-then" {{ canSelfSign and not requestBlocked ? '' : 'disabled' }}
                    class="block w-full rounded-lg border border-theme-border p-4 text-left transition-colors hover:bg-theme-activebg disabled:pointer-events-none disabled:opacity-50">
                <span class="flex items-start gap-3">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-500/10 text-primary-500"><i class="ti ti-users text-xl leading-none" aria-hidden="true"></i></span>
                    <span class="min-w-0">
                        <span class="block text-sm font-bold text-theme-headings">Others sign it, then I do</span>
                        <span class="mt-0.5 block text-sm text-theme-secondarytextcolor">You go last on the ordered list. Nobody can jump the queue.</span>
                        <span class="mt-1.5 block text-[11px] font-semibold uppercase tracking-wide text-theme-secondarytextcolor">One request per document, ever</span>
                    </span>
                </span>
            </button>
            {% if canSelfSign is same as(false) and not requestBlocked %}
                <p class="-mt-1 flex items-center gap-1.5 pl-1 text-xs text-warning-600">
                    <i class="ti ti-lock text-sm leading-none" aria-hidden="true"></i> Needs a usable certificate, because your signature is in the queue.
                </p>
            {% endif %}

            <button type="button" data-pc-toggle="modal" data-pc-target="#purpose-only" {{ not requestBlocked ? '' : 'disabled' }}
                    class="block w-full rounded-lg border border-theme-border p-4 text-left transition-colors hover:bg-theme-activebg disabled:pointer-events-none disabled:opacity-50">
                <span class="flex items-start gap-3">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-500/10 text-primary-500"><i class="ti ti-send text-xl leading-none" aria-hidden="true"></i></span>
                    <span class="min-w-0">
                        <span class="block text-sm font-bold text-theme-headings">Others sign it, I do not</span>
                        <span class="mt-0.5 block text-sm text-theme-secondarytextcolor">You send it and wait. Your name is not on the list.</span>
                        <span class="mt-1.5 block text-[11px] font-semibold uppercase tracking-wide text-theme-secondarytextcolor">One request per document, ever</span>
                    </span>
                </span>
            </button>
            {% if requestBlocked %}
                <p class="-mt-1 flex items-center gap-1.5 pl-1 text-xs text-warning-600">
                    <i class="ti ti-lock text-sm leading-none" aria-hidden="true"></i>
                    This document has already had its one signature request. To send it again, upload it again.
                </p>
            {% endif %}

            <button type="button" data-pc-toggle="modal" data-pc-target="#purpose-deliver"
                    class="block w-full rounded-lg border border-theme-border p-4 text-left transition-colors hover:bg-theme-activebg disabled:pointer-events-none disabled:opacity-50">
                <span class="flex items-start gap-3">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-info-500/10 text-info-600"><i class="ti ti-mail-forward text-xl leading-none" aria-hidden="true"></i></span>
                    <span class="min-w-0">
                        <span class="block text-sm font-bold text-theme-headings">I deliver it to people</span>
                        <span class="mt-0.5 block text-sm text-theme-secondarytextcolor">Registered mail. Nothing is asked of them, and nothing follows it.</span>
                        <span class="mt-1.5 block text-[11px] font-semibold uppercase tracking-wide text-theme-secondarytextcolor">Terminal · cannot be undone</span>
                    </span>
                </span>
            </button>
        </div>

        <p class="mt-4 flex items-start gap-2 text-xs leading-relaxed text-theme-secondarytextcolor">
            <i class="ti ti-info-circle mt-px text-sm leading-none" aria-hidden="true"></i>
            <span>
                Choosing opens the next step; you are not committing to anything yet, and you can still leave it.
                But a signature request, once sent, is the only one this document ever gets.
            </span>
        </p>
    </div>

    {{ include('signing/_purpose_modal.html.twig') }}
</div>
