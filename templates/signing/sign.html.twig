{% extends 'layout/app.html.twig' %}
{% import 'documents/_macros.html.twig' as docs %}
{% import 'signing/_macros.html.twig' as signing %}

{% block title %}Sign {{ document.title }} · Sigil{% endblock %}
{% block main_class %}docs-gradient{% endblock %}

{% block content %}
{% set latest = document.latestVersion %}
{% set isOwner = document.owner.id == app.user.id %}
{# The owner of a document nobody has been asked to sign yet is the one who
   decides what it is for. Everyone else is here because a request reached them,
   and gets the signature form directly. #}
{% set choosing = isOwner and signingRequest is null %}

<div class="docs-rise mx-auto max-w-6xl">

    <a href="{{ path('app_documents') }}" class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-theme-secondarytextcolor hover:text-theme-headings">
        <i class="ti ti-chevron-left text-base leading-none" aria-hidden="true"></i>
        Documents
    </a>

    {# One document header, above both columns. The left column used to repeat
       the filename in a summary card - the same name twice on one screen. #}
    <div class="card !mb-5 !bg-white/90 p-5">
        <div class="flex items-start gap-4">
            {{ docs.pdf_icon('lg') }}
            <div class="min-w-0 flex-1">
                <h1 class="truncate text-xl font-extrabold tracking-tight text-theme-headings">{{ document.title }}</h1>
                <p class="mt-0.5 text-sm text-theme-secondarytextcolor">
                    {% if choosing %}
                        Uploaded and encrypted. Nothing has been signed or sent yet.
                    {% else %}
                        A qualified electronic signature (PAdES) will be added as a new version.
                    {% endif %}
                </p>
                {% if latest %}
                    <div class="mt-2.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-theme-secondarytextcolor">
                        {{ docs.status_badge(latest.kind) }}
                        <span>v{{ latest.versionNumber }} · {{ docs.filesize(latest.sizeBytes) }} · {{ latest.createdAt|date('d M Y') }}</span>
                    </div>
                    <div class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1">
                        <span class="text-[11px] font-medium uppercase tracking-wide text-theme-secondarytextcolor">Signing the bytes with fingerprint</span>
                        <code class="rounded bg-theme-activebg px-1.5 py-0.5 font-mono text-xs text-theme-bodycolor whitespace-nowrap">{{ latest.contentHash|slice(0, 10) }}…{{ latest.contentHash|slice(-6) }}</code>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {#
        Two columns from lg: read the document on the left, act on it on the
        right. Signing something you cannot see is not a decision, so the viewer
        is part of the page rather than a link off it.
    #}
    <div class="grid gap-5 lg:grid-cols-5 lg:items-start">
    <div class="lg:col-span-3">

        {# Collapsed on a phone so the actions are reachable without scrolling
           past a screen of PDF; always open from lg up.

           A checkbox peer rather than <details>: the UA hides a closed details'
           content with content-visibility on a shadow-DOM slot, which author CSS
           cannot override, so lg:block would not reopen it. #}
        <input type="checkbox" id="pdf-toggle" class="peer/pdf sr-only">
        <label for="pdf-toggle"
               class="card !mb-0 !bg-white/90 flex cursor-pointer items-center gap-3 p-4 lg:hidden peer-focus-visible/pdf:ring-2 peer-focus-visible/pdf:ring-primary-500">
            {{ docs.pdf_icon() }}
            <span class="min-w-0 flex-1">
                <span class="block text-sm font-bold text-theme-headings">Read the document</span>
                <span class="block text-xs text-theme-secondarytextcolor">
                    <span class="peer-checked/pdf:hidden">Tap to open the preview</span>
                    <span class="hidden peer-checked/pdf:inline">Tap to collapse it</span>
                </span>
            </span>
            <i class="ti ti-chevron-down text-lg leading-none text-theme-secondarytextcolor transition-transform peer-checked/pdf:rotate-180" aria-hidden="true"></i>
        </label>

        <div class="mt-3 hidden peer-checked/pdf:block lg:mt-0 lg:block">
            {# Served by app_document_view, which streams the decrypted bytes
               inline. You already hold the key on your turn - this just stops
               hiding it. #}
            <div class="card !mb-0 overflow-hidden !bg-white/90 p-2">
                <iframe src="{{ path('app_document_view', {id: document.id}) }}#view=FitH"
                        title="{{ document.title }}"
                        class="h-[60vh] w-full rounded-md border-0 bg-theme-activebg lg:h-[72vh]"></iframe>
            </div>
            <p class="mt-2 text-center text-xs text-theme-secondarytextcolor">
                Trouble viewing it here?
                <a href="{{ path('app_document_view', {id: document.id}) }}" target="_blank" rel="noopener" data-turbo="false"
                   class="font-semibold text-primary-500 hover:underline">Open in a new tab</a>
            </p>
        </div>

    </div>
    <div class="lg:col-span-2">

    {% if choosing %}
        {{ include('signing/_purpose_chooser.html.twig', {canRequest: can_request_signatures(document)}) }}
    {% else %}
        {# Asked to sign: the form, the refusal beside it, and the queue. #}
        <div class="card !mb-0 p-6">
            {{ include('signing/_sign_panel.html.twig') }}
        </div>

        {% if signingRequest %}
            {# Being asked to sign is not being obliged to. The refusal sits next
               to the signature, not hidden away, and closes the request for
               everyone. #}
            <div data-controller="confirm" class="contents">
                <button type="button" data-action="confirm#open"
                        class="btn btn-outline-danger mt-3 inline-flex w-full items-center justify-center gap-2">
                    <i class="ti ti-x text-base leading-none" aria-hidden="true"></i>
                    Decline to sign
                </button>

                <div data-confirm-target="dialog" tabindex="-1" aria-hidden="true"
                     data-action="click->confirm#backdropClose keydown.esc@window->confirm#close"
                     class="hidden overflow-y-auto overflow-x-hidden fixed inset-0 z-[1050] flex justify-center items-center w-full h-full bg-theme-headings/40 backdrop-blur-sm modal-backdrop-fade">
                    <div data-confirm-target="card" class="relative w-full max-w-md p-6 m-5 glass-card !bg-white sm:!bg-white/90 modal-card">
                        <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-danger-500/10 text-danger-600">
                            <i class="ti ti-x text-xl leading-none" aria-hidden="true"></i>
                        </div>
                        <h2 class="mb-2 text-lg font-semibold text-theme-headings">Decline to sign this document?</h2>
                        <p class="mb-4 text-sm leading-relaxed text-theme-secondarytextcolor">
                            The request closes for everyone - nobody after you is asked to sign - and you lose
                            access to the document. {{ signingRequest.requester.fullName }} is told.
                        </p>
                        {{ form_start(declineForm, {
                            action: path('app_signing_request_decline', {id: signingRequest.id}),
                            attr: {class: 'space-y-4'}
                        }) }}
                            {{ form_row(declineForm.reason) }}
                            <div class="flex gap-2.5">
                                <button type="button" data-action="confirm#close" class="btn btn-outline-secondary flex-1">Go back</button>
                                <button type="submit" class="btn btn-danger flex-1">Decline</button>
                            </div>
                        {{ form_end(declineForm) }}
                    </div>
                </div>
            </div>

            <div class="mt-6">
                <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Signing order</h2>
                {{ signing.signer_queue(signingRequest) }}
                {{ signing.deadline_note(signingRequest) }}
            </div>
        {% endif %}
    {% endif %}

    </div>
    </div>
</div>
{% endblock %}
