{#
    One Able Pro modal per purpose, opened by the option buttons in
    _purpose_chooser.html.twig. Closing one is "back": the chooser is the page
    behind it. openPurpose (?purpose=<key>, also the return after a wrong PIN)
    opens that modal with the page.

    Context: document, form, hasUsableCertificate, openPurpose.
#}
{% embed 'components/modal.html.twig' with {id: 'purpose-self', icon: 'ti-signature', tone: 'primary', eyebrow: 'Step 2 of 2', title: 'Sign it with your certificate', open_on_load: openPurpose == 'self'} %}
    {% block content %}
        <div class="modal-body">
            {{ include('signing/_sign_panel.html.twig') }}
        </div>
    {% endblock %}
{% endembed %}

{% embed 'components/modal.html.twig' with {id: 'purpose-then', icon: 'ti-users', tone: 'primary', title: 'You are in the queue', open_on_load: openPurpose == 'then'} %}
    {% block content %}
        <div class="modal-body">
            <ul class="space-y-2 text-sm text-theme-bodycolor">
                <li class="flex items-start gap-2"><i class="ti ti-users mt-0.5 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i><span>You name the signers next and set the order by dragging. You start last, but you can sign at any position.</span></li>
                <li class="flex items-start gap-2"><i class="ti ti-clock mt-0.5 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i><span>Strict order: signer 2 cannot sign before signer 1. Deadline 7 days by default, 30 at most.</span></li>
                <li class="flex items-start gap-2"><i class="ti ti-circle-check mt-0.5 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i><span>A signer may decline, with an optional reason. That closes the request.</span></li>
            </ul>
            <a href="{{ path('app_signing_request_new', {id: document.id, include_me: 1}) }}"
               class="btn btn-primary mt-4 w-full inline-flex items-center justify-center gap-2">
                Choose the signers <i class="ti ti-chevron-right text-base leading-none" aria-hidden="true"></i>
            </a>
            <p class="mt-2 text-center text-xs text-theme-secondarytextcolor">Nothing is sent until you confirm.</p>
        </div>
    {% endblock %}
{% endembed %}

{% embed 'components/modal.html.twig' with {id: 'purpose-only', icon: 'ti-send', tone: 'primary', title: 'The queue will not include you', open_on_load: openPurpose == 'only'} %}
    {% block content %}
        <div class="modal-body">
            <ul class="space-y-2 text-sm text-theme-bodycolor">
                <li class="flex items-start gap-2"><i class="ti ti-users mt-0.5 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i><span>You name the signers and their order next. You are not in the queue and will not be asked to sign.</span></li>
                <li class="flex items-start gap-2"><i class="ti ti-clock mt-0.5 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i><span>Strict order: signer 2 cannot sign before signer 1. Deadline 7 days by default, 30 at most.</span></li>
                <li class="flex items-start gap-2"><i class="ti ti-circle-check mt-0.5 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i><span>A signer may decline, with an optional reason. That closes the request.</span></li>
            </ul>
            <a href="{{ path('app_signing_request_new', {id: document.id}) }}"
               class="btn btn-primary mt-4 w-full inline-flex items-center justify-center gap-2">
                Choose the signers <i class="ti ti-chevron-right text-base leading-none" aria-hidden="true"></i>
            </a>
            <p class="mt-2 text-center text-xs text-theme-secondarytextcolor">Nothing is sent until you confirm.</p>
        </div>
    {% endblock %}
{% endembed %}

{% embed 'components/modal.html.twig' with {id: 'purpose-deliver', icon: 'ti-mail-forward', tone: 'info', title: 'Delivery asks nothing in return', open_on_load: openPurpose == 'deliver'} %}
    {% block content %}
        <div class="modal-body">
            <ul class="space-y-2 text-sm text-theme-bodycolor">
                <li class="flex items-start gap-2"><i class="ti ti-mail-forward mt-0.5 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i><span>You name the recipients next. Everyone is served at the same moment, in no particular order.</span></li>
                <li class="flex items-start gap-2"><i class="ti ti-lock mt-0.5 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i><span>A delivery cannot be refused and nothing is asked of a recipient. There is no deadline.</span></li>
                <li class="flex items-start gap-2"><i class="ti ti-circle-check mt-0.5 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i><span>Delivery is final: once served, the document is finished.</span></li>
            </ul>
            <a href="{{ path('app_delivery_new', {id: document.id}) }}"
               class="btn btn-primary mt-4 w-full inline-flex items-center justify-center gap-2">
                Choose the recipients <i class="ti ti-chevron-right text-base leading-none" aria-hidden="true"></i>
            </a>
            <p class="mt-2 text-center text-xs text-theme-secondarytextcolor">Nothing is served until you confirm.</p>
        </div>
    {% endblock %}
{% endembed %}
