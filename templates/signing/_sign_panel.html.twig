{#
    The certificate + PIN panel. Rendered inline when a request put this user in
    the queue, and inside the purpose modal when the owner chose to sign it
    themselves - one copy so the two can never drift.

    Context: form, hasUsableCertificate, document.
#}
{% set E_CERTIFICATE = constant('App\\Signing\\Form\\SignDocumentForm::E_CERTIFICATE') %}
{% set E_PIN = constant('App\\Signing\\Form\\SignDocumentForm::E_PIN') %}

{% if hasUsableCertificate %}
    <div class="relative" data-controller="signing-form">
        {{ form_start(form, {
            action: path('app_document_sign', {id: document.id}),
            attr: {novalidate: 'novalidate', 'data-action': 'submit->signing-form#start'}
        }) }}

        <div class="rounded-lg border border-dashed border-primary-500/30 bg-primary-500/[0.03] px-4 py-3">
            <div class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-primary-500">
                <i class="ti ti-shield-check text-sm leading-none" aria-hidden="true"></i>
                Your seal
            </div>
            <p class="mt-1 text-sm font-bold uppercase tracking-wide text-theme-headings">{{ app.user.fullName|upper }}</p>
            <p class="text-xs text-theme-secondarytextcolor">Qualified electronic signature · Compliant with eIDAS</p>
        </div>

        <div class="mt-4">
            {{ form_label(form[E_CERTIFICATE], null, {label_attr: {class: 'form-label text-sm font-medium'}}) }}
            {{ form_widget(form[E_CERTIFICATE], {attr: {class: 'form-select'}}) }}
            {{ form_errors(form[E_CERTIFICATE]) }}
        </div>

        <div class="mt-3">
            {{ form_label(form[E_PIN], null, {label_attr: {class: 'form-label text-sm font-medium'}}) }}
            {{ form_widget(form[E_PIN], {attr: {class: 'form-control font-mono tracking-[0.3em]', placeholder: '••••••'}}) }}
            {{ form_errors(form[E_PIN]) }}
        </div>

        <p class="mt-3 flex items-start gap-1.5 text-xs text-theme-secondarytextcolor">
            <i class="ti ti-shield-lock mt-px text-sm leading-none" aria-hidden="true"></i>
            <span>Your PIN opens the secure token to sign and is never stored. 5 wrong attempts within an hour lock the certificate.</span>
        </p>

        <button type="submit" class="btn btn-primary mt-4 w-full inline-flex items-center justify-center gap-2" data-no-loader>
            <i class="ti ti-signature text-base leading-none" aria-hidden="true"></i>
            Sign document
        </button>
        {{ form_end(form) }}

        {# Signing overlay (S-loader). Shown by signing_form_controller on submit. #}
        <div data-signing-form-target="overlay"
             class="hidden absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-white/85 backdrop-blur-sm text-center">
            {{ include('components/s_loader.html.twig', {size: 64, class: 'text-primary-500'}) }}
            <div>
                <p class="text-sm font-bold text-theme-headings">Signing your document…</p>
                <p class="text-xs text-theme-secondarytextcolor">Applying the qualified signature and timestamp. This can take a moment.</p>
            </div>
        </div>
    </div>
{% else %}
    <div class="text-center">
        <span class="mx-auto mb-3 inline-flex h-11 w-11 items-center justify-center rounded-full bg-warning-500/10 text-warning-600">
            <i class="ti ti-shield-off text-xl leading-none" aria-hidden="true"></i>
        </span>
        <h2 class="text-base font-bold text-theme-headings">No usable certificate</h2>
        <p class="mx-auto mt-1 max-w-sm text-sm text-theme-secondarytextcolor">You need an active signing certificate before you can sign. Issue one, then come back to this document.</p>
        <a href="{{ path('app_certificate_new') }}" class="btn btn-primary mt-4 inline-flex items-center gap-2">
            <i class="ti ti-certificate text-base leading-none" aria-hidden="true"></i>
            Issue a certificate
        </a>
    </div>
{% endif %}
