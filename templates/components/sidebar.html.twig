{#
    App sidebar - stock Flowbite sidebar. Items come from SidebarMenuProvider
    (src/Core/Navigation/) via the sidebar_menu() Twig function - add/role-gate
    entries there, not here. On mobile it's a Flowbite drawer, toggled by the
    hamburger in the navbar (data-drawer-toggle="app-sidebar").

    Optional context: badges - map of MenuItem.badgeKey → int (live counts).
#}
<aside id="app-sidebar" aria-label="Sidebar"
       class="fixed top-0 left-0 z-40 w-64 h-screen pt-[4.3rem] transition-transform -translate-x-full bg-white border-r border-gray-200 sm:translate-x-0">
    <div class="h-full px-3 py-4 overflow-y-auto flex flex-col">
        <ul class="space-y-2 font-medium">
            {% for item in sidebar_menu() %}
                {% set enabled = item.route is not null %}
                {% set active = enabled and app.current_route == item.route %}
                {% set badge = item.badgeKey ? badges[item.badgeKey]|default(0) : 0 %}
                <li>
                    <a href="{{ enabled ? path(item.route) : '#' }}"
                       {% if active %}aria-current="page"{% endif %}
                       {% if not enabled %}title="Coming soon" aria-disabled="true"{% endif %}
                       class="flex items-center p-2 rounded-lg group
                              {{ active ? 'bg-gray-100 text-primary-700' : 'text-gray-900 hover:bg-gray-100' }}
                              {{ not enabled ? 'opacity-50 cursor-default hover:bg-transparent' }}">
                        <svg class="w-5 h-5 shrink-0 transition duration-75 {{ active ? 'text-primary-700' : 'text-gray-500 group-hover:text-gray-900' }}"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">{{ item.icon|raw }}</svg>
                        <span class="flex-1 ms-3 whitespace-nowrap">{{ item.label }}</span>
                        {% if badge > 0 %}
                            <span class="inline-flex items-center justify-center px-2 ms-3 text-sm font-medium text-red-800 bg-red-100 rounded-full">{{ badge }}</span>
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>

        <div class="pt-4 mt-4 space-y-2 border-t border-gray-200">
            {# Upload - Document module, todo #}
            <button type="button" disabled title="Coming soon"
                    class="w-full inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-primary-700 rounded-lg opacity-60 cursor-default">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 20h14"/></svg>
                Upload document
            </button>
        </div>
    </div>
</aside>
