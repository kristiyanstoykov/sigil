{#
    App sidebar. Items come from SidebarMenuProvider (src/Core/Navigation/) via
    the sidebar_menu() Twig function — add/role-gate entries there, not here.
    Collapse: sidebar_controller.js toggles data-collapsed on the <aside>; all
    show/hide styling is Tailwind group-data-collapsed variants, no custom CSS.

    Optional context: badges — map of MenuItem.badgeKey → int (live counts).
#}
<aside data-sidebar-target="aside"
       class="group sticky top-16 h-[calc(100vh-4rem)] shrink-0 flex flex-col gap-1.5 px-3.5 py-[18px] overflow-y-auto overflow-x-hidden
              w-[236px] data-collapsed:w-[68px] transition-[width] duration-200
              bg-white/75 backdrop-blur-xl backdrop-saturate-150 border-r border-white/70">

    <button type="button" data-action="sidebar#toggle" title="Toggle sidebar"
            class="flex items-center justify-center w-[34px] h-[34px] mb-2 ml-1 border border-line bg-surface rounded-[9px] text-muted cursor-pointer hover:text-primary transition-colors">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg>
    </button>

    {% for item in sidebar_menu() %}
        {% set enabled = item.route is not null %}
        {% set active = enabled and app.current_route == item.route %}
        {% set badge = item.badgeKey ? badges[item.badgeKey]|default(0) : 0 %}
        <a href="{{ enabled ? path(item.route) : '#' }}"
           {% if active %}aria-current="page"{% endif %}
           {% if not enabled %}title="Coming soon" aria-disabled="true"{% endif %}
           class="flex items-center gap-[13px] w-full px-[13px] py-2.5 group-data-collapsed:px-0 group-data-collapsed:justify-center
                  rounded-xl text-sm font-semibold no-underline transition-colors duration-150
                  {{ active
                      ? 'bg-primary/10 text-primary shadow-[inset_3px_0_0_var(--color-primary)]'
                      : 'text-label hover:bg-primary/6 hover:text-primary' }}
                  {{ not enabled ? 'opacity-55 cursor-default hover:bg-transparent hover:text-label' }}">
            <span class="relative inline-flex shrink-0">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">{{ item.icon|raw }}</svg>
                {% if badge > 0 %}
                    <span class="hidden group-data-collapsed:block absolute -top-1 -right-1 w-2 h-2 rounded-full bg-danger ring-2 ring-white/80"></span>
                {% endif %}
            </span>
            <span class="flex-1 group-data-collapsed:hidden">{{ item.label }}</span>
            {% if badge > 0 %}
                <span class="group-data-collapsed:hidden shrink-0 min-w-5 text-center text-[11px] font-bold text-white bg-danger rounded-full px-1.5 py-px">{{ badge }}</span>
            {% endif %}
        </a>
    {% endfor %}

    <div class="h-px bg-body/8 my-3 mx-1.5"></div>

    {# Upload — Document module, todo #}
    <button type="button" disabled title="Coming soon"
            class="btn-primary !w-auto flex items-center justify-center gap-2 !py-[11px] !px-3 !rounded-xl opacity-60 !cursor-default">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 20h14"/></svg>
        <span class="group-data-collapsed:hidden">Upload document</span>
    </button>

    <div class="flex-1"></div>

    <div class="group-data-collapsed:hidden flex items-center gap-2 px-1.5 py-2 text-xs text-[color:var(--sigil-text-disabled)]">
        <span class="inline-flex text-primary">{% include 'components/s_loader.html.twig' with {size: 20} only %}</span>
        Synced just now
    </div>
</aside>
