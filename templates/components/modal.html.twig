{#
    One modal on Able Pro's own .modal markup; behaviors/able_pro.js opens and
    closes it. The button that opens it carries
    data-pc-toggle="modal" data-pc-target="#<id>".

    Params: id, title, optional icon (a ti-* name) + tone
    ('danger'|'warning'|'success'|'primary'|'info'), optional eyebrow (a small
    line above the title), optional open_on_load (open with the page - a
    return to a flow, e.g. after a wrong PIN).

    The caller fills {% block content %} with a .modal-body (and a .modal-footer
    when there are actions). A form wraps both with
    form_start(..., {attr: {class: 'contents'}}), which keeps it out of
    .modal-content's flex column. Errors stay flashes: the redirect closes it.
#}
{% set chip = {
    'danger':  'bg-danger-500/10 text-danger-600',
    'warning': 'bg-warning-500/10 text-warning-600',
    'success': 'bg-success-500/10 text-success-600',
    'primary': 'bg-primary-500/10 text-primary-500',
    'info':    'bg-info-500/10 text-info-600',
}[tone|default('danger')] %}
<div id="{{ id }}" class="modal fade" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="{{ id }}-title" aria-hidden="true"
     {{- open_on_load|default(false) ? ' data-pc-open-on-load' }}>
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header gap-3">
                {% if icon|default(null) %}
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg {{ chip }}">
                        <i class="ti {{ icon }} text-lg leading-none" aria-hidden="true"></i>
                    </span>
                {% endif %}
                <div class="min-w-0 flex-1">
                    {% if eyebrow|default(null) %}
                        <p class="text-[11px] font-semibold uppercase tracking-wider text-theme-secondarytextcolor">{{ eyebrow }}</p>
                    {% endif %}
                    <h5 class="modal-title" id="{{ id }}-title">{{ title }}</h5>
                </div>
                <button type="button" data-pc-modal-dismiss="#{{ id }}" aria-label="Close"
                        class="flex h-7 w-7 shrink-0 items-center justify-center rounded text-lg text-theme-secondarytextcolor hover:bg-danger-500/10 hover:text-danger-500">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
            </div>
            {% block content %}{% endblock %}
        </div>
    </div>
</div>
