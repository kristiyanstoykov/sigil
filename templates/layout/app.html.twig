{% extends 'base.html.twig' %}

{% block body %}
{# First-design shell: fixed full-width top bar (logo + search + user) with a
   sticky frosted sidebar below it. Two controllers on the wrapper:
   - documents-upload: the sidebar Upload button opens the modal in place
   - sidebar: collapse (data-collapsed) + mobile drawer (data-mobile-open) #}
<div data-controller="documents-upload sidebar"
     data-documents-upload-max-value="{{ max_document_size_bytes }}"
     data-documents-upload-open-value="{{ app.request.query.get('upload') ? 'true' : 'false' }}">

    {# ── Fixed top bar (solid white, spans over the sidebar) ─────────────────── #}
    <header class="fixed top-0 left-0 right-0 z-40 h-16 flex items-center justify-between px-4 sm:px-6 bg-white border-b border-gray-200 shadow-sm">

        <div class="flex items-center gap-2">
            <button type="button" data-action="sidebar#toggleMobile" title="Menu"
                    class="md:hidden inline-flex w-9 h-9 items-center justify-center rounded-lg text-gray-500 hover:bg-gray-100">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <a href="{{ path('app_dashboard') }}" class="flex items-center gap-3 no-underline group">
                <img src="{{ asset('images/sigil-blue-900.svg') }}" alt="Sigil" width="44" height="30" class="shrink-0 transition-opacity duration-150 group-hover:opacity-80">
                <span class="flex flex-col leading-none">
                    <span class="text-base font-extrabold tracking-tight text-gray-900">Sigil</span>
                    <span class="text-[9px] tracking-widest uppercase font-medium text-gray-500">Signum Veritatis</span>
                </span>
            </a>
        </div>

        {# People search - route a document straight to a person (todo) #}
        <div class="hidden md:flex items-center gap-2.5 flex-1 max-w-md mx-7 px-3.5 py-2 rounded-[10px] border border-gray-200 bg-gray-50 text-gray-400" title="Coming soon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="8" r="3.4"/><path d="M4 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M17 11h5M19.5 8.5v5"/></svg>
            <span class="text-[13px]">Find a person to send a file to…</span>
        </div>

        <div class="flex items-center gap-3">
            {% block header_right %}{% endblock %}

            <button type="button" title="Notifications - coming soon"
                    class="relative inline-flex w-[38px] h-[38px] items-center justify-center border border-gray-200 bg-white rounded-[10px] text-gray-700 cursor-default">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.5 21a2 2 0 0 1-3 0"/></svg>
            </button>

            <div class="relative" data-controller="dropdown">
                <button type="button" data-action="dropdown#toggle"
                        class="flex items-center gap-2.5 py-1 pl-1 pr-2 border border-gray-200 rounded-full cursor-pointer bg-white">
                    <span class="w-[30px] h-[30px] rounded-full bg-linear-to-br from-primary-500 to-primary-700 text-white text-xs font-bold flex items-center justify-center">
                        {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                    </span>
                    <span class="hidden sm:inline text-[13px] font-semibold text-gray-700">{{ app.user.firstName }} {{ app.user.lastName|first|upper }}.</span>
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 rounded-lg border border-gray-200 shadow-lg py-1.5 bg-white/85 backdrop-blur-md">
                    <div class="px-4 py-2 border-b border-gray-200">
                        <p class="text-[13px] font-semibold text-gray-900 truncate">{{ app.user.fullName }}</p>
                        <p class="text-xs text-gray-500 truncate">{{ app.user.email }}</p>
                    </div>
                    <form method="post" action="{{ path('app_logout') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" data-no-loader
                                class="w-full text-left px-4 py-2 text-[13px] font-medium text-red-600 hover:bg-red-50 transition-colors cursor-pointer">
                            Sign out
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    {# ── Sidebar + content ──────────────────────────────────────────────────── #}
    <div class="flex pt-16 min-h-screen app-bg">
        {{ include('components/sidebar.html.twig', {badges: sidebar_badges|default({})}) }}

        <main class="flex-1 min-w-0 px-4 sm:px-8 py-7 pb-10 {% block main_class %}{% endblock %}">
            {% block content %}{% endblock %}
        </main>
    </div>

    {{ include('documents/_upload_modal.html.twig') }}
</div>
{% endblock %}
