{% extends 'base.html.twig' %}

{% block body %}

{# ── Top navbar (stock Flowbite fixed navbar) ────────────────────────────── #}
<nav class="fixed top-0 z-50 w-full bg-white border-b border-gray-200">
    <div class="px-3 py-3 lg:px-5 lg:pl-3">
        <div class="flex items-center justify-between">
            <div class="flex items-center justify-start rtl:justify-end">
                <button data-drawer-target="app-sidebar" data-drawer-toggle="app-sidebar" aria-controls="app-sidebar" type="button"
                        class="inline-flex items-center p-2 text-sm text-gray-500 rounded-lg sm:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200">
                    <span class="sr-only">Open sidebar</span>
                    <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20"><path clip-rule="evenodd" fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"/></svg>
                </button>
                <a href="{{ path('app_dashboard') }}" class="flex items-center ms-2 md:me-24">
                    <img src="{{ asset('images/sigil-blue-900.svg') }}" alt="Sigil" width="44" height="30" class="me-3">
                    <span class="self-center text-xl font-semibold whitespace-nowrap">Sigil</span>
                </a>
            </div>
            <div class="flex items-center gap-2">
                {% block header_right %}{% endblock %}

                <button type="button" title="Notifications - coming soon"
                        class="p-2 text-gray-500 rounded-lg hover:text-gray-900 hover:bg-gray-100 cursor-default">
                    <span class="sr-only">Notifications</span>
                    <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 14 20"><path d="M12.133 10.632v-1.8A5.406 5.406 0 0 0 7.979 3.57.946.946 0 0 0 8 3.464V1.1a1 1 0 0 0-2 0v2.364a.946.946 0 0 0 .021.106 5.406 5.406 0 0 0-4.154 5.262v1.8C1.867 13.018 0 13.614 0 14.807 0 15.4 0 16 .538 16h12.924C14 16 14 15.4 14 14.807c0-1.193-1.867-1.789-1.867-4.175ZM3.823 17a3.453 3.453 0 0 0 6.354 0H3.823Z"/></svg>
                </button>

                <button type="button" data-dropdown-toggle="user-menu"
                        class="flex items-center text-sm rounded-full focus:ring-4 focus:ring-gray-300">
                    <span class="sr-only">Open user menu</span>
                    <span class="w-8 h-8 rounded-full bg-primary-700 text-white text-xs font-semibold flex items-center justify-center">
                        {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                    </span>
                </button>
                <div id="user-menu" class="z-50 hidden my-4 text-base list-none bg-white divide-y divide-gray-100 rounded-lg shadow-lg border border-gray-100">
                    <div class="px-4 py-3">
                        <p class="text-sm text-gray-900">{{ app.user.fullName }}</p>
                        <p class="text-sm font-medium text-gray-500 truncate">{{ app.user.email }}</p>
                    </div>
                    <ul class="py-1">
                        <li>
                            <form method="post" action="{{ path('app_logout') }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                <button type="submit" data-no-loader
                                        class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 cursor-pointer">
                                    Sign out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</nav>

{{ include('components/sidebar.html.twig', {badges: sidebar_badges|default({})}) }}

<main class="p-4 sm:ml-64 pt-20">
    {% block content %}{% endblock %}
</main>

{% endblock %}
