{% extends 'base.html.twig' %}

{% block body %}
{# One documents-upload controller wraps the whole shell so the sidebar's Upload
   button (and the Documents page buttons) can open the modal in place, from any
   page, without navigating away. #}
<div data-controller="documents-upload"
     data-documents-upload-max-value="{{ max_document_size_bytes }}"
     data-documents-upload-open-value="{{ app.request.query.get('upload') ? 'true' : 'false' }}">

{{ include('components/sidebar.html.twig', {badges: sidebar_badges|default({})}) }}

{# ── Header (Able Pro pc-header — frosted by the theme-headerbg token + blur) ── #}
<header class="pc-header">
    <div class="header-wrapper flex max-sm:px-[15px] px-[25px] grow">
        <div class="me-auto pc-mob-drp">
            <ul class="inline-flex *:min-h-header-height *:inline-flex *:items-center">
                {# Desktop collapse lives inside the sidebar (#sidebar-hide in
                   components/sidebar.html.twig); this hamburger is mobile-only. #}
                <li class="pc-h-item pc-sidebar-popup lg:hidden">
                    <a href="#" class="pc-head-link ltr:!ml-0" id="mobile-collapse" aria-label="Open sidebar">
                        <i class="ti ti-menu-2 text-2xl leading-none"></i>
                    </a>
                </li>
            </ul>
        </div>
        <div class="ms-auto">
            <ul class="inline-flex *:min-h-header-height *:inline-flex *:items-center">
                {% block header_right %}{% endblock %}

                <li class="pc-h-item">
                    <span class="pc-head-link me-2 cursor-default" title="Notifications - coming soon">
                        <i class="ti ti-bell"></i>
                    </span>
                </li>

                <li class="dropdown pc-h-item">
                    <a class="pc-head-link dropdown-toggle me-0" data-pc-toggle="dropdown" href="#"
                       role="button" aria-haspopup="true" aria-expanded="false">
                        <span class="sr-only">Open user menu</span>
                        <span class="w-9 h-9 rounded-full bg-primary-500 text-white text-xs font-semibold inline-flex items-center justify-center">
                            {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                        </span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end pc-h-dropdown">
                        <div class="px-3 py-2 border-b border-theme-border mb-1">
                            <p class="text-sm font-medium text-theme-headings mb-0">{{ app.user.fullName }}</p>
                            <p class="text-sm text-theme-secondarytextcolor truncate mb-0">{{ app.user.email }}</p>
                        </div>
                        <form method="post" action="{{ path('app_logout') }}">
                            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                            <button type="submit" data-no-loader class="dropdown-item w-full text-left">
                                <i class="ti ti-power"></i>
                                <span>Sign out</span>
                            </button>
                        </form>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</header>

{# ── Main content ── #}
<div class="pc-container {% block main_class %}{% endblock %}">
    <div class="pc-content">
        {% block content %}{% endblock %}
    </div>
</div>

{{ include('documents/_upload_modal.html.twig') }}
</div>
{% endblock %}
