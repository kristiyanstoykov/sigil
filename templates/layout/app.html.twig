{% extends 'base.html.twig' %}

{% block body %}
{# ── Fixed header ─────────────────────────────────────────────────────────── #}
<header class="fixed top-0 left-0 right-0 z-40 h-16 flex items-center px-6 border-b"
        style="background-color: var(--sigil-surface); border-color: var(--sigil-border);">

    {# Logo + name #}
    <a href="{{ path('app_dashboard') }}"
       class="flex items-center gap-3 no-underline group"
       style="text-decoration: none;">

        <img src="{{ asset('images/sigil-blue-900.svg') }}"
             alt="Sigil" width="52" height="36"
             class="shrink-0 transition-opacity duration-150 group-hover:opacity-80">

        {# App name #}
        <div class="flex flex-col leading-none">
            <span class="text-sm font-bold tracking-tight" style="color: var(--sigil-text);">Sigil</span>
            <span class="text-[10px] tracking-widest uppercase font-medium" style="color: var(--sigil-text-secondary);">Signum Veritatis</span>
        </div>

    </a>

    {% block header_right %}{% endblock %}

</header>

{# ── Page content (offset for fixed header) ──────────────────────────────── #}
<main class="pt-16 min-h-screen" style="background-color: var(--sigil-bg);">
    {% block content %}{% endblock %}
</main>
{% endblock %}
