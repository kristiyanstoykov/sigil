{% extends 'auth/base_auth.html.twig' %}

{% block title %}Account deleted - Sigil{% endblock %}

{% block card %}
    <h1 class="text-lg font-bold text-theme-headings mb-1">Your account has been deleted</h1>
    <p class="mb-4 text-sm text-theme-secondarytextcolor">
        You have been signed out.
        {% if confirmation.documentsRetained %}
            {{ confirmation.documentsRetained }} {{ confirmation.documentsRetained == 1 ? 'document is' : 'documents are' }} kept, encrypted, until {{ confirmation.retainUntil|date('j M Y') }}.
        {% endif %}
        To get {{ confirmation.documentsRetained ? 'them' : 'your account' }} back, register again with the same address and enter this recovery code:
    </p>

    <p class="mb-4 rounded-lg border border-theme-border bg-white/70 px-4 py-3 text-center font-mono text-lg font-bold tracking-wider text-theme-headings select-all" data-recovery-code>{{ confirmation.recoveryCode }}</p>

    <div class="alert alert-warning !mb-0 flex items-start gap-2 text-sm">
        <i class="ti ti-alert-triangle mt-0.5 text-base leading-none" aria-hidden="true"></i>
        <span>Write it down or keep the email we sent. This page shows it <strong>once</strong>, and Sigil keeps only a fingerprint of it.</span>
    </div>
{% endblock %}

{% block footer %}
    <p class="mt-4 text-center text-sm text-theme-secondarytextcolor"><a href="{{ path('app_login') }}" class="text-primary-500 hover:underline">Back to sign in</a></p>
{% endblock %}
