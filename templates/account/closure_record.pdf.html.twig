{# The account closure record PDF (ADR-015 §3). Rendered by mPDF, like the
   delivery receipt: plain print CSS, no external assets. It never carries the
   recovery code. #}
<html>
<head>
    <meta charset="utf-8">
    <style>
        @page { footer: html_footer; }
        body { font-family: dejavusans, sans-serif; font-size: 8.5pt; color: #111827; line-height: 1.45; }
        h1 { font-size: 16pt; margin: 0 0 2pt; color: #1E3A8A; letter-spacing: .5pt; }
        h2 { font-size: 9.5pt; margin: 14pt 0 4pt; color: #1E3A8A; text-transform: uppercase; letter-spacing: .6pt; }
        .brand { font-size: 8pt; color: #6B7280; margin: 0 0 10pt; }
        .rule { border-bottom: 1.2pt solid #1E3A8A; margin-bottom: 10pt; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; vertical-align: top; padding: 3.5pt 4pt; }
        thead th { background: #EEF2FF; color: #1E3A8A; font-size: 7.5pt; text-transform: uppercase; letter-spacing: .4pt; border-bottom: .6pt solid #C7D2FE; }
        tbody tr { border-bottom: .4pt solid #E5E7EB; }
        .meta td { padding: 2.5pt 4pt; border: none; }
        .meta td.k { width: 30%; color: #6B7280; }
        .hash { font-family: dejavusansmono, monospace; font-size: 6.8pt; word-break: break-all; color: #374151; }
        .muted { color: #9CA3AF; }
        .note { margin-top: 14pt; padding: 7pt 9pt; background: #F9FAFB; border-left: 2pt solid #1E3A8A; font-size: 7.6pt; color: #4B5563; }
        .foot { font-size: 7pt; color: #9CA3AF; border-top: .4pt solid #E5E7EB; padding-top: 3pt; }
    </style>
</head>
<body>

{% set outcomes = {cancelled: 'Withdrawn - you had started it', signer_deleted: "Closed - a signer's account was deleted"} %}

<h1>Account closure record</h1>
<p class="brand">Sigil &mdash; Signum Veritatis &middot; issued {{ sealedAt|date('d.m.Y H:i:s e') }} &middot; all times in this record are UTC</p>
<div class="rule"></div>

<table class="meta">
    <tr><td class="k">Account</td><td class="hash">{{ summary.userId }}</td></tr>
    <tr><td class="k">Holder</td><td>{{ name }} &lt;{{ email }}&gt;</td></tr>
    <tr><td class="k">Deleted</td><td>{{ summary.deletedAt|date('d.m.Y H:i:s') }}</td></tr>
    <tr><td class="k">Documents retained until</td><td>{{ summary.retainUntil|date('d.m.Y H:i:s') }}</td></tr>
    <tr><td class="k">Unshared drafts erased</td><td>{{ summary.draftsErased }}</td></tr>
    <tr><td class="k">Documents retained</td><td>{{ summary.documentsRetained }}</td></tr>
</table>

<h2>Signature requests closed</h2>
<table>
    <thead><tr><th style="width:55%">Request</th><th style="width:45%">How it closed</th></tr></thead>
    <tbody>
    {% for id, status in summary.closedRequests %}
        <tr><td class="hash">{{ id }}</td><td>{{ outcomes[status] ?? status }}</td></tr>
    {% else %}
        <tr><td colspan="2" class="muted">None were open.</td></tr>
    {% endfor %}
    </tbody>
</table>

<h2>Certificates revoked</h2>
<table>
    <thead><tr><th style="width:55%">Serial number</th><th style="width:45%">Reason</th></tr></thead>
    <tbody>
    {% for serial in summary.revokedSerials %}
        <tr><td class="hash">{{ serial }}</td><td>cessationOfOperation (RFC 5280 &sect;5.3.1)</td></tr>
    {% else %}
        <tr><td colspan="2" class="muted">No certificate was in force.</td></tr>
    {% endfor %}
    </tbody>
</table>

<div class="note">
    <strong>What this record means.</strong><br>
    This document carries a PAdES signature applied with Sigil's seal, an electronic
    seal in the sense of Regulation (EU) 910/2014 Art. 35-40: it attests that Sigil
    closed the account above as listed, and is not a signature by its holder.<br><br>
    Certificates were revoked for cessation of operation, not for key compromise, so
    every signature made with them before the deletion stays valid. Documents that
    carry a signature, or that other people hold, are kept encrypted until the date
    above and can be recovered by registering again with the same address and the
    recovery code Sigil sent separately. This record does not contain that code.
    After that date they are erased for good.
</div>

<htmlpagefooter name="footer">
    <div class="foot">
        Sigil &mdash; Signum Veritatis &middot; account closure {{ summary.userId }} &middot; page {PAGENO} of {nbpg}
    </div>
</htmlpagefooter>

</body>
</html>
