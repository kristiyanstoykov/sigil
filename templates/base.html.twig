<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Sigil{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
    <link rel="icon" type="image/png" sizes="512x512" href="{{ asset('images/favicon-512.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/favicon-512.png') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="min-h-screen bg-gray-50">

{# Top-center toast stack: one fixed container so multiple flashes don't overlap #}
<div class="fixed top-20 inset-x-0 z-[60] flex flex-col items-center gap-2 px-4 pointer-events-none">
    {% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
        {% for message in messages %}
            {% set flash_id = 'flash-' ~ type ~ '-' ~ loop.index %}
            <div id="{{ flash_id }}" role="alert" class="flex w-full max-w-md items-start gap-3 p-4 text-sm rounded-lg border shadow-sm pointer-events-auto
                       {{ type == 'success' ? 'text-green-800 bg-green-50 border-green-200'
                       : type == 'danger' ? 'text-red-800 bg-red-50 border-red-200'
                       : type == 'warning' ? 'text-yellow-800 bg-yellow-50 border-yellow-200'
                       : 'text-blue-800 bg-blue-50 border-blue-200' }}">
                <span class="flex-1 text-left">{{ message }}</span>
                <button type="button" data-dismiss-target="#{{ flash_id }}" aria-label="Close"
                        class="-my-1 -me-1 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md hover:bg-black/5 focus:outline-none focus:ring-2 focus:ring-black/10">
                    <span class="sr-only">Dismiss</span>
                    <svg class="w-3.5 h-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m1 1 12 12M13 1 1 13"/></svg>
                </button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{% block body %}{% endblock %}

</body>
</html>
