<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Sigil{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
    <link rel="icon" type="image/png" sizes="512x512" href="{{ asset('images/favicon-512.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/favicon-512.png') }}">
    {# Able Pro theme (vendored, precompiled) + Tabler icon font. Must come
       before the importmap: app.css (linked by the importmap via app.js) is
       the utilities build that wins on conflicts. #}
    {# simple-datatables' own base stylesheet - layout only (the pager list,
       the top/bottom bars). Able Pro ships it as a separate plugin file and
       loads it FIRST, then re-colours it from style.css; that file's datatable
       rules live in @layer utilities and use !important exactly so they beat
       this unlayered one. Keep this order. #}
    <link rel="stylesheet" href="{{ asset('able-pro/css/plugins/simple-datatables.css') }}">
    {# dragula's own stylesheet, same plugin split: it defines the drag mirror and
       the gu-* state classes that the signer-order list relies on. #}
    <link rel="stylesheet" href="{{ asset('able-pro/css/plugins/dragula.min.css') }}">
    <link rel="stylesheet" href="{{ asset('able-pro/css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('able-pro/fonts/tabler-icons.css') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="font-sans text-theme-bodycolor {% block body_class %}bg-theme-bodybg{% endblock %}">

{# Top-center toast stack: one fixed container so multiple flashes don't overlap.
   Able Pro alert component + a frosted-glass finish (glass on toasts per the
   design brief). Dismiss is handled by the delegated [data-pc-dismiss="alert"]
   listener in assets/behaviors/able_pro.js; data-flash-stack additionally marks
   these as transient, so assets/behaviors/flash.js times them out - inline
   alerts elsewhere in the app carry no such marker and stay put. #}
<div data-flash-stack class="fixed top-20 inset-x-0 z-[1050] flex flex-col items-center gap-2 px-4 pointer-events-none">
    {% for type, messages in app.flashes(['success', 'danger', 'warning', 'info']) %}
        {% for message in messages %}
            {# No .alert-dismissible: it reserves right padding for an absolutely
               positioned close button - plain flex keeps icon/text/X on one line. #}
            <div role="alert" class="alert alert-{{ type }} w-full max-w-md !mb-0 flex items-center gap-3 text-sm shadow-lg backdrop-blur-md pointer-events-auto">
                <i aria-hidden="true" class="ti shrink-0 text-base leading-none
                    {{ type == 'success' ? 'ti-circle-check'
                     : type == 'danger' ? 'ti-alert-circle'
                     : type == 'warning' ? 'ti-alert-triangle'
                     : 'ti-info-circle' }}"></i>
                <span class="flex-1 text-left">{{ message }}</span>
                <button type="button" data-pc-dismiss="alert" aria-label="Close"
                        class="-me-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md hover:bg-black/5 cursor-pointer">
                    <span class="sr-only">Dismiss</span>
                    <i class="ti ti-x text-sm leading-none" aria-hidden="true"></i>
                </button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{% block body %}{% endblock %}

</body>
</html>
