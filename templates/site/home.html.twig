{% extends 'site/base_site.html.twig' %}

{% block title %}Sigil · Signatures that hold up{% endblock %}

{% macro eyebrow(text, tone = 'text-primary-500') %}
    <span class="font-mono text-xs uppercase tracking-[0.1em] {{ tone }}">{{ text }}</span>
{% endmacro %}

{% macro label(text) %}
    <span class="font-mono text-[11px] uppercase tracking-[0.06em] text-theme-secondarytextcolor">{{ text }}</span>
{% endmacro %}

{# One step of the "life of a document" timeline; illustrative times, the order is the point. #}
{% macro step(n, time, action, title, facts, last = false) %}
    <li class="flex gap-5">
        <div class="flex shrink-0 flex-col items-center">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold text-white {{ last ? 'bg-success-500' : 'bg-primary-500' }}">{{ n }}</span>
            {% if not last %}<span class="min-h-5 w-0.5 grow bg-theme-border" aria-hidden="true"></span>{% endif %}
        </div>
        <div class="flex min-w-0 grow flex-col gap-2.5 rounded-xl border border-theme-border bg-white px-5 py-5 {{ last ? '' : 'mb-4' }}">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <span class="font-mono text-xs text-theme-secondarytextcolor">{{ time }}</span>
                <span class="rounded-md px-2 py-0.5 font-mono text-[11px] break-all {{ last ? 'bg-success-500/10 text-success-600' : 'bg-primary-500/10 text-primary-500' }}">{{ action }}</span>
            </div>
            <h3 class="mb-0 text-lg font-semibold">{{ title }}</h3>
            <ul class="mb-0 list-disc ps-[18px] text-sm leading-[1.7] text-theme-secondarytextcolor">
                {% for fact in facts %}<li>{{ fact }}</li>{% endfor %}
            </ul>
        </div>
    </li>
{% endmacro %}

{% block site_content %}
{% import _self as ui %}

{# ── Hero ─────────────────────────────────────────────────────────────── #}
<section class="site-dots px-4 pt-16 pb-20 sm:px-6 sm:pt-[72px] sm:pb-[88px]">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center gap-14">
        <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-6">
            <span class="inline-flex self-start items-center gap-2 rounded-full border border-primary-500/20 bg-primary-500/[0.08] px-3 py-1.5 text-[13px] font-semibold text-primary-500">
                <span class="h-1.5 w-1.5 rounded-full bg-primary-500"></span>PAdES-B-T signatures &middot; post-quantum ready
            </span>
            <h1 class="mb-0 text-[38px] md:text-[48px] lg:text-[58px] leading-[1.06] font-bold tracking-[-0.025em] text-theme-headings">
                Signatures that hold up.<br><span class="text-primary-500">Documents that stay private.</span>
            </h1>
            <p class="mb-0 max-w-[540px] text-lg leading-relaxed text-theme-secondarytextcolor">
                Sigil signs your PDFs with a key that never leaves its PKCS#11 token, encrypts every file before it is stored,
                and seals a delivery receipt when the last signer is done.
            </p>
            <div class="flex flex-wrap items-center gap-3">
                {% if app.user %}
                    <a href="{{ path('app_dashboard') }}" class="btn btn-primary btn-lg">Open dashboard <i class="ti ti-arrow-right ms-1"></i></a>
                {% else %}
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-lg">Create account <i class="ti ti-arrow-right ms-1"></i></a>
                    <a href="{{ path('app_login') }}" class="btn btn-outline-secondary btn-lg bg-white">Sign in</a>
                    <span class="ms-1 inline-flex items-center gap-1.5 text-[13px] text-theme-secondarytextcolor"><i class="ti ti-lock" aria-hidden="true"></i>Registration is by invitation.</span>
                {% endif %}
            </div>
            <ul class="mb-0 mt-2 flex flex-wrap gap-x-6 gap-y-2.5 border-t border-theme-border pt-2">
                {% for point in ['Validates in Adobe Reader', 'Nothing stored in the clear', 'Hash-chained audit log'] %}
                    <li class="inline-flex items-center gap-2 pt-3 text-sm text-theme-headings"><i class="ti ti-check text-success-600" aria-hidden="true"></i>{{ point }}</li>
                {% endfor %}
            </ul>
        </div>

        {# A signed document and its signing flow; illustrative, not a real record. #}
        <div class="min-w-0 flex-[1_1_460px]" aria-hidden="true">
            <div class="overflow-hidden rounded-2xl border border-theme-border bg-white shadow-[0_30px_60px_-30px_rgba(15,30,61,0.28)]">
                <div class="flex items-center gap-3.5 border-b border-theme-border/60 px-6 py-5">
                    <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-primary-500/[0.08] text-primary-500 text-[22px]"><i class="ti ti-file-text"></i></span>
                    <div class="flex min-w-0 grow flex-col gap-0.5">
                        <span class="truncate font-semibold text-theme-headings">Service agreement.pdf</span>
                        <span class="font-mono text-xs text-theme-secondarytextcolor">Version 3 &middot; 2 signatures</span>
                    </div>
                    <span class="badge rounded-full bg-success-500/10 text-success-600"><i class="ti ti-check me-1"></i>Signed</span>
                </div>

                <div class="px-6 py-2">
                    {% for signer in [
                        {initials: 'AP', name: 'A. Petrova', suite: 'ECDSA P-384', time: '14:32:07 UTC', pq: false},
                        {initials: 'GD', name: 'G. Dimitrov', suite: 'ML-DSA-65', time: '16:05:41 UTC', pq: true},
                    ] %}
                        <div class="flex items-center gap-3 py-3 {{ loop.last ? '' : 'border-b border-dashed border-theme-border' }}">
                            <span class="inline-flex h-[34px] w-[34px] shrink-0 items-center justify-center rounded-full bg-theme-bodybg text-xs font-semibold text-theme-headings">{{ signer.initials }}</span>
                            <span class="grow text-sm font-semibold">{{ signer.name }}</span>
                            <span class="rounded-md border px-2 py-0.5 font-mono text-[11px] {{ signer.pq ? 'border-primary-500/20 bg-primary-500/[0.08] text-primary-500' : 'border-theme-border bg-theme-bodybg text-theme-headings' }}">{{ signer.suite }}</span>
                            <span class="hidden sm:inline min-w-[104px] text-right font-mono text-xs text-theme-secondarytextcolor">{{ signer.time }}</span>
                        </div>
                    {% endfor %}
                </div>

                <div class="grid grid-cols-[repeat(2,minmax(0,1fr))] gap-px border-t border-theme-border/60 bg-theme-border/60">
                    {% for fact in [
                        ['Fingerprint', 'HMAC-SHA384'],
                        ['Signature', 'PAdES-B-T'],
                        ['Encrypted at rest', 'AES-256-GCM'],
                        ['Audit chain', 'Every step hashed'],
                    ] %}
                        <div class="flex flex-col gap-1 bg-theme-bodybg/50 px-6 py-3.5">
                            {{ ui.label(fact[0]) }}
                            <span class="text-[13px] font-semibold">{{ fact[1] }}</span>
                        </div>
                    {% endfor %}
                </div>

                <div class="flex flex-col gap-3.5 border-t border-theme-border/60 px-6 pt-5 pb-[22px]">
                    {{ ui.label('Signing flow') }}
                    <div class="flex flex-wrap gap-y-2">
                        {% for stage in [
                            ['Uploaded', 'encrypted'],
                            ['Petrova signed', '14:32:07'],
                            ['Dimitrov signed', '16:05:41'],
                        ] %}
                            <div class="flex min-w-24 flex-[1_1_0] flex-col gap-2">
                                <div class="flex items-center">
                                    <span class="inline-flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-full bg-primary-500 text-xs text-white"><i class="ti ti-check"></i></span>
                                    <span class="h-0.5 grow bg-primary-500"></span>
                                </div>
                                <span class="text-[13px] font-semibold">{{ stage[0] }}</span>
                                <span class="font-mono text-[11px] text-theme-secondarytextcolor">{{ stage[1] }}</span>
                            </div>
                        {% endfor %}
                        <div class="flex min-w-24 flex-[0_1_auto] flex-col gap-2">
                            <span class="inline-flex h-[22px] w-[22px] items-center justify-center rounded-full bg-success-500 text-xs text-white"><i class="ti ti-shield"></i></span>
                            <span class="text-[13px] font-semibold">Receipt sealed</span>
                            <span class="font-mono text-[11px] text-theme-secondarytextcolor">receipt.sealed</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ── Standards strip ──────────────────────────────────────────────────── #}
<section class="border-y border-theme-border bg-white px-4 py-[22px] sm:px-6">
    <ul class="mx-auto mb-0 flex max-w-[1200px] flex-wrap items-center justify-center gap-x-3 gap-y-2.5">
        <li class="me-2 text-[13px] text-theme-secondarytextcolor">Built on open standards</li>
        {% for standard in ['PAdES-B-T', 'RFC 3161 timestamps', 'PKCS#11 key custody', 'ECDSA P-384', 'ML-DSA-65', 'AES-256-GCM'] %}
            <li class="rounded-lg border border-theme-border bg-theme-bodybg px-3 py-1.5 font-mono text-[13px] text-theme-headings">{{ standard }}</li>
        {% endfor %}
    </ul>
</section>

{# ── How it works ─────────────────────────────────────────────────────── #}
<section id="how-it-works" class="scroll-mt-20 bg-theme-bodybg px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-12">
        <div class="flex max-w-[680px] flex-col gap-3.5">
            {{ ui.eyebrow('How it works') }}
            <h2 class="mb-0 text-[30px] lg:text-[40px] leading-[1.15] font-bold tracking-[-0.02em]">The life of a signed document</h2>
            <p class="mb-0 text-[17px] leading-relaxed text-theme-secondarytextcolor">Follow one file from upload to receipt. At no point along the way is it stored in the clear.</p>
        </div>

        <div class="flex flex-wrap items-start gap-10">
            {# Envelope encryption: each key wraps the one below it. #}
            <div class="flex min-w-0 flex-[1_1_320px] flex-col gap-1.5 rounded-2xl border border-theme-border bg-white p-7">
                {{ ui.label('Envelope encryption') }}
                <span class="mb-3.5 text-lg font-semibold">Who holds which key</span>
                {% for layer in [
                    {icon: 'ti-server', name: 'Root key', detail: 'inside the PKCS#11 token', box: 'bg-primary-900 text-white', chip: 'bg-white/10', sub: 'text-white/65', arrow: 'wraps'},
                    {icon: 'ti-key', name: 'Your key', detail: 'KEK · one per person', box: 'bg-primary-500 text-white', chip: 'bg-white/15', sub: 'text-white/75', arrow: 'wraps'},
                    {icon: 'ti-key', name: 'File key', detail: 'DEK · one per version', box: 'border border-primary-500/20 bg-primary-500/[0.08]', chip: 'bg-white text-primary-500', sub: 'text-theme-secondarytextcolor', arrow: 'encrypts · AES-256-GCM'},
                    {icon: 'ti-file-text', name: 'Your document', detail: 'stored as ciphertext only', box: 'border border-theme-border bg-white', chip: 'bg-theme-bodybg text-theme-headings', sub: 'text-theme-secondarytextcolor', arrow: null},
                ] %}
                    <div class="flex items-center gap-3.5 rounded-xl px-4 py-3.5 {{ layer.box }}">
                        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[9px] text-lg {{ layer.chip }}"><i class="ti {{ layer.icon }}" aria-hidden="true"></i></span>
                        <span class="flex flex-col gap-0.5">
                            <span class="text-sm font-semibold">{{ layer.name }}</span>
                            <span class="font-mono text-[11px] {{ layer.sub }}">{{ layer.detail }}</span>
                        </span>
                    </div>
                    {% if layer.arrow %}
                        <div class="flex items-center gap-2 py-1 ps-[30px] text-theme-secondarytextcolor">
                            <i class="ti ti-arrow-down" aria-hidden="true"></i><span class="font-mono text-[11px]">{{ layer.arrow }}</span>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>

            <ol class="mb-0 flex min-w-0 flex-[2_1_560px] flex-col">
                {{ ui.step(1, '09:14:02 UTC', 'document.uploaded', 'Uploaded and encrypted', [
                    'A fresh AES-256-GCM key is made for this version',
                    'A keyed SHA-384 fingerprint identifies the file',
                    'Only ciphertext is written to storage',
                ]) }}
                {{ ui.step(2, 'same second', 'envelope encryption', 'The key is locked away', [
                    'The file key is wrapped by your personal KEK',
                    'Your KEK is wrapped by the root key',
                    'The root key sits in a PKCS#11 token and never leaves it',
                ]) }}
                {{ ui.step(3, '09:20:45 UTC', 'signing_request.created', 'Signers are asked, in order', [
                    'Signers get access one at a time, in the order you set',
                    'The file key is re-wrapped for the first signer only',
                    'Nobody further down the list can open it yet',
                ]) }}
                {{ ui.step(4, '11:02:17 UTC', 'document.signed', 'Signed inside the token', [
                    'The signer\'s PIN is used once and never kept',
                    'The signature is made inside their own token',
                    'An RFC 3161 timestamp fixes when it happened',
                ]) }}
                {{ ui.step(5, '11:02:18 UTC', 'signing_request.turn_advanced', 'The turn passes on', [
                    'The next signer gets the newly signed version only',
                    'A signer can decline with a reason, closing the request',
                    'A deadline can close it too',
                ]) }}
                {{ ui.step(6, '15:47:09 UTC', 'receipt.sealed', 'A sealed receipt', [
                    'A PAdES receipt records who it reached, who signed and when',
                    'It is sealed with Sigil\'s own electronic seal',
                    'Every step is linked into a hash-chained audit log',
                ], true) }}
            </ol>
        </div>
    </div>
</section>

{# ── Encryption ───────────────────────────────────────────────────────── #}
<section id="security" class="scroll-mt-20 bg-white px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-11">
        <div class="flex max-w-[680px] flex-col gap-3.5">
            {{ ui.eyebrow('Encryption') }}
            <h2 class="mb-0 text-[30px] lg:text-[40px] leading-[1.15] font-bold tracking-[-0.02em]">Three keys deep, so no single leak opens a file</h2>
            <p class="mb-0 text-[17px] leading-relaxed text-theme-secondarytextcolor">Files, file keys and the root key live in different places. Getting hold of any one of them is not enough to read a document.</p>
        </div>
        <div class="flex flex-wrap gap-6">
            {% for card in [
                {icon: 'ti-stack-2', title: 'A key for every version', body: 'Each version of a document gets its own data key. One exposed key opens one version and nothing else.'},
                {icon: 'ti-refresh', title: 'Access is a re-wrap, not a copy', body: 'Giving someone access wraps the file key again under their key. The encrypted file itself is never copied.'},
                {icon: 'ti-atom', title: 'Quantum-resistant at rest', body: 'AES-256 keeps its safety margin against quantum attacks, so stored files stay protected long after they are signed.'},
            ] %}
                <div class="flex min-w-0 flex-[1_1_300px] flex-col gap-3.5 rounded-xl border border-theme-border bg-theme-bodybg p-7">
                    <span class="inline-flex h-11 w-11 items-center justify-center rounded-[10px] bg-primary-500/[0.08] text-[22px] text-primary-500"><i class="ti {{ card.icon }}" aria-hidden="true"></i></span>
                    <h3 class="mb-0 text-lg font-semibold">{{ card.title }}</h3>
                    <p class="mb-0 text-[15px] leading-relaxed text-theme-secondarytextcolor">{{ card.body }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ── Signing ──────────────────────────────────────────────────────────── #}
<section class="border-t border-theme-border bg-theme-bodybg px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center gap-14">
        <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-[18px]">
            {{ ui.eyebrow('Signing') }}
            <h2 class="mb-0 text-[30px] lg:text-[40px] leading-[1.15] font-bold tracking-[-0.02em]">A signature that stands on its own</h2>
            <p class="mb-0 text-[17px] leading-relaxed text-theme-secondarytextcolor">Signed files validate in Adobe Reader or any PAdES validator. Nobody needs a Sigil account to check them.</p>
            {# What a validator shows; illustrative. #}
            <div class="mt-2 flex items-start gap-3.5 rounded-xl border border-theme-border bg-white px-5 py-[18px]" aria-hidden="true">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-success-500/10 text-lg text-success-600"><i class="ti ti-check"></i></span>
                <div class="flex min-w-0 flex-col gap-1">
                    <span class="text-[15px] font-semibold">Signature is valid</span>
                    <span class="text-[13px] text-theme-secondarytextcolor">Signed by G. Dimitrov &middot; document not modified since signing</span>
                    <span class="font-mono text-xs text-theme-secondarytextcolor">ML-DSA-65 &middot; RFC 3161 timestamp &middot; PAdES-B-T</span>
                </div>
            </div>
        </div>
        <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-4">
            {% for card in [
                {icon: 'ti-server', title: 'Keys stay in the token', body: 'The private key is created inside the signer\'s PKCS#11 token. Sigil can ask it to sign; it can never read it.'},
                {icon: 'ti-eye-off', title: 'Your PIN is never kept', body: 'The PIN unlocks the token for one signature and is then discarded. It is not stored or logged.'},
                {icon: 'ti-clock', title: 'Independent timestamps', body: 'An RFC 3161 timestamp from an outside authority proves when the document was signed.'},
            ] %}
                <div class="flex items-start gap-[18px] rounded-xl border border-theme-border bg-white px-6 py-[22px]">
                    <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-[10px] bg-primary-500/[0.08] text-[22px] text-primary-500"><i class="ti {{ card.icon }}" aria-hidden="true"></i></span>
                    <div class="flex flex-col gap-1.5">
                        <h3 class="mb-0 text-[17px] font-semibold">{{ card.title }}</h3>
                        <p class="mb-0 text-[15px] leading-relaxed text-theme-secondarytextcolor">{{ card.body }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>

{# ── Key custody (dark) ───────────────────────────────────────────────── #}
<section id="keys" class="scroll-mt-20 bg-primary-900 px-4 py-16 text-white sm:px-6 sm:py-24">
    <div class="mx-auto flex max-w-[1200px] flex-col gap-11">
        <div class="flex max-w-[700px] flex-col gap-3.5">
            {{ ui.eyebrow('Key custody', 'text-primary-300') }}
            <h2 class="mb-0 text-[30px] lg:text-[40px] leading-[1.15] font-bold tracking-[-0.02em] !text-white">Signing keys kept the way an HSM keeps them</h2>
            <p class="mb-0 text-[17px] leading-relaxed text-white/65">Every key lives in a PKCS#11 token. The application can ask for a signature; it can never take a key out.</p>
        </div>
        <div class="flex flex-wrap items-stretch gap-8">
            <div class="grid min-w-0 flex-[3_1_520px] grid-cols-1 gap-4 sm:grid-cols-[repeat(2,minmax(0,1fr))]">
                {% for card in [
                    {icon: 'ti-lock', title: 'Born inside, never exported', body: 'Keys are generated inside the token and marked non-extractable.'},
                    {icon: 'ti-user', title: 'One token per person', body: 'Every user has a token of their own, so one person\'s PIN unlocks only their key.'},
                    {icon: 'ti-alert-triangle', title: 'Guarded against guessing', body: 'Five wrong PINs in an hour lock signing. PINs are checked against an Argon2id hash.'},
                    {icon: 'ti-layout-grid', title: 'Separated by duty', body: 'Signing, wrapping, certifying and sealing each use a different key.'},
                ] %}
                    <div class="flex flex-col gap-3 rounded-xl border border-white/10 bg-white/5 p-6">
                        <i class="ti {{ card.icon }} text-[22px] text-primary-300" aria-hidden="true"></i>
                        <h3 class="mb-0 text-[17px] font-semibold !text-white">{{ card.title }}</h3>
                        <p class="mb-0 text-sm leading-relaxed text-white/65">{{ card.body }}</p>
                    </div>
                {% endfor %}
            </div>

            {# The token layout as a vault: one row per key. #}
            <div class="flex min-w-0 flex-[2_1_360px] flex-col overflow-hidden rounded-2xl border border-white/10 bg-primary-950" aria-hidden="true">
                <div class="flex flex-wrap items-center justify-between gap-2.5 border-b border-white/10 px-[22px] py-[18px]">
                    <span class="font-mono text-[13px] text-white/90">Key vault &middot; PKCS#11</span>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-success-500/15 px-2.5 py-1 text-xs font-semibold text-emerald-300"><span class="h-1.5 w-1.5 rounded-full bg-emerald-300"></span>All keys sealed</span>
                </div>
                {% for key in [
                    {icon: 'ti-key', name: 'Your signing key', detail: 'ECDSA P-384 or ML-DSA-65'},
                    {icon: 'ti-server', name: 'Root key', detail: 'AES-256'},
                    {icon: 'ti-shield-check', name: 'Certificate authority', detail: 'issues signer certificates'},
                    {icon: 'ti-award', name: 'Receipt seal', detail: 'Sigil\'s electronic seal'},
                ] %}
                    <div class="flex items-center gap-3.5 px-[22px] py-4 {{ loop.last ? '' : 'border-b border-white/[0.06]' }}">
                        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-[9px] bg-white/5 text-lg text-primary-300"><i class="ti {{ key.icon }}"></i></span>
                        <span class="flex min-w-0 grow flex-col gap-0.5">
                            <span class="text-sm font-semibold">{{ key.name }}</span>
                            <span class="font-mono text-[11px] text-white/65">{{ key.detail }}</span>
                        </span>
                        <span class="hidden sm:inline rounded-md border border-white/10 px-[7px] py-[3px] font-mono text-[10px] text-white/65">non-extractable</span>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

{# ── Call to action ───────────────────────────────────────────────────── #}
<section class="bg-white px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-8 rounded-3xl bg-primary-500 px-6 py-12 sm:p-14">
        <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-3">
            <h2 class="mb-0 text-[28px] lg:text-[38px] leading-[1.15] font-bold tracking-[-0.02em] !text-white">Ready to sign something that holds up?</h2>
            <p class="mb-0 text-white/80">Registration is by invitation.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            {% if app.user %}
                <a href="{{ path('app_dashboard') }}" class="btn btn-lg bg-white text-primary-500 hover:bg-primary-50">Open dashboard <i class="ti ti-arrow-right ms-1"></i></a>
            {% else %}
                <a href="{{ path('app_register') }}" class="btn btn-lg bg-white text-primary-500 hover:bg-primary-50">Create account</a>
                <a href="{{ path('app_login') }}" class="btn btn-lg border border-white/50 text-white hover:bg-white/10">Sign in</a>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
