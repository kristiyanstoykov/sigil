{#
    Where this document stands, and what can still be done to it. One banner
    saying the state in a sentence, the panel that state deserves, then what
    can still be done - an action that can never happen again is dropped from
    that list, and the banner is what explains its absence.

    Context: document, status, isOwner, signingRequest, isTurn.
#}
{% import 'documents/_macros.html.twig' as docs %}
{% import 'signing/_macros.html.twig' as signing %}

{% set signatures = document_signatures(document) %}
{% set deliveries = isOwner ? document_deliveries(document) : [] %}
{% set isRecipient = not isOwner and was_delivered_to_me(document) %}

{# ── the state, in a sentence ───────────────────────────────────────────── #}
{% if isRecipient %}
    {% set banner = {tone: 'success', icon: 'ti-mail-forward',
        title: 'Delivered to you',
        body: 'Registered delivery: it reached you formally, and nothing is asked of you. You cannot decline it and there is nothing to sign. It stays in your library, and the sealed receipt naming you is under Receipts.'} %}
{% elseif isTurn %}
    {% set banner = {tone: 'info', icon: 'ti-signature',
        title: 'It is your turn to sign',
        body: 'The queue reached you, which is the moment you were handed the key to read it. Signing adds a new version and passes the turn on; declining closes the request for everyone.'} %}
{% elseif signingRequest %}
    {% set current = signingRequest.currentSigner %}
    {% set banner = {tone: 'info', icon: 'ti-clock',
        title: 'Out for signature - the queue owns it now',
        body: (isOwner
            ? 'Nobody can jump the queue, and a signer who has not been reached cannot decrypt the file at all. You can withdraw it; you cannot sign it or deliver it while it is open.'
            : 'Someone ahead of you holds the turn. The document stays encrypted to you until the queue reaches you.')} %}
{% elseif status.delivered %}
    {% set banner = {tone: 'success', icon: 'ti-mail-forward',
        title: 'This document is finished',
        body: 'A delivery cannot be taken back, refused or repeated. Nothing further can happen to this file - to serve it on anyone else, upload it again. Everything that can be known about it is now under Versions, History and Receipts.'} %}
{% elseif status.declined %}
    {% set banner = {tone: 'danger', icon: 'ti-ban',
        title: 'A signer refused, and that closed the request',
        body: 'Nobody after them was asked. Signatures already collected are kept as versions, and the refusal is on the record under History.'} %}
{% elseif status.expired %}
    {% set banner = {tone: 'warning', icon: 'ti-alert-triangle',
        title: 'The deadline passed before everyone signed',
        body: 'One signature is what kept this file: a request that reaches its deadline with none at all destroys the document and leaves only its receipt.'} %}
{% elseif status.signed %}
    {% set banner = {tone: 'success', icon: 'ti-circle-check',
        title: 'Signed - ' ~ signatures|length ~ ' signature' ~ (signatures|length == 1 ? '' : 's') ~ ', ' ~ document.versions|length ~ ' versions',
        body: 'Every signature is kept as its own version, each with the fingerprint of the exact bytes it covers. Delivery is the only thing left that can be done with this file.'} %}
{% else %}
    {% set banner = {tone: 'warning', icon: 'ti-writing-sign',
        title: 'Stored and encrypted, and nothing more has happened to it',
        body: 'A draft is the halfway state. Three things can happen next, and the first one you choose closes off some of the others.'} %}
{% endif %}

{% set bannerTone = {
    'success': 'border-success-500/25 bg-success-500/[0.06] text-success-600',
    'info':    'border-info-500/25 bg-info-500/[0.06] text-info-600',
    'warning': 'border-warning-500/25 bg-warning-500/[0.06] text-warning-600',
    'danger':  'border-danger-500/25 bg-danger-500/[0.06] text-danger-600',
}[banner.tone] %}
<div class="rounded-lg border p-5 {{ bannerTone }}">
    <div class="flex items-start gap-3">
        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-white/70">
            <i class="ti {{ banner.icon }} text-lg leading-none" aria-hidden="true"></i>
        </span>
        <div class="min-w-0">
            <p class="text-sm font-bold text-theme-headings">{{ banner.title }}</p>
            <p class="mt-1 text-sm leading-relaxed text-theme-secondarytextcolor">{{ banner.body }}</p>
        </div>
    </div>
</div>

{# ── the open request: deadline, progress, and whose turn it is ─────────── #}
{% if signingRequest %}
    <div class="mt-5 flex flex-col gap-4 rounded-lg border border-primary-500/25 bg-primary-500/[0.05] px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
        {{ signing.due(signingRequest.deadline, true) }}
        <div class="min-w-0 sm:max-w-xs sm:flex-1">{{ signing.progress(signingRequest) }}</div>
    </div>

    {% if signingRequest.hasAnySignature %}
        <p class="mt-3 flex items-start gap-2 text-xs leading-relaxed text-theme-secondarytextcolor">
            <i class="ti ti-info-circle mt-px text-sm leading-none" aria-hidden="true"></i>
            <span>
                <strong class="text-theme-headings">One signature is what keeps this file.</strong>
                If the deadline passes now, the document is kept and marked Expired. Had nobody signed,
                it would be destroyed at the deadline and only its receipt would remain.
            </span>
        </p>
    {% endif %}

    <div class="mt-6">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Signing order</h2>
        {{ signing.signer_queue(signingRequest) }}
        {{ signing.deadline_note(signingRequest) }}
    </div>
{% endif %}

{# ── who signed, to the second ──────────────────────────────────────────── #}
{% if signatures is not empty and not signingRequest %}
    <div class="mt-6">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">
            Signatures
            <span class="ml-1 font-bold normal-case tracking-normal text-theme-headings">{{ signatures|length }}</span>
        </h2>
        <div class="card !mb-0 overflow-hidden !bg-white/90">
            <ol class="divide-y divide-theme-border/60">
                {% for signature in signatures %}
                    <li class="flex flex-wrap items-center gap-x-4 gap-y-2 p-5">
                        <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-success-500/10 text-success-600">
                            <i class="ti ti-circle-check text-base leading-none" aria-hidden="true"></i>
                        </span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate text-sm font-semibold text-theme-headings">{{ signature.user.fullName }}</span>
                            <span class="block truncate text-xs text-theme-secondarytextcolor">{{ signature.user.email }}</span>
                        </span>
                        <span class="shrink-0 text-right">
                            {# Seconds matter: this is the evidentiary record, not a feed. #}
                            <span class="block whitespace-nowrap font-mono text-xs text-theme-bodycolor">{{ signature.signedAt|date('d M Y, H:i:s') }}</span>
                            <span class="block text-[11px] text-theme-secondarytextcolor">
                                v{{ signature.versionNumber }} · {{ signature.viaRequest ? 'by request' : 'signed by the owner' }}
                            </span>
                        </span>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </div>
{% endif %}

{# ── who it was served on ───────────────────────────────────────────────── #}
{% if deliveries is not empty %}
    <div id="deliveries" class="mt-6">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Delivered to</h2>
        <div class="card !mb-0 overflow-hidden !bg-white/90">
            <ul class="divide-y divide-theme-border/60">
                {% for delivery in deliveries %}
                    {% for recipient in delivery.recipients %}
                        <li class="flex flex-wrap items-center gap-x-4 gap-y-2 p-5">
                            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-500/10 text-primary-500">
                                <i class="ti ti-mail-forward text-base leading-none" aria-hidden="true"></i>
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm font-semibold text-theme-headings">{{ recipient.user.fullName }}</span>
                                <span class="block truncate text-xs text-theme-secondarytextcolor">{{ recipient.user.email }}</span>
                            </span>
                            <span class="shrink-0 text-right">
                                <span class="block whitespace-nowrap font-mono text-xs text-theme-bodycolor">{{ recipient.deliveredAt|date('d M Y, H:i:s') }}</span>
                                <span class="block text-[11px] text-theme-secondarytextcolor">served v{{ recipient.version.versionNumber }}</span>
                            </span>
                        </li>
                    {% endfor %}
                    {% if delivery.note %}
                        <li class="bg-theme-activebg/40 px-5 py-3 text-xs italic leading-relaxed text-theme-secondarytextcolor">
                            "{{ delivery.note }}"
                        </li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
        <p class="mt-3 text-xs text-theme-secondarytextcolor">A delivery cannot be taken back. Each one is attested by a sealed receipt under Receipts.</p>
    </div>
{% endif %}

{# ── what can still happen ──────────────────────────────────────────────── #}
{% if isOwner %}
    {{ include('documents/_actions.html.twig') }}
{% elseif isRecipient %}
    <div class="mt-6">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Your position</h2>
        <div class="card !mb-0 !bg-white/90 p-5">
            <p class="text-sm leading-relaxed text-theme-bodycolor">
                You are a <strong class="text-theme-headings">recipient</strong>, not a signer. Whatever signing
                this document needed was finished before it reached you, so there is no action here beyond
                reading it and keeping it.
            </p>
        </div>
    </div>
{% endif %}
