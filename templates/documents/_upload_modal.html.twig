{#
    Upload modal as a native <dialog> (top layer, frosted ::backdrop). Open/close
    is driven by the documents-upload Stimulus controller on the wrapping element
    in layout/app.html.twig - no theme modal instance, so nothing to desync.
#}
<dialog data-documents-upload-target="dialog"
        data-action="click->documents-upload#backdropClose cancel->documents-upload#onCancel"
        class="docs-modal" aria-labelledby="upload-modal-title">
    <div class="relative rounded-xl bg-white shadow-2xl">

        <div class="flex items-start justify-between gap-4 border-b border-theme-border p-5">
            <div>
                <h3 id="upload-modal-title" class="text-lg font-bold text-theme-headings">Upload document</h3>
                <p class="mt-0.5 text-sm text-theme-secondarytextcolor">PDF only, up to 10 MB. Your file is encrypted before it's stored.</p>
            </div>
            <button type="button" data-action="documents-upload#close"
                    class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-theme-secondarytextcolor hover:bg-theme-activebg hover:text-theme-headings">
                <span class="sr-only">Close</span>
                <i class="ti ti-x text-base leading-none" aria-hidden="true"></i>
            </button>
        </div>

        {# The modal ships with the layout, so the form comes from a Twig
           function rather than from every controller that renders a page. #}
        {% set uploadForm = document_upload_form() %}
        {% set E_FILE = constant('App\\Document\\Form\\UploadDocumentForm::E_FILE') %}
        {% set E_RETURN = constant('App\\Document\\Form\\UploadDocumentForm::E_RETURN') %}
        {{ form_start(uploadForm, {
            action: path('app_document_upload'),
            attr: {novalidate: 'novalidate', 'data-action': 'submit->documents-upload#validate'}
        }) }}
            {{ form_widget(uploadForm[E_RETURN], {value: app.request.requestUri|split('?')|first}) }}
            <div class="p-5">
                <label data-dropzone
                       data-action="dragover->documents-upload#dragover dragleave->documents-upload#dragleave drop->documents-upload#drop"
                       class="flex w-full flex-col items-center justify-center rounded-lg border-2 border-dashed border-theme-inputborder bg-theme-bodybg/70 px-6 py-10 text-center transition-colors hover:bg-theme-activebg">
                    {{ form_widget(uploadForm[E_FILE], {attr: {
                        class: 'hidden',
                        'data-documents-upload-target': 'input',
                        'data-action': 'documents-upload#selected',
                    }}) }}

                    <span data-documents-upload-target="prompt" class="flex flex-col items-center gap-2">
                        <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary-500/10 text-primary-500">
                            <i class="ti ti-upload text-xl leading-none" aria-hidden="true"></i>
                        </span>
                        <span class="text-sm text-theme-bodycolor"><span class="font-semibold text-primary-500">Click to browse</span> or drag a PDF here</span>
                        <span class="text-xs text-theme-secondarytextcolor">Maximum 10 MB</span>
                    </span>

                    <span data-documents-upload-target="selected" class="hidden flex-col items-center gap-1.5">
                        <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-danger-500/10 text-danger-600">
                            <i class="ti ti-file-text text-xl leading-none" aria-hidden="true"></i>
                        </span>
                        <span data-documents-upload-target="filename" class="text-sm font-semibold text-theme-headings"></span>
                        <span data-documents-upload-target="filesize" class="text-xs text-theme-secondarytextcolor"></span>
                        <span class="text-xs font-medium text-primary-500 underline">Choose a different file</span>
                    </span>
                </label>
                <p data-documents-upload-target="error" class="mt-2 hidden text-sm font-medium text-danger-500"></p>
            </div>

            <div class="flex justify-end gap-3 border-t border-theme-border p-5">
                <button type="button" data-action="documents-upload#close" class="btn btn-outline-secondary">Cancel</button>
                <button type="submit" class="btn btn-primary inline-flex items-center gap-2">
                    <i class="ti ti-upload text-base leading-none" aria-hidden="true"></i>
                    Upload
                </button>
            </div>
        {{ form_end(uploadForm) }}
    </div>
</dialog>
