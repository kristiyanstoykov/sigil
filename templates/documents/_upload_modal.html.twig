{#
    Upload modal as a native <dialog> (top layer, frosted ::backdrop). Open/close
    is driven by the documents-upload Stimulus controller on the wrapping element
    in index.html.twig - no Flowbite modal instance, so nothing to desync.
#}
<dialog data-documents-upload-target="dialog"
        data-action="click->documents-upload#backdropClose cancel->documents-upload#onCancel"
        class="docs-modal" aria-labelledby="upload-modal-title">
    <div class="relative rounded-xl bg-white shadow-2xl">

        <div class="flex items-start justify-between gap-4 border-b border-gray-200 p-5">
            <div>
                <h3 id="upload-modal-title" class="text-lg font-bold text-gray-900">Upload document</h3>
                <p class="mt-0.5 text-sm text-gray-500">PDF only, up to 10 MB. Your file is encrypted before it's stored.</p>
            </div>
            <button type="button" data-action="documents-upload#close"
                    class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-900">
                <span class="sr-only">Close</span>
                <svg class="w-4 h-4" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m1 1 12 12M13 1 1 13"/></svg>
            </button>
        </div>

        <form method="post" action="{{ path('app_document_upload') }}" enctype="multipart/form-data"
              data-action="submit->documents-upload#validate">
            <input type="hidden" name="_token" value="{{ csrf_token('upload-document') }}">
            <input type="hidden" name="_return" value="{{ app.request.requestUri|split('?')|first }}">
            <div class="p-5">
                <label data-dropzone
                       data-action="dragover->documents-upload#dragover dragleave->documents-upload#dragleave drop->documents-upload#drop"
                       class="flex w-full flex-col items-center justify-center rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 px-6 py-10 text-center transition-colors hover:bg-gray-100">
                    <input type="file" name="document" accept="application/pdf,.pdf" required class="hidden"
                           data-documents-upload-target="input" data-action="documents-upload#selected">

                    <span data-documents-upload-target="prompt" class="flex flex-col items-center gap-2">
                        <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary-50 text-primary-700">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 20h14"/></svg>
                        </span>
                        <span class="text-sm text-gray-600"><span class="font-semibold text-primary-700">Click to browse</span> or drag a PDF here</span>
                        <span class="text-xs text-gray-400">Maximum 10 MB</span>
                    </span>

                    <span data-documents-upload-target="selected" class="hidden flex-col items-center gap-1.5">
                        <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-red-50 text-red-600">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
                        </span>
                        <span data-documents-upload-target="filename" class="text-sm font-semibold text-gray-900"></span>
                        <span data-documents-upload-target="filesize" class="text-xs text-gray-400"></span>
                        <span class="text-xs font-medium text-primary-700 underline">Choose a different file</span>
                    </span>
                </label>
                <p data-documents-upload-target="error" class="mt-2 hidden text-sm font-medium text-red-600"></p>
            </div>

            <div class="flex justify-end gap-3 border-t border-gray-200 p-5">
                <button type="button" data-action="documents-upload#close"
                        class="rounded-lg border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100">Cancel</button>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-lg bg-primary-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-800 focus:ring-4 focus:ring-primary-300">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 20h14"/></svg>
                    Upload
                </button>
            </div>
        </form>
    </div>
</dialog>
