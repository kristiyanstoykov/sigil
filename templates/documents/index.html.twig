{% extends 'layout/app.html.twig' %}
{% import 'documents/_macros.html.twig' as docs %}

{% block title %}Documents · Sigil{% endblock %}
{% block main_class %}docs-gradient{% endblock %}

{% block content %}
<div class="docs-rise mx-auto max-w-5xl">

    {# ── header ─────────────────────────────────────────────────────────── #}
    <div class="mb-5 flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
        <div class="min-w-0 max-sm:basis-full">
            <h1 class="text-2xl font-extrabold tracking-tight text-theme-headings">Documents</h1>
            <p class="mt-1 text-sm text-theme-secondarytextcolor">Your uploaded and signed documents.</p>
        </div>
        <button type="button" data-action="documents-upload#open"
                class="btn btn-primary inline-flex shrink-0 items-center gap-2 max-sm:ml-auto">
            <i class="ti ti-upload text-base leading-none" aria-hidden="true"></i>
            Upload document
        </button>
    </div>

    {# ── tabs + (reserved) search ───────────────────────────────────────── #}
    <div class="mb-5 flex items-center justify-between gap-4 border-b border-theme-border">
        <div class="flex gap-6">
            <span class="border-b-2 border-primary-500 pb-3 text-sm font-semibold text-primary-500">My documents</span>
            <span class="inline-flex items-center gap-2 pb-3 text-sm font-semibold text-theme-secondarytextcolor/70 cursor-not-allowed" title="Coming soon">
                Shared with me
                <span class="rounded border border-theme-border bg-theme-activebg px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-theme-secondarytextcolor">Soon</span>
            </span>
        </div>
        <div class="mb-2 hidden items-center gap-2 rounded-lg border border-theme-border bg-white/70 px-3 py-1.5 text-theme-secondarytextcolor/70 sm:flex" title="Search - coming soon">
            <i class="ti ti-search text-base leading-none" aria-hidden="true"></i>
            <span class="text-sm">Search documents…</span>
        </div>
    </div>

    {% if documents is empty %}
        {# ── empty state ────────────────────────────────────────────────── #}
        <div class="card !mb-0 !bg-white/80 p-14 text-center">
            <div class="relative mb-4 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-500/10 text-primary-500 mx-auto">
                <i class="ti ti-file-text text-3xl leading-none" aria-hidden="true"></i>
                <span class="absolute -bottom-1 -right-1 inline-flex h-6 w-6 items-center justify-center rounded-lg border-2 border-white bg-primary-500 text-white">
                    <i class="ti ti-lock text-xs leading-none" aria-hidden="true"></i>
                </span>
            </div>
            <h2 class="text-lg font-extrabold text-theme-headings">No documents yet</h2>
            <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-theme-secondarytextcolor">Upload a PDF to encrypt and store it securely. It's encrypted at rest the moment it lands.</p>
            <button type="button" data-action="documents-upload#open"
                    class="btn btn-primary mt-5 inline-flex items-center gap-2 mx-auto">
                <i class="ti ti-upload text-base leading-none" aria-hidden="true"></i>
                Upload document
            </button>
        </div>
    {% else %}
        {# ── desktop table ──────────────────────────────────────────────── #}
        <div class="card !mb-0 hidden overflow-hidden !bg-white/90 md:block">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[706px] text-left" data-controller="doc-sort">
                    <thead class="border-b border-theme-border bg-theme-bodybg/70 text-[11px] font-bold uppercase tracking-wider text-theme-secondarytextcolor">
                        <tr>
                            {% for col in [{key: 'name', label: 'Document'}, {key: 'size', label: 'Size'}, {key: 'date', label: 'Uploaded'}] %}
                                {% if col.key == 'size' %}<th class="px-5 py-3 font-bold">Status</th>{% endif %}
                                <th class="px-5 py-3 font-bold">
                                    <button type="button" data-action="doc-sort#sort" data-doc-sort-key-param="{{ col.key }}"
                                            class="inline-flex items-center gap-1 font-bold uppercase tracking-wider text-theme-secondarytextcolor hover:text-theme-headings">
                                        {{ col.label }}
                                        <span class="text-theme-secondarytextcolor/70" data-doc-sort-target="arrow" data-arrow-key="{{ col.key }}"></span>
                                    </button>
                                </th>
                            {% endfor %}
                            <th class="px-5 py-3 text-right font-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-theme-border/60" data-doc-sort-target="body">
                        {% for document in documents %}
                            {% set v = document.latestVersion %}
                            <tr class="hover:bg-theme-activebg/60" data-sortable-row
                                data-sort-name="{{ document.title|lower }}"
                                data-sort-size="{{ v.sizeBytes }}"
                                data-sort-date="{{ v.createdAt|date('U') }}">
                                <td class="px-5 py-3.5">
                                    <a href="{{ path('app_document_show', {id: document.id}) }}" class="flex items-center gap-3">
                                        {{ docs.pdf_icon('sm') }}
                                        <span class="min-w-0">
                                            <span class="block truncate text-sm font-semibold text-theme-headings">{{ document.title }}</span>
                                            <span class="mt-0.5 inline-flex items-center gap-1 text-[11.5px] text-theme-secondarytextcolor">
                                                <i class="ti ti-lock text-xs leading-none" aria-hidden="true"></i>
                                                Encrypted
                                            </span>
                                        </span>
                                    </a>
                                </td>
                                <td class="px-5 py-3.5">{{ docs.status_badge(v.kind) }}</td>
                                <td class="px-5 py-3.5 text-sm text-theme-bodycolor">{{ docs.filesize(v.sizeBytes) }}</td>
                                <td class="px-5 py-3.5 text-sm text-theme-bodycolor">{{ v.createdAt|date('d M Y') }}</td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="{{ path('app_document_download', {id: document.id}) }}" data-turbo="false"
                                           class="btn btn-sm btn-primary inline-flex items-center gap-1.5">
                                            <i class="ti ti-download text-sm leading-none" aria-hidden="true"></i>
                                            Download
                                        </a>
                                        <div class="relative">{{ docs.row_menu(document, 'd') }}</div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# ── mobile cards ───────────────────────────────────────────────── #}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:hidden">
            {% for document in documents %}
                {% set v = document.latestVersion %}
                <div class="card !mb-0 overflow-hidden !bg-white/90">
                    <a href="{{ path('app_document_show', {id: document.id}) }}" class="block p-4">
                        <div class="flex items-start justify-between gap-2.5">
                            {{ docs.pdf_icon('lg') }}
                            {{ docs.status_badge(v.kind) }}
                        </div>
                        <div class="mt-3.5 line-clamp-2 text-sm font-bold text-theme-headings">{{ document.title }}</div>
                        <div class="mt-2 flex items-center gap-2.5 text-xs text-theme-secondarytextcolor">
                            <span class="inline-flex items-center gap-1">
                                <i class="ti ti-lock text-xs leading-none" aria-hidden="true"></i>
                                Encrypted
                            </span>
                            <span>·</span>
                            <span>{{ docs.filesize(v.sizeBytes) }}</span>
                        </div>
                    </a>
                    <div class="flex items-center justify-between gap-2 border-t border-theme-border/60 bg-theme-bodybg/50 px-4 py-3">
                        <span class="text-xs text-theme-secondarytextcolor">{{ v.createdAt|date('d M Y') }}</span>
                        <div class="flex items-center gap-2">
                            <a href="{{ path('app_document_download', {id: document.id}) }}" data-turbo="false"
                               class="btn btn-sm btn-primary inline-flex items-center gap-1.5">
                                <i class="ti ti-download text-sm leading-none" aria-hidden="true"></i>
                                Download
                            </a>
                            <div class="relative">{{ docs.row_menu(document, 'm') }}</div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% endblock %}
