{% extends 'layout/app.html.twig' %}
{% import 'documents/_macros.html.twig' as docs %}

{% block title %}Documents · Sigil{% endblock %}
{% block main_class %}docs-gradient{% endblock %}

{% block content %}
{#
    The library: every document this user can open, in one table. Which ones are
    theirs is the Role column, not a separate tab - the two used to be split, and
    "Shared with me" quietly meant four different things.

    Every row is rendered, always. Role and status filtering happens in the
    datatable, beside its search and paging, so applying a filter never costs a
    round trip; the ?role= / ?status= query string only seeds the initial state
    and is kept in sync afterwards, so a filtered view is still linkable and
    survives a reload. Filtering could not have moved to the controller anyway -
    document_status() lives in Signing, which Document must not depend on.
#}
{% set role = app.request.query.get('role') in ['mine', 'others'] ? app.request.query.get('role') : '' %}
{% set status = app.request.query.get('status') %}
{% set roles = {'mine': 'Mine', 'others': 'From others'} %}
{% set statuses = {'draft': 'Draft', 'pending': 'Awaiting signatures', 'signed': 'Signed', 'delivered': 'Delivered', 'declined': 'Declined', 'expired': 'Expired'} %}

<div class="docs-rise mx-auto max-w-5xl">

    {# ── header ─────────────────────────────────────────────────────────── #}
    <div class="mb-5 flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
        <div class="min-w-0 max-sm:basis-full">
            <h1 class="text-2xl font-extrabold tracking-tight text-theme-headings">Documents</h1>
            <p class="mt-1 text-sm text-theme-secondarytextcolor">Everything you can open - what you uploaded, and what reached you.</p>
        </div>
        <button type="button" data-action="documents-upload#open"
                class="btn btn-primary inline-flex shrink-0 items-center gap-2 max-sm:ml-auto">
            <i class="ti ti-upload text-base leading-none" aria-hidden="true"></i>
            Upload document
        </button>
    </div>

    {% if documents is empty %}
        {# ── empty state: nothing at all ────────────────────────────────── #}
        <div class="card !mb-0 !bg-white/80 p-14 text-center">
            <div class="relative mb-4 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-500/10 text-primary-500 mx-auto">
                <i class="ti ti-file-text text-3xl leading-none" aria-hidden="true"></i>
                <span class="absolute -bottom-1 -right-1 inline-flex h-6 w-6 items-center justify-center rounded-lg border-2 border-white bg-primary-500 text-white">
                    <i class="ti ti-lock text-xs leading-none" aria-hidden="true"></i>
                </span>
            </div>
            <h2 class="text-lg font-extrabold text-theme-headings">No documents yet</h2>
            <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-theme-secondarytextcolor">Upload a PDF to encrypt and store it securely. It's encrypted at rest the moment it lands.</p>
            <button type="button" data-action="documents-upload#open"
                    class="btn btn-primary mt-5 inline-flex items-center gap-2 mx-auto">
                <i class="ti ti-upload text-base leading-none" aria-hidden="true"></i>
                Upload document
            </button>
        </div>
    {% else %}
        {#
            Able Pro's own datatable (simple-datatables) supplies the search box,
            the rows-per-page selector, sorting, paging and now the two filters -
            see assets/controllers/documents_table_controller.js. The markup here
            is just the data: one table, rendered in full, so the list still
            reads without JavaScript (unfiltered, like the search and the paging).

            Below md the same rows restyle themselves as cards (documents-table.css)
            - hence data-label on every cell, which becomes the row's field label
            there. No second copy of the markup, and no sideways scrolling.
        #}
        {# The controller sits on this wrapper, not on the <table>: initialising
           the datatable moves the table into a wrapper of its own, and a
           Stimulus controller mounted on a moved element reconnects - which
           would initialise it again, forever. The toolbar is inside it so the
           search box and the filters can be controller targets. #}
        <div class="docs-table"
             data-controller="documents-table"
             data-documents-table-per-page-value="10"
             data-documents-table-title-column-value="0"
             data-documents-table-role-column-value="1"
             data-documents-table-status-column-value="2"
             data-documents-table-size-column-value="3"
             data-documents-table-date-column-value="4"
             data-documents-table-actions-column-value="5"
             data-documents-table-role-value="{{ role }}"
             data-documents-table-status-value="{{ status }}">

            {#
                ── toolbar: search left, filters right ─────────────────────
                One row from sm up. Below it the row stacks - search full
                width, filters under it - because four controls side by side
                on a phone left nothing legible.

                The filter items stay <a href> so a middle-click or a
                JavaScript-less visit still lands on the filtered URL; the
                controller intercepts the plain click and filters in place.
            #}
            <div class="mb-4 flex flex-col gap-2.5 sm:flex-row sm:flex-wrap sm:items-stretch sm:gap-3">
                <div class="relative min-w-0 sm:max-w-xs sm:flex-1">
                    <i class="ti ti-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-base leading-none text-theme-secondarytextcolor" aria-hidden="true"></i>
                    <input type="search" data-documents-table-target="search"
                           class="form-control !py-2 !pl-9 text-sm" placeholder="Search documents" aria-label="Search documents">
                </div>

                <div class="flex flex-wrap items-stretch justify-end gap-2 sm:ml-auto">
                    <div class="dropdown">
                        <button type="button" data-pc-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                                class="btn btn-outline-secondary inline-flex items-center gap-2 text-sm">
                            <i class="ti ti-user text-base leading-none" aria-hidden="true"></i>
                            <span class="text-theme-secondarytextcolor">Role:</span>
                            <span class="font-semibold" data-documents-table-target="roleLabel">{{ role ? roles[role] : 'All' }}</span>
                            <i class="ti ti-chevron-down text-sm leading-none" aria-hidden="true"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a href="{{ path('app_documents', status ? {status: status} : {}) }}"
                               data-documents-table-target="roleItem" data-value=""
                               data-action="documents-table#pickRole"
                               class="dropdown-item {{ role == '' ? '!text-primary-500 font-semibold' }}">
                                All
                                <span class="ml-1 text-theme-secondarytextcolor">{{ documents|length }}</span>
                            </a>
                            {% for key, label in roles %}
                                <a href="{{ path('app_documents', {role: key}|merge(status ? {status: status} : {})) }}"
                                   data-documents-table-target="roleItem" data-value="{{ key }}"
                                   data-action="documents-table#pickRole"
                                   class="dropdown-item {{ role == key ? '!text-primary-500 font-semibold' }}">{{ label }}</a>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="dropdown">
                        <button type="button" data-pc-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                                class="btn btn-outline-secondary inline-flex items-center gap-2 text-sm">
                            <i class="ti ti-filter text-base leading-none" aria-hidden="true"></i>
                            <span class="text-theme-secondarytextcolor">Status:</span>
                            <span class="font-semibold" data-documents-table-target="statusLabel">{{ status ? statuses[status]|default(status) : 'Any' }}</span>
                            <i class="ti ti-chevron-down text-sm leading-none" aria-hidden="true"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a href="{{ path('app_documents', role ? {role: role} : {}) }}"
                               data-documents-table-target="statusItem" data-value=""
                               data-action="documents-table#pickStatus"
                               class="dropdown-item {{ status is empty ? '!text-primary-500 font-semibold' }}">Any</a>
                            {% for key, label in statuses %}
                                {# Only offer a status some document actually has. #}
                                {% if documents|filter(d => document_status(d).value == key)|length %}
                                    <a href="{{ path('app_documents', {status: key}|merge(role ? {role: role} : {})) }}"
                                       data-documents-table-target="statusItem" data-value="{{ key }}"
                                       data-action="documents-table#pickStatus"
                                       class="dropdown-item {{ status == key ? '!text-primary-500 font-semibold' }}">{{ label }}</a>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>

                    {# Icon only on a phone: the word is what made the row overflow. #}
                    <a href="{{ path('app_documents') }}"
                       data-documents-table-target="clear"
                       data-action="documents-table#clear"
                       class="btn btn-outline-secondary inline-flex items-center gap-1.5 text-sm max-sm:!px-2.5"
                       title="Clear filters" aria-label="Clear filters" {{ (role or status) ? '' : 'hidden' }}>
                        <i class="ti ti-x text-sm leading-none" aria-hidden="true"></i>
                        <span class="max-sm:hidden">Clear</span>
                    </a>
                </div>
            </div>

            {#
                ── empty state: the filters excluded everything ────────────
                Deliberately not the same card as "no documents yet": one says
                the library is empty, the other says the view is. The controller
                swaps it in for the table when a filter or a search matches
                nothing, in place of the datatable's one-line message.
            #}
            <div class="card !mb-0 !bg-white/80 p-14 text-center" data-documents-table-target="empty" hidden>
                <div class="mb-4 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-500/10 text-primary-500 mx-auto">
                    <i class="ti ti-filter text-3xl leading-none" aria-hidden="true"></i>
                </div>
                <h2 class="text-lg font-extrabold text-theme-headings">Nothing matches that</h2>
                <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-theme-secondarytextcolor">You have {{ documents|length }} document{{ documents|length == 1 ? '' : 's' }} in total.</p>
                <button type="button" data-action="documents-table#clear"
                        class="btn btn-outline-secondary mt-5 inline-flex items-center gap-2 mx-auto">
                    <i class="ti ti-x text-base leading-none" aria-hidden="true"></i>
                    Clear filters
                </button>
            </div>

            <div class="card !mb-0 overflow-hidden !bg-white/90" data-documents-table-target="card">
            <div class="table-responsive">
                <table class="table w-full text-left" data-documents-table-target="table">
                    <thead class="border-b border-theme-border bg-theme-bodybg/70 text-[11px] font-bold uppercase tracking-wider text-theme-secondarytextcolor">
                        <tr>
                            <th class="px-5 py-3 font-bold">Document</th>
                            <th class="px-5 py-3 font-bold">Role</th>
                            <th class="px-5 py-3 font-bold">Status</th>
                            <th class="px-5 py-3 font-bold">Size</th>
                            <th class="px-5 py-3 font-bold">Uploaded</th>
                            <th class="px-5 py-3 text-right font-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-theme-border/60">
                        {% for document in documents %}
                            {% set v = document.latestVersion %}
                            {% set owned = document.owner.id == app.user.id %}
                            {% set st = document_status(document) %}
                            <tr class="hover:bg-theme-activebg/60">
                                <td class="px-5 py-3.5" data-label="Document">
                                    <a href="{{ path('app_document_show', {id: document.id}) }}" class="flex items-start gap-3">
                                        {{ docs.pdf_icon('sm') }}
                                        {# A title is a filename and can run long. It wraps
                                           rather than truncating - the whole name is what
                                           tells two versions of a contract apart - and the
                                           cap keeps it from crowding the other columns. #}
                                        <span class="min-w-0 max-w-[22rem]">
                                            <span class="block whitespace-normal text-sm font-semibold leading-snug text-theme-headings [overflow-wrap:anywhere]">{{ document.title }}</span>
                                            <span class="mt-0.5 inline-flex items-center gap-1 text-[11.5px] text-theme-secondarytextcolor">
                                                {% if owned %}
                                                    <i class="ti ti-lock text-xs leading-none" aria-hidden="true"></i>
                                                    Encrypted
                                                {% else %}
                                                    <i class="ti ti-user text-xs leading-none" aria-hidden="true"></i>
                                                    {{ document.owner.fullName }}
                                                {% endif %}
                                            </span>
                                        </span>
                                    </a>
                                </td>
                                {# Why you can see this row. With no plain sharing left, a
                                   grant on someone else's document means a signature
                                   request reached you.

                                   data-filter is what the Role and Status filters match
                                   on, never the badge's wording: the badges can be
                                   reworded, and "From others" is two of them anyway. #}
                                <td class="px-5 py-3.5" data-label="Role" data-filter="{{ owned ? 'mine' : 'others' }}">{{ docs.role_badge(document, owned) }}</td>
                                {# The document's state, not the latest version's kind:
                                   an unsigned document is a Draft, i.e. unfinished. #}
                                <td class="px-5 py-3.5" data-label="Status" data-filter="{{ st.value }}">{{ docs.doc_status_badge(st) }}</td>
                                {# Raw bytes: the datatable sorts on the cell's value and
                                   renders the human-readable size for display. #}
                                <td class="px-5 py-3.5 text-sm text-theme-bodycolor" data-label="Size">{{ v.sizeBytes }}</td>
                                <td class="px-5 py-3.5 text-sm text-theme-bodycolor" data-label="Uploaded">{{ v.createdAt|date('d M Y') }}</td>
                                <td class="px-5 py-3.5" data-label="Actions">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="{{ path('app_document_download', {id: document.id}) }}" data-turbo="false"
                                           class="btn btn-sm btn-primary inline-flex items-center gap-1.5">
                                            <i class="ti ti-download text-sm leading-none" aria-hidden="true"></i>
                                            Download
                                        </a>
                                        <div class="relative">{{ docs.row_menu(document, owned) }}</div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            </div>
        </div>
    {% endif %}
</div>

{% endblock %}
