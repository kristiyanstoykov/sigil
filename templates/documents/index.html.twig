{% extends 'layout/app.html.twig' %}
{% import 'documents/_macros.html.twig' as docs %}

{% block title %}Documents · Sigil{% endblock %}
{% block main_class %}docs-gradient{% endblock %}

{% block content %}
<div class="docs-rise mx-auto max-w-5xl">

    {# ── header ─────────────────────────────────────────────────────────── #}
    <div class="mb-5 flex items-start justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold tracking-tight text-gray-900">Documents</h1>
            <p class="mt-1 text-sm text-gray-500">Your uploaded and signed documents.</p>
        </div>
        <button type="button" data-action="documents-upload#open"
                class="inline-flex shrink-0 items-center gap-2 rounded-lg bg-primary-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-primary-800 focus:ring-4 focus:ring-primary-300">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 20h14"/></svg>
            Upload document
        </button>
    </div>

    {# ── tabs + (reserved) search ───────────────────────────────────────── #}
    <div class="mb-5 flex items-center justify-between gap-4 border-b border-gray-200">
        <div class="flex gap-6">
            <span class="border-b-2 border-primary-700 pb-3 text-sm font-semibold text-primary-700">My documents</span>
            <span class="inline-flex items-center gap-2 pb-3 text-sm font-semibold text-gray-400 cursor-not-allowed" title="Coming soon">
                Shared with me
                <span class="rounded border border-gray-200 bg-gray-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-gray-400">Soon</span>
            </span>
        </div>
        <div class="mb-2 hidden items-center gap-2 rounded-lg border border-gray-200 bg-white/70 px-3 py-1.5 text-gray-400 sm:flex" title="Search - coming soon">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <span class="text-sm">Search documents…</span>
        </div>
    </div>

    {% if documents is empty %}
        {# ── empty state ────────────────────────────────────────────────── #}
        <div class="rounded-xl border border-gray-200 bg-white/80 p-14 text-center shadow-sm">
            <div class="relative mb-4 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-50 text-primary-700">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
                <span class="absolute -bottom-1 -right-1 inline-flex h-6 w-6 items-center justify-center rounded-lg border-2 border-white bg-primary-700 text-white">
                    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </span>
            </div>
            <h2 class="text-lg font-extrabold text-gray-900">No documents yet</h2>
            <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-gray-500">Upload a PDF to encrypt and store it securely. It's encrypted at rest the moment it lands.</p>
            <button type="button" data-action="documents-upload#open"
                    class="mt-5 inline-flex items-center gap-2 rounded-lg bg-primary-700 px-5 py-3 text-sm font-semibold text-white hover:bg-primary-800 focus:ring-4 focus:ring-primary-300">
                <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5"/><path d="M5 20h14"/></svg>
                Upload document
            </button>
        </div>
    {% else %}
        {# ── desktop table ──────────────────────────────────────────────── #}
        <div class="hidden overflow-hidden rounded-xl border border-gray-200 bg-white/90 shadow-sm md:block">
            <div class="overflow-x-auto">
                <table class="w-full min-w-[706px] text-left" data-controller="doc-sort">
                    <thead class="border-b border-gray-200 bg-gray-50 text-[11px] font-bold uppercase tracking-wider text-gray-500">
                        <tr>
                            {% for col in [{key: 'name', label: 'Document'}, {key: 'size', label: 'Size'}, {key: 'date', label: 'Uploaded'}] %}
                                {% if col.key == 'size' %}<th class="px-5 py-3 font-bold">Status</th>{% endif %}
                                <th class="px-5 py-3 font-bold">
                                    <button type="button" data-action="doc-sort#sort" data-doc-sort-key-param="{{ col.key }}"
                                            class="inline-flex items-center gap-1 font-bold uppercase tracking-wider text-gray-500 hover:text-gray-800">
                                        {{ col.label }}
                                        <span class="text-gray-400" data-doc-sort-target="arrow" data-arrow-key="{{ col.key }}"></span>
                                    </button>
                                </th>
                            {% endfor %}
                            <th class="px-5 py-3 text-right font-bold">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100" data-doc-sort-target="body">
                        {% for document in documents %}
                            {% set v = document.latestVersion %}
                            <tr class="hover:bg-gray-50" data-sortable-row
                                data-sort-name="{{ document.title|lower }}"
                                data-sort-size="{{ v.sizeBytes }}"
                                data-sort-date="{{ v.createdAt|date('U') }}">
                                <td class="px-5 py-3.5">
                                    <a href="{{ path('app_document_show', {id: document.id}) }}" class="flex items-center gap-3">
                                        {{ docs.pdf_icon('sm') }}
                                        <span class="min-w-0">
                                            <span class="block truncate text-sm font-semibold text-gray-900">{{ document.title }}</span>
                                            <span class="mt-0.5 inline-flex items-center gap-1 text-[11.5px] text-gray-400">
                                                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                                                Encrypted
                                            </span>
                                        </span>
                                    </a>
                                </td>
                                <td class="px-5 py-3.5">{{ docs.status_badge(v.kind) }}</td>
                                <td class="px-5 py-3.5 text-sm text-gray-600">{{ docs.filesize(v.sizeBytes) }}</td>
                                <td class="px-5 py-3.5 text-sm text-gray-600">{{ v.createdAt|date('d M Y') }}</td>
                                <td class="px-5 py-3.5">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="{{ path('app_document_download', {id: document.id}) }}" data-turbo="false"
                                           class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50">
                                            <svg class="w-[15px] h-[15px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M5 21h14"/></svg>
                                            Download
                                        </a>
                                        <div class="relative">{{ docs.row_menu(document, 'd') }}</div>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# ── mobile cards ───────────────────────────────────────────────── #}
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:hidden">
            {% for document in documents %}
                {% set v = document.latestVersion %}
                <div class="overflow-hidden rounded-xl border border-gray-200 bg-white/90 shadow-sm">
                    <a href="{{ path('app_document_show', {id: document.id}) }}" class="block p-4">
                        <div class="flex items-start justify-between gap-2.5">
                            {{ docs.pdf_icon('lg') }}
                            {{ docs.status_badge(v.kind) }}
                        </div>
                        <div class="mt-3.5 line-clamp-2 text-sm font-bold text-gray-900">{{ document.title }}</div>
                        <div class="mt-2 flex items-center gap-2.5 text-xs text-gray-400">
                            <span class="inline-flex items-center gap-1">
                                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                                Encrypted
                            </span>
                            <span>·</span>
                            <span>{{ docs.filesize(v.sizeBytes) }}</span>
                        </div>
                    </a>
                    <div class="flex items-center justify-between gap-2 border-t border-gray-100 bg-gray-50/60 px-4 py-3">
                        <span class="text-xs text-gray-400">{{ v.createdAt|date('d M Y') }}</span>
                        <div class="flex items-center gap-2">
                            <a href="{{ path('app_document_download', {id: document.id}) }}" data-turbo="false"
                               class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50">
                                <svg class="w-[14px] h-[14px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M5 21h14"/></svg>
                                Download
                            </a>
                            <div class="relative">{{ docs.row_menu(document, 'm') }}</div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% endblock %}
