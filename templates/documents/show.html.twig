{% extends 'layout/app.html.twig' %}
{% import 'documents/_macros.html.twig' as docs %}

{% block title %}{{ document.title }} · Sigil{% endblock %}
{% block main_class %}docs-gradient{% endblock %}

{% block content %}
{% set latest = document.latestVersion %}
<div class="docs-rise mx-auto max-w-4xl">

    <a href="{{ path('app_documents') }}" class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-theme-secondarytextcolor hover:text-theme-headings">
        <i class="ti ti-chevron-left text-base leading-none" aria-hidden="true"></i>
        Documents
    </a>

    {# ── header card ────────────────────────────────────────────────────── #}
    <div class="card !mb-0 !bg-white/90 p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex min-w-0 items-start gap-4">
                {{ docs.pdf_icon('lg') }}
                <div class="min-w-0">
                    <h1 class="truncate text-xl font-extrabold tracking-tight text-theme-headings">{{ document.title }}</h1>
                    <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-theme-secondarytextcolor">
                        <span>Uploaded {{ (latest ? latest.createdAt : document.createdAt)|date('d M Y') }}</span>
                        <span class="text-theme-border">·</span>
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-success-500/20 bg-success-500/10 px-2.5 py-0.5 text-xs font-semibold text-success-600">
                            <i class="ti ti-lock text-xs leading-none" aria-hidden="true"></i>
                            Encrypted at rest
                        </span>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <a href="{{ path('app_document_download', {id: document.id}) }}" data-turbo="false"
                   class="btn btn-outline-secondary inline-flex items-center gap-2">
                    <i class="ti ti-download text-base leading-none" aria-hidden="true"></i>
                    Download
                </a>
                <a href="{{ path('app_document_view', {id: document.id}) }}" target="_blank" rel="noopener" data-turbo="false"
                   class="btn btn-outline-secondary inline-flex items-center gap-2">
                    <i class="ti ti-eye text-base leading-none" aria-hidden="true"></i>
                    View
                </a>
                {% if document.isSigned %}
                    {# Blocked, not removed: the action stays visible so its
                       unavailability reads as "already done", not "missing". #}
                    <button type="button" class="btn btn-primary disabled inline-flex items-center gap-2"
                            disabled aria-disabled="true" title="This document has already been signed.">
                        <i class="ti ti-circle-check text-base leading-none" aria-hidden="true"></i>
                        Signed
                    </button>
                {% else %}
                    <a href="{{ path('app_document_sign', {id: document.id}) }}"
                       class="btn btn-primary inline-flex items-center gap-2">
                        <i class="ti ti-signature text-base leading-none" aria-hidden="true"></i>
                        Sign
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── versions timeline ──────────────────────────────────────────────── #}
    <div class="mt-6">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Versions</h2>
        <div class="card !mb-0 overflow-hidden !bg-white/90">
            <ul class="divide-y divide-theme-border/60">
                {% for v in document.versions|reverse %}
                    {# Stacks on mobile (badge row, fingerprint row, then a full-width
                       download button); from sm: single row with the button at the end. #}
                    <li class="p-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-x-4">
                        <div class="flex min-w-0 flex-1 items-start gap-3">
                            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-500/10 text-xs font-bold text-primary-500">v{{ v.versionNumber }}</span>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                    {{ docs.status_badge(v.kind) }}
                                    <span class="text-sm text-theme-secondarytextcolor whitespace-nowrap">{{ docs.filesize(v.sizeBytes) }} · {{ v.createdAt|date('d M Y, H:i') }}</span>
                                </div>
                                <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1" data-controller="clipboard" data-clipboard-text-value="{{ v.contentHash }}">
                                    <span class="text-[11px] font-medium uppercase tracking-wide text-theme-secondarytextcolor">Integrity fingerprint</span>
                                    <code class="rounded bg-theme-activebg px-1.5 py-0.5 font-mono text-xs text-theme-bodycolor whitespace-nowrap">{{ v.contentHash|slice(0, 10) }}…{{ v.contentHash|slice(-6) }}</code>
                                    <button type="button" data-action="clipboard#copy"
                                            class="inline-flex items-center gap-1 text-xs font-medium text-theme-secondarytextcolor hover:text-theme-headings cursor-pointer">
                                        <i class="ti ti-copy text-sm leading-none" aria-hidden="true"></i>
                                        Copy
                                    </button>
                                    <span data-clipboard-target="feedback" hidden class="text-xs font-medium text-success-600">Copied!</span>
                                </div>
                            </div>
                        </div>
                        <a href="{{ path('app_document_version_download', {id: document.id, number: v.versionNumber}) }}" data-turbo="false"
                           class="btn btn-sm btn-primary inline-flex items-center justify-center gap-1.5 w-full sm:w-auto shrink-0">
                            <i class="ti ti-download text-sm leading-none" aria-hidden="true"></i>
                            Download
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
        <p class="mt-3 text-xs text-theme-secondarytextcolor">Every version is kept. The original and each future signed copy for a complete, tamper-evident record.</p>
    </div>
</div>
{% endblock %}
