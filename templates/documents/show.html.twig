{% extends 'layout/app.html.twig' %}
{% import 'documents/_macros.html.twig' as docs %}
{% import 'signing/_macros.html.twig' as signing %}

{% block title %}{{ document.title }} · Sigil{% endblock %}
{% block main_class %}docs-gradient{% endblock %}

{% block content %}
{% set latest = document.latestVersion %}
{% set status = document_status(document) %}
<div class="docs-rise mx-auto max-w-4xl">

    <a href="{{ path('app_documents', isOwner ? {} : {role: 'others'}) }}" class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-theme-secondarytextcolor hover:text-theme-headings">
        <i class="ti ti-chevron-left text-base leading-none" aria-hidden="true"></i>
        Documents
    </a>

    {# ── header card ────────────────────────────────────────────────────── #}
    <div class="card !mb-0 !bg-white/90 p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex min-w-0 items-start gap-4">
                {{ docs.pdf_icon('lg') }}
                <div class="min-w-0">
                    <h1 class="truncate text-xl font-extrabold tracking-tight text-theme-headings">{{ document.title }}</h1>
                    <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-theme-secondarytextcolor">
                        <span>Uploaded {{ (latest ? latest.createdAt : document.createdAt)|date('d M Y') }}</span>
                        {% if not isOwner %}
                            <span class="text-theme-border">·</span>
                            <span class="inline-flex items-center gap-1.5">
                                <i class="ti ti-user text-xs leading-none" aria-hidden="true"></i>
                                Sent by {{ document.owner.fullName }}
                            </span>
                        {% endif %}
                        <span class="text-theme-border">·</span>
                        {{ docs.doc_status_badge(status) }}
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-success-500/20 bg-success-500/10 px-2.5 py-0.5 text-xs font-semibold text-success-600">
                            <i class="ti ti-lock text-xs leading-none" aria-hidden="true"></i>
                            Encrypted at rest
                        </span>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2">
                <a href="{{ path('app_document_download', {id: document.id}) }}" data-turbo="false"
                   class="btn btn-outline-secondary inline-flex items-center gap-2">
                    <i class="ti ti-download text-base leading-none" aria-hidden="true"></i>
                    Download
                </a>
                <a href="{{ path('app_document_view', {id: document.id}) }}" target="_blank" rel="noopener" data-turbo="false"
                   class="btn btn-outline-secondary inline-flex items-center gap-2">
                    <i class="ti ti-eye text-base leading-none" aria-hidden="true"></i>
                    View
                </a>
                {# Signing is the owner's for now. A recipient holds a read grant;
                   letting them sign is the SigningRequest workflow's job (ADR-007),
                   which will say who was actually asked to sign. #}
                {% if isOwner %}
                    {% if status.pending %}
                        {# The queue owns the document while a request is out: the
                           owner signs only if they are on the list, from the sign
                           page the panel below links to. #}
                        <button type="button" class="btn btn-primary disabled inline-flex items-center gap-2"
                                disabled aria-disabled="true" title="A signature request is out on this document.">
                            <i class="ti ti-clock text-base leading-none" aria-hidden="true"></i>
                            Awaiting signatures
                        </button>
                    {% elseif document.isSigned %}
                        {# Blocked, not removed: the action stays visible so its
                           unavailability reads as "already done", not "missing". #}
                        <button type="button" class="btn btn-primary disabled inline-flex items-center gap-2"
                                disabled aria-disabled="true" title="This document has already been signed.">
                            <i class="ti ti-circle-check text-base leading-none" aria-hidden="true"></i>
                            Signed
                        </button>
                    {% else %}
                        <a href="{{ path('app_document_sign', {id: document.id}) }}"
                           class="btn btn-primary inline-flex items-center gap-2">
                            <i class="ti ti-signature text-base leading-none" aria-hidden="true"></i>
                            Sign
                        </a>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>

    {#
        ── the open signature request ──────────────────────────────────────
        Who has signed, whose turn it is, and the owner's way out of it. Signers
        get read access one turn at a time, so this list is also the access list.
    #}
    {% set signingRequest = pending_signing_request(document) %}
    {% if signingRequest %}
        <div class="mt-6">
            <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Signature request</h2>
                {% if isOwner %}
                    {% set cancelForm = signing_cancel_form(document) %}
                    <div data-controller="confirm" class="contents">
                        <button type="button" data-action="confirm#open"
                                class="btn btn-sm btn-outline-danger inline-flex items-center gap-1.5">
                            <i class="ti ti-x text-sm leading-none" aria-hidden="true"></i>
                            Withdraw request
                        </button>

                        <div data-confirm-target="dialog" tabindex="-1" aria-hidden="true"
                             data-action="click->confirm#backdropClose keydown.esc@window->confirm#close"
                             class="hidden overflow-y-auto overflow-x-hidden fixed inset-0 z-[1050] flex justify-center items-center w-full h-full bg-theme-headings/40 backdrop-blur-sm modal-backdrop-fade">
                            <div data-confirm-target="card" class="relative w-full max-w-md p-6 m-5 glass-card !bg-white sm:!bg-white/90 modal-card">
                                <div class="inline-flex w-11 h-11 items-center justify-center rounded-lg bg-danger-500/10 text-danger-600 mb-4">
                                    <i class="ti ti-x text-xl leading-none" aria-hidden="true"></i>
                                </div>
                                <h2 class="text-lg font-semibold text-theme-headings mb-2">Withdraw this request?</h2>
                                <p class="text-sm text-theme-secondarytextcolor leading-relaxed mb-5">
                                    Nobody else will be asked to sign, and whoever holds the turn loses access to the
                                    document. Signatures already collected are kept.
                                </p>
                                {{ form_start(cancelForm, {
                                    action: path('app_signing_request_cancel', {id: document.id}),
                                    attr: {class: 'flex gap-2.5'}
                                }) }}
                                    <button type="button" data-action="confirm#close" class="btn btn-outline-secondary flex-1">Keep it</button>
                                    <button type="submit" class="btn btn-danger flex-1">Withdraw</button>
                                {{ form_end(cancelForm) }}
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
            {{ signing.signer_queue(signingRequest) }}
            {{ signing.deadline_note(signingRequest) }}
        </div>
    {% endif %}

    {#
        ── draft callout ───────────────────────────────────────────────────
        A stored document is not a finished one. While it is a Draft, say so and
        show both ways out: sign it yourself (the button above), or send it to
        other people.
    #}
    {% if status.draft and isOwner %}
        <div class="mt-4 rounded-lg border border-warning-500/25 bg-warning-500/[0.06] p-4 sm:p-5">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-5">
                <div class="flex items-start gap-3">
                    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-warning-500/15 text-warning-600">
                        <i class="ti {{ status.iconClass }} text-lg leading-none" aria-hidden="true"></i>
                    </span>
                    <div class="min-w-0">
                        <p class="text-sm font-bold text-theme-headings">This document is still a draft</p>
                        <p class="mt-0.5 text-sm text-theme-secondarytextcolor">{{ status.hint }}</p>
                    </div>
                </div>
                <a href="{{ path('app_document_sign', {id: document.id}) }}"
                   class="btn btn-outline-secondary inline-flex shrink-0 items-center gap-2 self-start sm:self-auto">
                    <i class="ti ti-signature text-base leading-none" aria-hidden="true"></i>
                    Sign it yourself
                </a>
            </div>
        </div>
    {% endif %}

    {#
        ── send for signature ──────────────────────────────────────────────
        Owner only, and only ever once: a document gets a single request in its
        life, so once one has closed the panel stays but the action is spent.
        Sending is also the only way to put a document in someone else's hands -
        Sigil has no plain "share" any more.
    #}
    {% if isOwner and not signingRequest %}
        {% set canRequest = can_request_signatures(document) %}
        <div id="request" class="mt-6">
            <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Send for signature</h2>
            <div class="card !mb-0 !bg-white/90 p-5">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-start gap-3">
                        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg {{ canRequest ? 'bg-primary-500/10 text-primary-500' : 'bg-theme-activebg text-theme-secondarytextcolor' }}">
                            <i class="ti ti-send text-xl leading-none" aria-hidden="true"></i>
                        </span>
                        <div class="min-w-0">
                            {% if canRequest %}
                                <p class="text-sm font-bold text-theme-headings">Ask other people to sign this</p>
                                <p class="mt-0.5 text-sm text-theme-secondarytextcolor">
                                    Choose the signers and the order they sign in. Each one is handed the document only when their turn comes, and you get a sealed delivery receipt when it closes.
                                </p>
                            {% else %}
                                <p class="text-sm font-bold text-theme-headings">This document has already been through a signature request</p>
                                <p class="mt-0.5 text-sm text-theme-secondarytextcolor">
                                    A document is sent for signature once. Its outcome is sealed into the delivery receipt below, and reopening the queue would sign a different version than the receipt attests. Upload the file again to start a new one.
                                </p>
                            {% endif %}
                        </div>
                    </div>
                    {% if canRequest %}
                        <a href="{{ path('app_signing_request_new', {id: document.id}) }}"
                           class="btn btn-primary inline-flex shrink-0 items-center justify-center gap-2">
                            <i class="ti ti-send text-base leading-none" aria-hidden="true"></i>
                            Request signatures
                        </a>
                    {% else %}
                        <button type="button" class="btn btn-primary disabled inline-flex shrink-0 items-center justify-center gap-2"
                                disabled aria-disabled="true">
                            <i class="ti ti-check text-base leading-none" aria-hidden="true"></i>
                            Sent once
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endif %}

    {#
        ── deliver ─────────────────────────────────────────────────────────
        Owner only, and repeatable - a document can be served on as many people
        as you like, as many times as you like. Unlike a signature request this
        asks nothing of anyone, so there is no queue and no state to be in.
    #}
    {% if isOwner %}
        <div id="deliver" class="mt-6">
            <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Deliver</h2>
            <div class="card !mb-0 !bg-white/90 p-5">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                    <div class="flex items-start gap-3">
                        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-500/10 text-primary-500">
                            <i class="ti ti-mail-forward text-xl leading-none" aria-hidden="true"></i>
                        </span>
                        <div class="min-w-0">
                            <p class="text-sm font-bold text-theme-headings">Serve this on someone</p>
                            <p class="mt-0.5 text-sm text-theme-secondarytextcolor">
                                Registered mail: they get the document, nothing is asked of them, and you get a sealed receipt naming who was served and when.
                            </p>
                        </div>
                    </div>
                    <a href="{{ path('app_delivery_new', {id: document.id}) }}"
                       class="btn btn-outline-secondary inline-flex shrink-0 items-center justify-center gap-2">
                        <i class="ti ti-mail-forward text-base leading-none" aria-hidden="true"></i>
                        Deliver
                    </a>
                </div>
            </div>
        </div>
    {% endif %}

    {#
        ── deliveries made ─────────────────────────────────────────────────
        Reached through a Twig function like every other cross-module panel.
    #}
    {% set deliveries = isOwner ? document_deliveries(document) : [] %}
    {% if deliveries is not empty %}
        <div id="deliveries" class="mt-6">
            <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Delivered to</h2>
            <div class="card !mb-0 overflow-hidden !bg-white/90">
                <ul class="divide-y divide-theme-border/60">
                    {% for delivery in deliveries %}
                        {% for recipient in delivery.recipients %}
                            <li class="flex flex-wrap items-center gap-x-4 gap-y-2 p-5">
                                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-500/10 text-primary-500">
                                    <i class="ti ti-mail-forward text-base leading-none" aria-hidden="true"></i>
                                </span>
                                <span class="min-w-0 flex-1">
                                    <span class="block truncate text-sm font-semibold text-theme-headings">{{ recipient.user.fullName }}</span>
                                    <span class="block truncate text-xs text-theme-secondarytextcolor">{{ recipient.user.email }}</span>
                                </span>
                                <span class="shrink-0 text-right">
                                    <span class="block whitespace-nowrap font-mono text-xs text-theme-bodycolor">{{ recipient.deliveredAt|date('d M Y, H:i:s') }}</span>
                                    <span class="block text-[11px] text-theme-secondarytextcolor">served v{{ recipient.version.versionNumber }}</span>
                                </span>
                            </li>
                        {% endfor %}
                        {% if delivery.note %}
                            <li class="bg-theme-activebg/40 px-5 py-3 text-xs italic leading-relaxed text-theme-secondarytextcolor">
                                "{{ delivery.note }}"
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
            <p class="mt-3 text-xs text-theme-secondarytextcolor">A delivery cannot be taken back. Each one is attested by a sealed receipt below.</p>
        </div>
    {% endif %}

    {#
        ── signatures ──────────────────────────────────────────────────────
        Who has signed, to the second. Comes from the Signing module through a
        Twig function, like the panels above: a signature made through a request
        carries its own timestamp, a document the owner signed alone is dated by
        the version it produced.
    #}
    {% set signatures = document_signatures(document) %}
    {% if signatures is not empty %}
        <div class="mt-6">
            <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">
                Signatures
                <span class="ml-1 font-bold normal-case tracking-normal text-theme-headings">{{ signatures|length }}</span>
            </h2>
            <div class="card !mb-0 overflow-hidden !bg-white/90">
                <ol class="divide-y divide-theme-border/60">
                    {% for signature in signatures %}
                        <li class="flex flex-wrap items-center gap-x-4 gap-y-2 p-5">
                            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-success-500/10 text-success-600">
                                <i class="ti ti-circle-check text-base leading-none" aria-hidden="true"></i>
                            </span>
                            <span class="min-w-0 flex-1">
                                <span class="block truncate text-sm font-semibold text-theme-headings">{{ signature.user.fullName }}</span>
                                <span class="block truncate text-xs text-theme-secondarytextcolor">{{ signature.user.email }}</span>
                            </span>
                            <span class="shrink-0 text-right">
                                {# Seconds matter: this is the evidentiary record, not a feed. #}
                                <span class="block whitespace-nowrap font-mono text-xs text-theme-bodycolor">{{ signature.signedAt|date('d M Y, H:i:s') }}</span>
                                <span class="block text-[11px] text-theme-secondarytextcolor">
                                    v{{ signature.versionNumber }} · {{ signature.viaRequest ? 'by request' : 'signed by the owner' }}
                                </span>
                            </span>
                        </li>
                    {% endfor %}
                </ol>
            </div>
        </div>
    {% endif %}

    {# ── versions timeline ──────────────────────────────────────────────── #}
    <div class="mt-6">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Versions</h2>
        <div class="card !mb-0 overflow-hidden !bg-white/90">
            <ul class="divide-y divide-theme-border/60">
                {% for v in document.versions|reverse %}
                    {# Stacks on mobile (badge row, fingerprint row, then a full-width
                       download button); from sm: single row with the button at the end. #}
                    <li class="p-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-x-4">
                        <div class="flex min-w-0 flex-1 items-start gap-3">
                            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-500/10 text-xs font-bold text-primary-500">v{{ v.versionNumber }}</span>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                    {{ docs.status_badge(v.kind) }}
                                    <span class="text-sm text-theme-secondarytextcolor whitespace-nowrap">{{ docs.filesize(v.sizeBytes) }} · {{ v.createdAt|date('d M Y, H:i') }}</span>
                                </div>
                                <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1" data-controller="clipboard" data-clipboard-text-value="{{ v.contentHash }}">
                                    <span class="text-[11px] font-medium uppercase tracking-wide text-theme-secondarytextcolor">Integrity fingerprint</span>
                                    <code class="rounded bg-theme-activebg px-1.5 py-0.5 font-mono text-xs text-theme-bodycolor whitespace-nowrap">{{ v.contentHash|slice(0, 10) }}…{{ v.contentHash|slice(-6) }}</code>
                                    <button type="button" data-action="clipboard#copy"
                                            class="inline-flex items-center gap-1 text-xs font-medium text-theme-secondarytextcolor hover:text-theme-headings cursor-pointer">
                                        <i class="ti ti-copy text-sm leading-none" aria-hidden="true"></i>
                                        Copy
                                    </button>
                                    <span data-clipboard-target="feedback" hidden class="text-xs font-medium text-success-600">Copied!</span>
                                </div>
                            </div>
                        </div>
                        <a href="{{ path('app_document_version_download', {id: document.id, number: v.versionNumber}) }}" data-turbo="false"
                           class="btn btn-sm btn-primary inline-flex items-center justify-center gap-1.5 w-full sm:w-auto shrink-0">
                            <i class="ti ti-download text-sm leading-none" aria-hidden="true"></i>
                            Download
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
        <p class="mt-3 text-xs text-theme-secondarytextcolor">Every version is kept. The original and each future signed copy for a complete, tamper-evident record.</p>
    </div>

    {# ── delivery receipts ──────────────────────────────────────────────── #}
    {# Reached through a Twig function, like the signing panel above it: the
       Document module does not depend on Receipt. #}
    {% set receipts = document_receipts(document) %}
    {% if receipts is not empty %}
        <div class="mt-6">
            <h2 class="mb-3 text-sm font-bold uppercase tracking-wider text-theme-secondarytextcolor">Delivery receipts</h2>
            <div class="card !mb-0 overflow-hidden !bg-white/90">
                <ul class="divide-y divide-theme-border/60">
                    {% for receipt in receipts %}
                        <li class="flex flex-col gap-3 p-5 sm:flex-row sm:items-center sm:gap-x-4">
                            <div class="flex min-w-0 flex-1 items-start gap-3">
                                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-500/10 text-primary-500">
                                    <i class="ti ti-receipt text-base leading-none" aria-hidden="true"></i>
                                </span>
                                <div class="min-w-0">
                                    <p class="text-sm font-semibold text-theme-headings">Sealed {{ receipt.sealedAt|date('d M Y, H:i') }}</p>
                                    <p class="mt-0.5 text-xs text-theme-secondarytextcolor">Outcome: {{ receipt.outcome.label }} · {{ docs.filesize(receipt.sizeBytes) }}</p>
                                </div>
                            </div>
                            <a href="{{ path('app_receipt_download', {id: receipt.id}) }}" data-turbo="false"
                               class="btn btn-sm btn-outline-secondary inline-flex w-full shrink-0 items-center justify-center gap-1.5 sm:w-auto">
                                <i class="ti ti-download text-sm leading-none" aria-hidden="true"></i>
                                Download
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
            <p class="mt-3 text-xs text-theme-secondarytextcolor">Sigil's sealed record of who the document reached, when, and what became of it.</p>
        </div>
    {% endif %}
</div>
{% endblock %}
