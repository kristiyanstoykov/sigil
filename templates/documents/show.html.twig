{% extends 'layout/app.html.twig' %}
{% import 'documents/_macros.html.twig' as docs %}

{% block title %}{{ document.title }} · Sigil{% endblock %}
{% block main_class %}docs-gradient{% endblock %}

{#
    One file's whole life, in four tabs. Overview answers "where is it and what
    can still happen to it"; the other three are the record - every version, the
    signature request it had, and the receipts sealed over it.

    Everything from another module arrives through a Twig function, never a
    controller variable: Document depends on neither Signing, Delivery nor
    Receipt.
#}
{% block content %}
{% set latest = document.latestVersion %}
{% set status = document_status(document) %}
{% set signingRequest = pending_signing_request(document) %}
{% set closedRequest = document_signing_request(document) %}
{% set receipts = document_receipts(document) %}
{% set isTurn = signingRequest and not isOwner and signingRequest.isTurnOf(app.user) %}

<div class="docs-rise mx-auto max-w-4xl">

    <a href="{{ path('app_documents', isOwner ? {} : {role: 'others'}) }}" class="mb-4 inline-flex items-center gap-1.5 text-sm font-medium text-theme-secondarytextcolor hover:text-theme-headings">
        <i class="ti ti-chevron-left text-base leading-none" aria-hidden="true"></i>
        Documents
    </a>

    {# ── header card ────────────────────────────────────────────────────── #}
    <div class="card !mb-0 !bg-white/90 p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex min-w-0 items-start gap-4">
                {{ docs.pdf_icon('lg') }}
                <div class="min-w-0">
                    <h1 class="text-xl font-extrabold tracking-tight text-theme-headings [overflow-wrap:anywhere]">{{ document.title }}</h1>
                    <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-theme-secondarytextcolor">
                        <span>Uploaded {{ (latest ? latest.createdAt : document.createdAt)|date('d M Y') }}</span>
                        {% if not isOwner %}
                            <span class="text-theme-border">·</span>
                            <span class="inline-flex items-center gap-1.5">
                                <i class="ti ti-user text-xs leading-none" aria-hidden="true"></i>
                                Sent by {{ document.owner.fullName }}
                            </span>
                        {% endif %}
                        {% if latest %}
                            <span class="text-theme-border">·</span>
                            <span>{{ docs.filesize(latest.sizeBytes) }} · v{{ latest.versionNumber }}</span>
                        {% endif %}
                    </div>
                    <div class="mt-2.5 flex flex-wrap items-center gap-2">
                        {{ docs.doc_status_badge(status) }}
                        {{ docs.role_badge(document, isOwner) }}
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-success-500/20 bg-success-500/10 px-2.5 py-0.5 text-xs font-semibold text-success-600">
                            <i class="ti ti-lock text-xs leading-none" aria-hidden="true"></i>
                            Encrypted at rest
                        </span>
                    </div>
                </div>
            </div>

            {#
                Download and View are always there; the third button is whatever
                this state's one move is - deciding a draft's purpose, withdrawing
                an open request, delivering a signed file, or nothing at all.
            #}
            <div class="flex flex-wrap items-center gap-2">
                <a href="{{ path('app_document_download', {id: document.id}) }}" data-turbo="false"
                   class="btn btn-outline-secondary inline-flex items-center gap-2">
                    <i class="ti ti-download text-base leading-none" aria-hidden="true"></i>
                    Download
                </a>
                <a href="{{ path('app_document_view', {id: document.id}) }}" target="_blank" rel="noopener" data-turbo="false"
                   class="btn btn-outline-secondary inline-flex items-center gap-2">
                    <i class="ti ti-eye text-base leading-none" aria-hidden="true"></i>
                    View
                </a>
                {% if isTurn %}
                    <a href="{{ path('app_document_sign', {id: document.id}) }}"
                       class="btn btn-primary inline-flex items-center gap-2">
                        <i class="ti ti-signature text-base leading-none" aria-hidden="true"></i>
                        Read &amp; sign
                    </a>
                {% elseif isOwner %}
                    {% if status.delivered %}
                        <button type="button" class="btn btn-primary disabled inline-flex items-center gap-2"
                                disabled aria-disabled="true" title="This document has been delivered and is final.">
                            <i class="ti ti-mail-forward text-base leading-none" aria-hidden="true"></i>
                            Delivered
                        </button>
                    {% elseif signingRequest %}
                        {{ include('documents/_withdraw_button.html.twig') }}
                    {% elseif status.draft %}
                        <a href="{{ path('app_document_sign', {id: document.id}) }}"
                           class="btn btn-primary inline-flex items-center gap-2">
                            <i class="ti ti-signature text-base leading-none" aria-hidden="true"></i>
                            Decide what it's for
                        </a>
                    {% else %}
                        <a href="{{ path('app_delivery_new', {id: document.id}) }}"
                           class="btn btn-primary inline-flex items-center gap-2">
                            <i class="ti ti-mail-forward text-base leading-none" aria-hidden="true"></i>
                            Deliver
                        </a>
                    {% endif %}
                {% endif %}
            </div>
        </div>
    </div>

    {# ── tabs ───────────────────────────────────────────────────────────── #}
    {% set tabs = {
        'overview': {label: 'Overview', count: 0},
        'versions': {label: 'Versions', count: document.versions|length},
        'history':  {label: 'History',  count: closedRequest ? 1 : 0},
        'receipts': {label: 'Receipts', count: receipts|length},
    } %}
    <div class="mb-5 mt-6 flex items-center gap-6 overflow-x-auto border-b border-theme-border">
        {% for key, meta in tabs %}
            <a href="{{ path('app_document_show', key == 'overview' ? {id: document.id} : {id: document.id, tab: key}) }}"
               class="inline-flex shrink-0 items-center gap-2 pb-3 text-sm font-semibold {{ tab == key
                   ? 'border-b-2 border-primary-500 text-primary-500'
                   : 'text-theme-secondarytextcolor hover:text-theme-headings' }}">
                {{ meta.label }}
                {% if meta.count %}
                    <span class="rounded-full bg-theme-activebg px-2 py-0.5 text-[11px] font-bold text-theme-secondarytextcolor">{{ meta.count }}</span>
                {% endif %}
            </a>
        {% endfor %}
    </div>

    {% if tab == 'versions' %}
        {{ include('documents/_tab_versions.html.twig') }}
    {% elseif tab == 'history' %}
        {{ include('documents/_tab_history.html.twig', {request: closedRequest}) }}
    {% elseif tab == 'receipts' %}
        {{ include('documents/_tab_receipts.html.twig') }}
    {% else %}
        {{ include('documents/_tab_overview.html.twig') }}
    {% endif %}
</div>
{% endblock %}
