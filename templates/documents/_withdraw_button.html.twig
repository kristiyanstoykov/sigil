{#
    Withdrawing the open request, from the document page. The twin of the Sent
    tab's button - two pages, two return targets, one service underneath.

    Context: document.
#}
{% set cancelForm = signing_cancel_form(document) %}
<button type="button" data-pc-toggle="modal" data-pc-target="#withdraw-{{ document.id }}"
        class="btn btn-outline-danger inline-flex items-center gap-2">
    <i class="ti ti-arrow-back-up text-base leading-none" aria-hidden="true"></i>
    Withdraw request
</button>

{% embed 'components/modal.html.twig' with {id: 'withdraw-' ~ document.id, icon: 'ti-arrow-back-up', title: 'Withdraw this request?'} %}
    {% block content %}
        {{ form_start(cancelForm, {
            action: path('app_signing_request_cancel', {id: document.id}),
            attr: {class: 'contents'}
        }) }}
            <div class="modal-body">
                <p class="text-sm leading-relaxed text-theme-secondarytextcolor">
                    Nobody else will be asked to sign, and whoever holds the turn loses access to the
                    document. Signatures already collected are kept.
                </p>
            </div>
            <div class="modal-footer gap-2">
                <button type="button" data-pc-modal-dismiss="#withdraw-{{ document.id }}" class="btn btn-outline-secondary">Keep it</button>
                <button type="submit" class="btn btn-danger">Withdraw</button>
            </div>
        {{ form_end(cancelForm) }}
    {% endblock %}
{% endembed %}
