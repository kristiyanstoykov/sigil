{#
    Shared Documents macros. Import with:
      {% import 'documents/_macros.html.twig' as docs %}
#}

{% macro filesize(bytes) %}
{%- if bytes < 1024 -%}{{ bytes }} B
{%- elseif bytes < 1048576 -%}{{ (bytes / 1024)|round }} KB
{%- else -%}{{ (bytes / 1048576)|number_format(1) }} MB
{%- endif -%}
{% endmacro %}

{#
    A single version's kind - Original or Signed. Describes bytes, not the
    document's lifecycle; for that use doc_status_badge below.
#}
{% macro status_badge(kind) %}
    {% set signed = kind.value == 'signed' %}
    <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold
                 {{ signed ? 'border-success-500/20 bg-success-500/10 text-success-600' : 'border-theme-border bg-theme-activebg text-theme-bodycolor' }}">
        {{ signed ? 'Signed' : 'Original' }}
    </span>
{% endmacro %}

{#
    The document's own state (DocumentDisplayStatus): Draft until it carries a
    Sigil signature. Label and colors come from the enum - see
    src/Document/Enum/DocumentDisplayStatus.php.
#}
{% macro doc_status_badge(status) %}
    <span class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold {{ status.badgeClass }}">
        <span class="h-1.5 w-1.5 rounded-full {{ status.dotClass }}" aria-hidden="true"></span>
        {{ status.label }}
    </span>
{% endmacro %}

{#
    Why a row is visible at all. With no plain sharing left there are three ways:
    you own it, a signature request reached you, or it was delivered to you.
    Delivery and signing both leave a DocumentKeyGrant, so only the delivery
    record tells them apart.
#}
{% macro role_badge(document, owned) %}
    {% set role = owned
        ? {label: 'Owner', icon: 'ti-user', classes: 'bg-theme-activebg text-theme-bodycolor'}
        : (was_delivered_to_me(document)
            ? {label: 'Recipient', icon: 'ti-mail-forward', classes: 'bg-primary-500/10 text-primary-500'}
            : {label: 'Signer', icon: 'ti-signature', classes: 'bg-info-500/10 text-info-600'}) %}
    <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold {{ role.classes }}">
        <i class="ti {{ role.icon }} text-xs leading-none" aria-hidden="true"></i>
        {{ role.label }}
    </span>
{% endmacro %}

{% macro pdf_icon(size) %}
    <span class="inline-flex items-center justify-center rounded-lg bg-danger-500/10 text-danger-600 {{ size == 'lg' ? 'w-11 h-11' : 'w-9 h-9' }}">
        <i class="ti ti-file-text {{ size == 'lg' ? 'text-xl' : 'text-base' }} leading-none" aria-hidden="true"></i>
    </span>
{% endmacro %}

{#
    Row overflow menu. Rendered via the `menu` Stimulus controller, which moves
    the menu into <body> with fixed positioning on open so the table's overflow
    never clips it.

    `owned` is false on the "Shared with me" tab: you can read the document
    because a signing request reached you, nothing more.
#}
{% macro row_menu(document, owned = true) %}
    <div data-controller="menu" class="inline-block">
        <button type="button" data-action="menu#toggle" data-menu-target="button"
                class="inline-flex items-center justify-center w-8 h-8 rounded-lg border border-theme-border bg-white text-theme-secondarytextcolor hover:bg-theme-activebg">
            <span class="sr-only">More actions</span>
            <i class="ti ti-dots-vertical text-base leading-none" aria-hidden="true"></i>
        </button>
        <div data-menu-target="menu" class="hidden w-60 rounded-lg border border-theme-border bg-white p-1.5 shadow-xl">
            <a href="{{ path('app_document_view', {id: document.id}) }}" target="_blank" rel="noopener" data-turbo="false"
               class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-theme-bodycolor hover:bg-theme-activebg">
                <i class="ti ti-eye text-base leading-none" aria-hidden="true"></i>
                View
            </a>
            {% if not owned %}
                {# Shared with me: read-only. View above is the whole menu. #}
            {% else %}
            <div class="my-1 border-t border-theme-border/60"></div>
            {# The two ways a document gets signed: sign it yourself, or send it
               to other people. While a request is out both are the queue's call,
               so neither is offered here. #}
            {% set status = document_status(document) %}
            {% if status.pending %}
                <span class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-info-600/80 cursor-not-allowed" title="A signature request is out on this document.">
                    <i class="ti ti-clock text-base leading-none" aria-hidden="true"></i>
                    Awaiting signatures
                </span>
            {% elseif status.signed %}
                <span class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-success-600/70 cursor-not-allowed" title="This document has already been signed.">
                    <i class="ti ti-circle-check text-base leading-none" aria-hidden="true"></i>
                    Signed
                </span>
            {% else %}
                <a href="{{ path('app_document_sign', {id: document.id}) }}"
                   class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-theme-bodycolor hover:bg-theme-activebg">
                    <i class="ti ti-signature text-base leading-none" aria-hidden="true"></i>
                    Sign yourself
                </a>
                {# One request per document, ever - a declined or expired one has
                   already spent it, and its receipt names a fixed outcome. #}
                {% if can_request_signatures(document) %}
                    <a href="{{ path('app_signing_request_new', {id: document.id}) }}"
                       class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-theme-bodycolor hover:bg-theme-activebg">
                        <i class="ti ti-send text-base leading-none" aria-hidden="true"></i>
                        Request a signature
                    </a>
                {% else %}
                    <span class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-theme-secondarytextcolor/60 cursor-not-allowed" title="This document has already been through a signature request.">
                        <i class="ti ti-send text-base leading-none" aria-hidden="true"></i>
                        Request a signature
                    </span>
                {% endif %}
            {% endif %}
            <span class="flex items-center gap-2.5 rounded-md px-2.5 py-2 text-sm font-medium text-theme-secondarytextcolor/60 cursor-not-allowed" title="Coming soon">
                <i class="ti ti-trash text-base leading-none" aria-hidden="true"></i>
                Delete
                <span class="ml-auto text-[10px] font-bold uppercase tracking-wide">Soon</span>
            </span>
            {% endif %}
        </div>
    </div>
{% endmacro %}
