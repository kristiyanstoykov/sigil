{% extends 'auth/base_auth.html.twig' %}

{% block title %}Verify your email — Sigil{% endblock %}

{% block card %}
    <h2 class="text-lg font-bold mb-1.5 text-body">Verify your email address</h2>
    <p class="text-[13px] leading-relaxed mb-5 text-muted">
        Your account isn't verified yet. Enter your email address and we'll send you a new confirmation link.
    </p>

    <form method="post" class="space-y-4">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('resend_verification') }}">

        <div>
            <label for="email" class="block text-[12.5px] font-semibold mb-1.5 text-label">
                Email address
            </label>
            <input
                type="email"
                id="email"
                name="email"
                value="{{ prefill_email }}"
                placeholder="you@company.com"
                autocomplete="email"
                required
                class="form-input"
            >
        </div>

        <button type="submit" class="btn-primary mt-2">Send confirmation link</button>
    </form>
{% endblock %}

{% block footer %}
    <p class="mt-5 text-center text-[13px] text-muted">
        Already verified?
        <a href="{{ path('app_login') }}" class="font-semibold text-primary hover:text-primary-hover transition-colors">
            Sign in
        </a>
    </p>
{% endblock %}
