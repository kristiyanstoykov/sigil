{% extends 'auth/base_auth.html.twig' %}

{% block title %}Verify your email - Sigil{% endblock %}

{% block card %}
    <h1 class="text-lg font-bold text-theme-headings mb-2">Verify your email address</h1>
    <p class="text-sm text-theme-secondarytextcolor leading-relaxed mb-5">
        Your account isn't verified yet. Enter your email address and we'll send you a new confirmation link.
    </p>

    <form method="post" class="space-y-4">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('resend_verification') }}">

        <div>
            <label for="email" class="form-label text-sm font-semibold">Email address</label>
            <input type="email" id="email" name="email" value="{{ prefill_email }}"
                   placeholder="you@company.com" autocomplete="email" required
                   class="form-control !bg-white/60 !border-theme-headings/10 focus:!bg-white/85">
        </div>

        <button type="submit"
                class="btn btn-primary w-full bg-linear-to-b from-primary-600 to-primary-500 shadow-lg shadow-primary-500/30 hover:-translate-y-px transition">
            Send confirmation link
        </button>
    </form>
{% endblock %}

{% block footer %}
    <p class="mt-5 text-center text-sm text-theme-secondarytextcolor">
        Already verified?
        <a href="{{ path('app_login') }}" class="font-semibold text-primary-500 hover:underline">Sign in</a>
    </p>
{% endblock %}
