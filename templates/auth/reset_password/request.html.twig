{% extends 'auth/base_auth.html.twig' %}

{% block title %}Reset password — Sigil{% endblock %}

{% block card %}
    <h2 class="text-lg font-bold mb-1.5 text-body">Reset your password</h2>
    <p class="text-[13px] leading-relaxed mb-5 text-muted">
        Enter your email address and we'll send you a link to choose a new password.
    </p>

    {% for message in app.flashes('reset_password_error') %}
        <div class="mb-4 px-4 py-3 rounded-btn text-sm bg-danger/10 text-danger border border-danger/20">
            {{ message }}
        </div>
    {% endfor %}

    {{ form_start(requestForm, {attr: {class: 'space-y-4', novalidate: 'novalidate'}}) }}
        {% set field_email = constant('App\\Auth\\Form\\ResetPasswordRequestForm::E_EMAIL') %}
        <div>
            {{ form_label(requestForm[field_email], null, {label_attr: {class: 'block text-[12.5px] font-semibold mb-1.5 text-label'}}) }}
            {{ form_widget(requestForm[field_email], {attr: {class: 'form-input', placeholder: 'you@company.com'}}) }}
            {{ form_errors(requestForm[field_email]) }}
        </div>

        <button type="submit" class="btn-primary mt-2">Send password reset link</button>
    {{ form_end(requestForm) }}
{% endblock %}

{% block footer %}
    <p class="mt-5 text-center text-[13px] text-muted">
        Remembered it?
        <a href="{{ path('app_login') }}" class="font-semibold text-primary hover:text-primary-hover transition-colors">
            Back to sign in
        </a>
    </p>
{% endblock %}
