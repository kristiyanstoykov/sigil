{% extends 'auth/base_auth.html.twig' %}

{% block title %}Reset password - Sigil{% endblock %}

{% block card %}
    <h1 class="text-xl font-bold leading-tight tracking-tight text-gray-900 mb-2">Reset your password</h1>
    <p class="text-sm text-gray-500 leading-relaxed mb-5">
        Enter your email address and we'll send you a link to choose a new password.
    </p>

    {% for message in app.flashes('reset_password_error') %}
        <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200" role="alert">
            {{ message }}
        </div>
    {% endfor %}

    {{ form_start(requestForm, {attr: {class: 'space-y-4', novalidate: 'novalidate'}}) }}
        {% set field_email = constant('App\\Auth\\Form\\ResetPasswordRequestForm::E_EMAIL') %}
        <div>
            {{ form_label(requestForm[field_email], null, {label_attr: {class: 'block mb-2 text-sm font-medium text-gray-900'}}) }}
            {{ form_widget(requestForm[field_email], {attr: {class: 'bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 text-sm', placeholder: 'you@company.com'}}) }}
            {{ form_errors(requestForm[field_email]) }}
        </div>

        <button type="submit"
                class="w-full text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center cursor-pointer">
            Send password reset link
        </button>
    {{ form_end(requestForm) }}
{% endblock %}

{% block footer %}
    <p class="mt-5 text-center text-sm font-light text-gray-500">
        Remembered it?
        <a href="{{ path('app_login') }}" class="font-medium text-primary-600 hover:underline">Back to sign in</a>
    </p>
{% endblock %}
