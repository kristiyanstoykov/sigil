{% extends 'auth/base_auth.html.twig' %}

{% block title %}Reset password - Sigil{% endblock %}

{% block card %}
    <h1 class="text-lg font-bold text-theme-headings mb-2">Reset your password</h1>
    <p class="text-sm text-theme-secondarytextcolor leading-relaxed mb-5">
        Enter your email address and we'll send you a link to choose a new password.
    </p>

    {% for message in app.flashes('reset_password_error') %}
        <div class="alert alert-danger text-sm" role="alert">
            {{ message }}
        </div>
    {% endfor %}

    {{ form_start(requestForm, {attr: {class: 'space-y-4', novalidate: 'novalidate'}}) }}
        {% set field_email = constant('App\\Auth\\Form\\ResetPasswordRequestForm::E_EMAIL') %}
        <div>
            {{ form_label(requestForm[field_email], null, {label_attr: {class: 'form-label text-sm font-semibold'}}) }}
            {{ form_widget(requestForm[field_email], {attr: {class: 'form-control !bg-white/60 !border-theme-headings/10 focus:!bg-white/85', placeholder: 'you@company.com'}}) }}
            {{ form_errors(requestForm[field_email]) }}
        </div>

        <button type="submit"
                class="btn btn-primary w-full bg-linear-to-b from-primary-600 to-primary-500 shadow-lg shadow-primary-500/30 hover:-translate-y-px transition">
            Send password reset link
        </button>
    {{ form_end(requestForm) }}
{% endblock %}

{% block footer %}
    <p class="mt-5 text-center text-sm text-theme-secondarytextcolor">
        Remembered it?
        <a href="{{ path('app_login') }}" class="font-semibold text-primary-500 hover:underline">Back to sign in</a>
    </p>
{% endblock %}
