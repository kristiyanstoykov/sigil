{% extends 'auth/base_auth.html.twig' %}

{% block title %}Choose a new password - Sigil{% endblock %}

{% block card %}
    <h1 class="text-lg font-bold text-theme-headings mb-5">Choose a new password</h1>

    {{ form_start(resetForm, {attr: {class: 'space-y-4', novalidate: 'novalidate'}}) }}
        {% set field_password = constant('App\\Auth\\Form\\ChangePasswordForm::E_PASSWORD') %}
        {% set label_class = 'form-label text-sm font-semibold' %}
        {% set input_class = 'form-control !bg-white/60 !border-theme-headings/10 focus:!bg-white/85' %}

        <div>
            {{ form_label(resetForm[field_password].first, null, {label_attr: {class: label_class}}) }}
            {{ form_widget(resetForm[field_password].first, {attr: {class: input_class}}) }}
        </div>

        <div>
            {{ form_label(resetForm[field_password].second, null, {label_attr: {class: label_class}}) }}
            {{ form_widget(resetForm[field_password].second, {attr: {class: input_class}}) }}
            {{ form_errors(resetForm[field_password]) }}
            {{ form_errors(resetForm[field_password].first) }}
        </div>

        <p class="text-xs text-theme-secondarytextcolor">Minimum 10 characters.</p>

        <button type="submit"
                class="btn btn-primary w-full bg-linear-to-b from-primary-600 to-primary-500 shadow-lg shadow-primary-500/30 hover:-translate-y-px transition">
            Save new password
        </button>
    {{ form_end(resetForm) }}
{% endblock %}
