{% extends 'auth/base_auth.html.twig' %}

{% block title %}Check your email - Sigil{% endblock %}

{% block card %}
    <h1 class="text-lg font-bold text-theme-headings mb-2">Check your email</h1>
    <p class="text-sm text-theme-secondarytextcolor leading-relaxed">
        If an account matches that email address, we've sent a link to reset your password. The link will
        expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
    </p>
    <p class="text-sm text-theme-secondarytextcolor leading-relaxed mt-3">
        Didn't get it? Check your spam folder, or
        <a href="{{ path('app_forgot_password_request') }}" class="font-semibold text-primary-500 hover:underline">try again</a>.
    </p>
{% endblock %}

{% block footer %}
    <p class="mt-5 text-center text-sm text-theme-secondarytextcolor">
        <a href="{{ path('app_login') }}" class="font-semibold text-primary-500 hover:underline">Back to sign in</a>
    </p>
{% endblock %}
