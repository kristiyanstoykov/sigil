{% extends 'emails/base.html.twig' %}

{% block heading %}Reset your password{% endblock %}
{% block preheader %}Choose a new password for your Sigil account.{% endblock %}

{% block body %}
    <p style="margin:0 0 16px;">We received a request to reset the password for your Sigil account. Click the button below to choose a new one.</p>
{% endblock %}

{% block action_url %}{{ url('app_reset_password', {token: resetToken.token}) }}{% endblock %}
{% block action_label %}Reset my password{% endblock %}

{% block note %}
    This link expires in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
    If you did not request a password reset, you can safely ignore this email - your password will not change.
{% endblock %}
