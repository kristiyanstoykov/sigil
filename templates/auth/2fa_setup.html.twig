{% extends 'auth/base_auth.html.twig' %}

{% block title %}Set up two-factor authentication — Sigil{% endblock %}

{% block subtitle %}Secure your account{% endblock %}

{% block card %}
    <h2 class="text-lg font-bold mb-1.5 text-body">Set up two-factor authentication</h2>
    <p class="text-[13px] leading-relaxed mb-5 text-muted">
        Use Google Authenticator, Authy, or any TOTP app to scan the QR code below. Then enter the 6-digit code to confirm.
    </p>

    <div class="flex justify-center mb-5">
        <div class="p-3 rounded-modal border border-line bg-surface inline-block">
            <img src="{{ qr_code_data_uri }}" alt="TOTP QR code" width="200" height="200">
        </div>
    </div>

    <details class="mb-5 text-[13px] text-muted">
        <summary class="cursor-pointer font-semibold hover:text-primary transition-colors">
            Can't scan the QR code?
        </summary>
        <p class="mt-2 font-mono text-xs break-all p-3 rounded-btn border border-line bg-surface/60">
            {{ provisioning_uri }}
        </p>
    </details>

    <form method="post" class="space-y-4">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('2fa_setup') }}">
        <div>
            <label for="code" class="block text-[12.5px] font-semibold mb-1.5 text-label">
                Verification code
            </label>
            <input
                type="text"
                id="code"
                name="_auth_code"
                inputmode="numeric"
                pattern="[0-9]{6}"
                maxlength="6"
                autocomplete="one-time-code"
                autofocus
                placeholder="000000"
                class="form-input text-center !text-xl tracking-[0.4em] font-mono !py-3"
            >
        </div>

        <button type="submit" class="btn-primary">Enable two-factor authentication</button>
    </form>
{% endblock %}
