{% extends 'auth/base_auth.html.twig' %}

{% block title %}Set up two-factor authentication - Sigil{% endblock %}

{% block subtitle %}Secure your account{% endblock %}

{% block card %}
    <h1 class="text-lg font-bold text-theme-headings mb-2">Set up two-factor authentication</h1>
    <p class="text-sm text-theme-secondarytextcolor leading-relaxed mb-5">
        Use Google Authenticator, Authy, or any TOTP app to scan the QR code below. Then enter the 6-digit code to confirm.
    </p>

    <div class="flex justify-center mb-5">
        <div class="p-3 rounded-lg border border-theme-border bg-white inline-block">
            <img src="{{ qr_code_data_uri }}" alt="TOTP QR code" width="200" height="200">
        </div>
    </div>

    <details class="mb-5 text-sm text-theme-secondarytextcolor">
        <summary class="cursor-pointer font-medium hover:text-primary-500">
            Can't scan the QR code?
        </summary>
        <p class="mt-2 font-mono text-xs break-all p-3 rounded-lg border border-theme-border bg-white/60">
            {{ provisioning_uri }}
        </p>
    </details>

    <form method="post" class="space-y-4">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('2fa_setup') }}">
        <div>
            <label for="code" class="form-label text-sm font-semibold">Verification code</label>
            <input type="text" id="code" name="_auth_code"
                   inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                   autocomplete="one-time-code" autofocus placeholder="000000"
                   class="form-control !bg-white/60 !border-theme-headings/10 focus:!bg-white/85 !p-3 text-center !text-xl tracking-[0.4em] font-mono">
        </div>

        <button type="submit"
                class="btn btn-primary w-full bg-linear-to-b from-primary-600 to-primary-500 shadow-lg shadow-primary-500/30 hover:-translate-y-px transition">
            Enable two-factor authentication
        </button>
    </form>
{% endblock %}
