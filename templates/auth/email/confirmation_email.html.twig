{% extends 'emails/base.html.twig' %}

{% block heading %}Confirm your email address{% endblock %}
{% block preheader %}One click activates your Sigil account.{% endblock %}

{% block body %}
    <p style="margin:0 0 16px;">Welcome to Sigil. Please confirm your email address to activate your account.</p>
{% endblock %}

{% block action_url %}{{ signedUrl }}{% endblock %}
{% block action_label %}Confirm my email{% endblock %}

{% block note %}
    This link expires in {{ expiresAtMessageKey|trans(expiresAtMessageData, 'VerifyEmailBundle') }}.
    If you did not create a Sigil account, you can ignore this message.
{% endblock %}
