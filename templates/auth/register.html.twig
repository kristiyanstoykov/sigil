{% extends 'auth/base_auth.html.twig' %}

{% block title %}Create account - Sigil{% endblock %}

{% block card %}
    <h1 class="text-lg font-bold text-theme-headings mb-5">Create your account</h1>

    {{ form_start(form, {attr: {class: 'space-y-4', novalidate: 'novalidate'}}) }}

    {% set form_class = 'App\\Auth\\Form\\RegistrationForm' %}
    {% set field_password = constant(form_class ~ '::E_PASSWORD') %}
    {% set label_class = 'form-label text-sm font-semibold' %}
    {% set input_class = 'form-control !bg-white/60 !border-theme-headings/10 focus:!bg-white/85' %}

    <div class="flex gap-3">
        {% for field in [constant(form_class ~ '::E_FIRST_NAME'), constant(form_class ~ '::E_LAST_NAME')] %}
            <div class="flex-1">
                {{ form_label(form[field], null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form[field], {attr: {class: input_class}}) }}
                {{ form_errors(form[field]) }}
            </div>
        {% endfor %}
    </div>

    {% set field_email = constant(form_class ~ '::E_EMAIL') %}
    <div>
        {{ form_label(form[field_email], null, {label_attr: {class: label_class}}) }}
        {{ form_widget(form[field_email], {attr: {class: input_class}}) }}
        {{ form_errors(form[field_email]) }}
    </div>

    <div>
        {{ form_label(form[field_password].first, null, {label_attr: {class: label_class}}) }}
        {{ form_widget(form[field_password].first, {attr: {class: input_class}}) }}
    </div>

    <div>
        {{ form_label(form[field_password].second, null, {label_attr: {class: label_class}}) }}
        {{ form_widget(form[field_password].second, {attr: {class: input_class}}) }}
        {{ form_errors(form[field_password]) }}
        {{ form_errors(form[field_password].first) }}
    </div>

    <p class="text-xs text-theme-secondarytextcolor">
        Minimum 10 characters. You will set up two-factor authentication after your first login.
    </p>

    <button type="submit"
            class="btn btn-primary w-full bg-linear-to-b from-primary-600 to-primary-500 shadow-lg shadow-primary-500/30 hover:-translate-y-px transition">
        Create account
    </button>

    {{ form_end(form) }}
{% endblock %}

{% block footer %}
    <p class="mt-5 text-center text-sm text-theme-secondarytextcolor">
        Already have an account?
        <a href="{{ path('app_login') }}" class="font-semibold text-primary-500 hover:underline">Sign in</a>
    </p>
{% endblock %}
