{% extends 'base.html.twig' %}

{% block title %}Create account — Sigil{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center px-4 py-10" style="background-color: var(--sigil-bg);">
    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <img src="{{ asset('images/sigil-blue-900.svg') }}" alt="Sigil" width="78" height="54" class="mx-auto">
            <p class="mt-1 text-sm" style="color: var(--sigil-text-secondary);">Signum Veritatis — Digital Document Signing</p>
        </div>

        <div class="rounded-card border p-8 shadow-sm" style="background-color: var(--sigil-surface); border-color: var(--sigil-border);">
            <h2 class="text-lg font-semibold mb-6" style="color: var(--sigil-text);">Create your account</h2>

            {{ form_start(form, {attr: {class: 'space-y-4', novalidate: 'novalidate'}}) }}

            {% for field in ['firstName', 'lastName', 'email'] %}
                <div>
                    {{ form_label(form[field], null, {label_attr: {class: 'block text-sm font-medium mb-1.5', style: 'color: var(--sigil-text);'}}) }}
                    {{ form_widget(form[field], {attr: {
                        class: 'w-full px-3 py-2 text-sm rounded-btn border outline-none transition-colors focus:border-primary focus:ring-1 focus:ring-primary',
                        style: 'background-color: var(--sigil-input-bg); border-color: var(--sigil-border); color: var(--sigil-text);'
                    }}) }}
                    {{ form_errors(form[field]) }}
                </div>
            {% endfor %}

            <div>
                {{ form_label(form.plainPassword.first, null, {label_attr: {class: 'block text-sm font-medium mb-1.5', style: 'color: var(--sigil-text);'}}) }}
                {{ form_widget(form.plainPassword.first, {attr: {
                    class: 'w-full px-3 py-2 text-sm rounded-btn border outline-none transition-colors focus:border-primary focus:ring-1 focus:ring-primary',
                    style: 'background-color: var(--sigil-input-bg); border-color: var(--sigil-border); color: var(--sigil-text);'
                }}) }}
            </div>

            <div>
                {{ form_label(form.plainPassword.second, null, {label_attr: {class: 'block text-sm font-medium mb-1.5', style: 'color: var(--sigil-text);'}}) }}
                {{ form_widget(form.plainPassword.second, {attr: {
                    class: 'w-full px-3 py-2 text-sm rounded-btn border outline-none transition-colors focus:border-primary focus:ring-1 focus:ring-primary',
                    style: 'background-color: var(--sigil-input-bg); border-color: var(--sigil-border); color: var(--sigil-text);'
                }}) }}
                {{ form_errors(form.plainPassword) }}
            </div>

            <p class="text-xs" style="color: var(--sigil-text-secondary);">
                Minimum 10 characters. You will set up two-factor authentication after your first login.
            </p>

            <button
                type="submit"
                class="w-full py-2.5 px-4 text-sm font-semibold text-white rounded-btn bg-primary
                       hover:bg-primary-hover transition-all duration-150 hover:scale-[1.01]"
            >
                Create account
            </button>

            {{ form_end(form) }}
        </div>

        <p class="mt-4 text-center text-sm" style="color: var(--sigil-text-secondary);">
            Already have an account?
            <a href="{{ path('app_login') }}" class="font-medium text-primary hover:text-primary-hover transition-colors">
                Sign in
            </a>
        </p>

    </div>
</div>
{% endblock %}
