{% extends 'auth/base_auth.html.twig' %}

{% block title %}Two-factor authentication - Sigil{% endblock %}

{% block card_width %}max-w-sm{% endblock %}

{% block subtitle %}Two-factor authentication{% endblock %}

{% block card %}
    <div class="flex justify-center mb-5">
        <div class="w-12 h-12 rounded-full bg-primary-100 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
        </div>
    </div>

    <h1 class="text-center text-lg font-bold text-gray-900 mb-1">Verify your identity</h1>
    <p class="text-center text-sm text-gray-500 mb-5">
        Open your authenticator app and enter the 6-digit code.
    </p>

    {% if authenticationError %}
        <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50 border border-red-200" role="alert">
            {{ authenticationError | trans(authenticationErrorData, 'security') }}
        </div>
    {% endif %}

    <form method="post"
          action="{{ checkPathRoute ? path(checkPathRoute) : checkPathUrl }}"
          class="space-y-4">

        {% if isCsrfProtectionEnabled %}
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        {% endif %}

        <input type="text" name="{{ authCodeParameterName }}"
               inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
               autocomplete="one-time-code" autofocus placeholder="000000"
               class="bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-3 text-center text-2xl tracking-[0.5em] font-mono">

        <button type="submit"
                class="w-full text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:outline-none focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center cursor-pointer">
            Verify
        </button>
    </form>
{% endblock %}

{% block footer %}
    <form method="post" action="{{ logoutPath }}" class="mt-5 text-center">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" data-no-loader
                class="text-sm font-medium text-primary-600 hover:underline cursor-pointer">
            Sign in with a different account
        </button>
    </form>
{% endblock %}
