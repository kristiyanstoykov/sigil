{% extends 'auth/base_auth.html.twig' %}

{% block title %}Two-factor authentication - Sigil{% endblock %}

{% block card_width %}max-w-sm{% endblock %}

{% block subtitle %}Two-factor authentication{% endblock %}

{% block card %}
    <div class="flex justify-center mb-5">
        <div class="w-12 h-12 rounded-full bg-primary-500/10 flex items-center justify-center">
            <i class="ti ti-lock text-2xl leading-none text-primary-500" aria-hidden="true"></i>
        </div>
    </div>

    <h1 class="text-center text-lg font-bold text-theme-headings mb-1">Verify your identity</h1>
    <p class="text-center text-sm text-theme-secondarytextcolor mb-5">
        Open your authenticator app and enter the 6-digit code.
    </p>

    {% if authenticationError %}
        <div class="alert alert-danger text-sm" role="alert">
            {{ authenticationError | trans(authenticationErrorData, 'security') }}
        </div>
    {% endif %}

    <form method="post"
          action="{{ checkPathRoute ? path(checkPathRoute) : checkPathUrl }}"
          class="space-y-4">

        {% if isCsrfProtectionEnabled %}
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        {% endif %}

        <input type="text" name="{{ authCodeParameterName }}"
               inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
               autocomplete="one-time-code" autofocus placeholder="000000"
               class="form-control !bg-white/60 !border-theme-headings/10 focus:!bg-white/85 !p-3 text-center !text-2xl tracking-[0.5em] font-mono">

        <button type="submit"
                class="btn btn-primary w-full bg-linear-to-b from-primary-600 to-primary-500 shadow-lg shadow-primary-500/30 hover:-translate-y-px transition">
            Verify
        </button>
    </form>
{% endblock %}

{% block footer %}
    <form method="post" action="{{ logoutPath }}" class="mt-5 text-center">
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
        <button type="submit" data-no-loader
                class="text-sm font-semibold text-primary-500 hover:underline cursor-pointer">
            Sign in with a different account
        </button>
    </form>
{% endblock %}
