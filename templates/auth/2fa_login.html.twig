{% extends 'auth/base_auth.html.twig' %}

{% block title %}Two-factor authentication — Sigil{% endblock %}

{% block card_width %}max-w-sm{% endblock %}

{% block subtitle %}Two-factor authentication{% endblock %}

{% block card %}
    <div class="flex justify-center mb-5">
        <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
        </div>
    </div>

    <h2 class="text-center text-base font-bold mb-1 text-body">Verify your identity</h2>
    <p class="text-center text-[13px] mb-5 text-muted">
        Open your authenticator app and enter the 6-digit code.
    </p>

    {% if authenticationError %}
        <div class="mb-4 px-4 py-3 rounded-btn text-sm bg-danger/10 text-danger border border-danger/20">
            {{ authenticationError | trans(authenticationErrorData, 'security') }}
        </div>
    {% endif %}

    <form method="post"
          action="{{ checkPathRoute ? path(checkPathRoute) : checkPathUrl }}"
          class="space-y-4">

        {% if isCsrfProtectionEnabled %}
            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        {% endif %}

        <input
            type="text"
            name="{{ authCodeParameterName }}"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            autocomplete="one-time-code"
            autofocus
            placeholder="000000"
            class="form-input text-center !text-[22px] tracking-[0.5em] font-mono !py-3.5"
        >

        <button type="submit" class="btn-primary">Verify</button>
    </form>
{% endblock %}

{% block footer %}
    <form method="post" action="{{ logoutPath }}" class="mt-5 text-center">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" data-no-loader
                class="text-[13px] font-semibold text-primary hover:text-primary-hover transition-colors cursor-pointer">
            Sign in with a different account
        </button>
    </form>
{% endblock %}
