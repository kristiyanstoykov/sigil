{#
    Shared standalone auth layout — the Sigil auth design: soft radial "aurora"
    backdrop, centered logo, frosted-glass card (.sigil-aurora / .glass-card
    recipes in app.css). Auth pages extend this and fill:
      block card       - the card contents (required)
      block subtitle   - text under the logo
      block card_width - max-width utility (default max-w-md)
      block footer     - centered text/links under the card
#}
{% extends 'base.html.twig' %}

{% block body_class %}sigil-aurora{% endblock %}

{% block body %}
<section>
    <div class="flex flex-col items-center justify-center px-6 py-8 mx-auto min-h-screen lg:py-0">
        <div class="w-full {% block card_width %}max-w-md{% endblock %}">

            <div class="flex flex-col items-center mb-6">
                <img src="{{ asset('images/sigil-blue-900.svg') }}" alt="Sigil" width="72" height="50">
                <p class="mt-2 text-sm text-theme-secondarytextcolor">{% block subtitle %}Signum Veritatis - Digital Document Signing{% endblock %}</p>
            </div>

            <div class="w-full glass-card p-6 sm:p-8">
                {% block card %}{% endblock %}
            </div>

            {% block footer %}{% endblock %}

        </div>
    </div>
</section>
{% endblock %}
