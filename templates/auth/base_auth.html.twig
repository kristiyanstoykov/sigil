{#
    Shared standalone auth layout - stock Flowbite authentication page:
    gray backdrop, centered logo, white card. Auth pages extend this and fill:
      block card       - the card contents (required)
      block subtitle   - text under the logo
      block card_width - max-width utility (default max-w-md)
      block footer     - centered text/links under the card
#}
{% extends 'base.html.twig' %}

{% block body %}
{# Frosted-glass auth: strong radial-glow backdrop (.auth-bg), centered logo,
   frosted glass card (.glass-card). Single viewport, no forced overflow. #}
<section class="auth-bg flex min-h-dvh items-center justify-center p-6">
    <div class="rise w-full {% block card_width %}max-w-md{% endblock %}">

        <div class="flex flex-col items-center mb-6">
            <img src="{{ asset('images/sigil-blue-900.svg') }}" alt="Sigil" width="72" height="50">
            <p class="mt-2 text-sm text-gray-500">{% block subtitle %}Signum Veritatis - Digital Document Signing{% endblock %}</p>
        </div>

        <div class="glass-card p-6 sm:p-8">
            {% block card %}{% endblock %}
        </div>

        {% block footer %}{% endblock %}

    </div>
</section>
{% endblock %}
