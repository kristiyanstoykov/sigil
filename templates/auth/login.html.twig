{% extends 'auth/base_auth.html.twig' %}

{% block title %}Sign in - Sigil{% endblock %}

{# Able Pro form-control, frosted for the glass card #}
{% set input_class = 'form-control !bg-white/60 !border-theme-headings/10 focus:!bg-white/85' %}

{% block card %}
    <h1 class="text-lg font-bold text-theme-headings mb-5">Sign in to your account</h1>

    {% if error %}
        <div class="alert alert-danger text-sm" role="alert">
            {{ error.messageKey | trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post" class="space-y-4 md:space-y-5">
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

        <div>
            <label for="email" class="form-label text-sm font-semibold">Email address</label>
            <input type="email" id="email" name="email" value="{{ last_username }}"
                   placeholder="you@company.com" autocomplete="email" required
                   class="{{ input_class }}">
        </div>

        <div>
            <div class="flex items-center justify-between">
                <label for="password" class="form-label text-sm font-semibold">Password</label>
                <a href="{{ path('app_forgot_password_request') }}" class="text-sm font-semibold text-primary-500 hover:underline">Forgot password?</a>
            </div>
            <input type="password" id="password" name="password" autocomplete="current-password" required
                   placeholder="••••••••"
                   class="{{ input_class }}">
        </div>

        <button type="submit"
                class="btn btn-primary w-full bg-linear-to-b from-primary-600 to-primary-500 shadow-lg shadow-primary-500/30 hover:-translate-y-px transition">
            Sign in
        </button>
    </form>
{% endblock %}

{% block footer %}
    <p class="mt-5 text-center text-sm text-theme-secondarytextcolor">
        Don't have an account?
        <a href="{{ path('app_register') }}" class="font-semibold text-primary-500 hover:underline">Create one</a>
    </p>
{% endblock %}
