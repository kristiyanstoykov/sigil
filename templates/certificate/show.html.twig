{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}
{% import _self as ui %}

{% block title %}Certificate - Sigil{% endblock %}

{# PIN-confirmed action dialog (hold / resume / revoke). Lives inside its own
   data-controller="confirm" scope together with the button that opens it. #}
{% macro action_modal(form_action, form, icon_wrap_class, icon_class, title, body, submit_label, submit_class, with_pin) %}
    <div data-confirm-target="dialog" tabindex="-1" aria-hidden="true"
         data-action="click->confirm#backdropClose keydown.esc@window->confirm#close"
         class="hidden overflow-y-auto overflow-x-hidden fixed inset-0 z-[1050] flex justify-center items-center w-full h-full bg-theme-headings/40 backdrop-blur-sm modal-backdrop-fade">
        {# solid white on phones - the 85% glass card over the dark scrim read grey; desktop keeps a near-solid glass #}
        <div data-confirm-target="card" class="relative w-full max-w-md p-6 m-5 glass-card !bg-white sm:!bg-white/90 modal-card">
            <div class="inline-flex w-11 h-11 items-center justify-center rounded-lg {{ icon_wrap_class }} mb-4">
                <i class="{{ icon_class }} text-xl leading-none" aria-hidden="true"></i>
            </div>
            <h2 class="text-lg font-semibold text-theme-headings mb-2">{{ title }}</h2>
            <p class="text-sm text-theme-secondarytextcolor leading-relaxed mb-5">{{ body }}</p>
            {{ form_start(form, {action: form_action, attr: {novalidate: 'novalidate', class: 'space-y-4'}}) }}
                {% if with_pin %}
                    {% set E_PIN = constant('App\\Certificate\\Form\\CertificateActionForm::E_PIN') %}
                    <label class="block">
                        <span class="form-label !inline-block text-sm font-semibold">Certificate PIN</span>
                        {{ form_widget(form[E_PIN], {attr: {
                            class: 'form-control !bg-white/60 text-center font-mono tracking-[0.3em]'
                        }}) }}
                    </label>
                {% endif %}
                <div class="flex gap-2.5">
                    <button type="button" data-action="confirm#close" class="btn btn-outline-secondary flex-1">Cancel</button>
                    <button type="submit" class="btn {{ submit_class }} flex-1">{{ submit_label }}</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endmacro %}

{% block content %}
    {% set status = certificate.displayStatus %}
    <div class="max-w-3xl mx-auto">
        {{ helpers.back_link(path('app_certificates'), 'Back to certificates') }}

        <div class="card !mb-0 overflow-hidden">
            <div class="h-1.5 {{ status.accentClass }}"></div>
            <div class="p-6">
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <div class="text-xs font-medium uppercase tracking-wide text-theme-secondarytextcolor">Signing certificate</div>
                        <h1 class="mt-1 text-2xl font-bold text-theme-headings">{{ certificate.user.firstName }} {{ certificate.user.lastName }}</h1>
                        {% if certificate.user.company %}
                            <div class="mt-1 text-sm text-theme-secondarytextcolor">{{ certificate.user.position ? certificate.user.position ~ ' · ' }}{{ certificate.user.company }}</div>
                        {% endif %}
                    </div>
                    <span class="shrink-0">{{ helpers.badge(status, true) }}</span>
                </div>

                {% if status.onHold %}
                    <div class="alert alert-info flex items-start gap-3 !mb-0 mt-5 text-sm" role="alert">
                        <i class="ti ti-player-pause shrink-0 text-base leading-none mt-0.5" aria-hidden="true"></i>
                        <div><strong>This certificate is on hold.</strong> Signing with it is disabled until {{ certificate.heldUntil|date('d M Y, H:i') }} UTC. It resumes automatically then - or resume it now with your PIN.</div>
                    </div>
                {% elseif status.locked %}
                    <div class="alert alert-danger flex items-start gap-3 !mb-0 mt-5 text-sm" role="alert">
                        <i class="ti ti-lock shrink-0 text-base leading-none mt-0.5" aria-hidden="true"></i>
                        <div><strong>This certificate is locked.</strong> It was locked after too many failed PIN attempts. <a href="{{ path('app_certificate_unlock', {id: certificate.id}) }}" class="font-semibold underline">Unlock it</a> by re-verifying your identity.</div>
                    </div>
                {% elseif status.revoked %}
                    <div class="alert alert-secondary flex items-start gap-3 !mb-0 mt-5 text-sm" role="alert">
                        <i class="ti ti-ban shrink-0 text-base leading-none mt-0.5" aria-hidden="true"></i>
                        <div><strong>This certificate has been revoked.</strong> It can no longer be used to sign. Revoked on {{ certificate.revokedAt|date('d M Y') }}.</div>
                    </div>
                {% elseif status.expired %}
                    <div class="alert alert-warning flex items-start gap-3 !mb-0 mt-5 text-sm" role="alert">
                        <i class="ti ti-clock shrink-0 text-base leading-none mt-0.5" aria-hidden="true"></i>
                        <div><strong>This certificate has expired.</strong> Issue a new certificate to keep signing.</div>
                    </div>
                {% endif %}

                {# facts #}
                <div class="mt-5 relative overflow-x-auto border border-theme-border rounded-lg">
                    <table class="w-full text-sm text-left text-theme-secondarytextcolor">
                        <tbody>
                            <tr class="bg-white border-b border-theme-border/60">
                                <th scope="row" class="px-4 py-3 font-normal text-theme-secondarytextcolor whitespace-nowrap align-top">Serial number</th>
                                <td class="px-4 py-3 font-mono text-xs font-medium text-theme-headings break-all text-right">{{ certificate.serialNumber|upper }}</td>
                            </tr>
                            <tr class="bg-theme-bodybg/60 border-b border-theme-border/60">
                                <th scope="row" class="px-4 py-3 font-normal text-theme-secondarytextcolor whitespace-nowrap">Algorithm</th>
                                <td class="px-4 py-3 font-medium text-theme-headings text-right">{{ algorithm_label }}</td>
                            </tr>
                            <tr class="bg-white border-b border-theme-border/60">
                                <th scope="row" class="px-4 py-3 font-normal text-theme-secondarytextcolor whitespace-nowrap">Valid from</th>
                                <td class="px-4 py-3 font-medium text-theme-headings text-right">{{ certificate.notBefore|date('d M Y, H:i') }} UTC</td>
                            </tr>
                            <tr class="bg-theme-bodybg/60 border-b border-theme-border/60">
                                <th scope="row" class="px-4 py-3 font-normal text-theme-secondarytextcolor whitespace-nowrap">Valid until</th>
                                <td class="px-4 py-3 font-medium text-right {{ status.expired ? 'text-warning-600' : 'text-theme-headings' }}">{{ certificate.notAfter|date('d M Y, H:i') }} UTC</td>
                            </tr>
                            {% if status.onHold %}
                                <tr class="bg-white border-b border-theme-border/60">
                                    <th scope="row" class="px-4 py-3 font-normal text-theme-secondarytextcolor whitespace-nowrap">On hold until</th>
                                    <td class="px-4 py-3 font-medium text-info-600 text-right">{{ certificate.heldUntil|date('d M Y, H:i') }} UTC</td>
                                </tr>
                            {% endif %}
                            {% if certificate.revokedAt %}
                                <tr class="bg-white border-b border-theme-border/60">
                                    <th scope="row" class="px-4 py-3 font-normal text-theme-secondarytextcolor whitespace-nowrap">Revoked</th>
                                    <td class="px-4 py-3 font-medium text-theme-headings text-right">{{ certificate.revokedAt|date('d M Y, H:i') }} UTC</td>
                                </tr>
                                <tr class="bg-theme-bodybg/60 border-b border-theme-border/60">
                                    <th scope="row" class="px-4 py-3 font-normal text-theme-secondarytextcolor whitespace-nowrap">Reason</th>
                                    <td class="px-4 py-3 font-medium text-theme-headings text-right">{{ certificate.revocationReason }}</td>
                                </tr>
                            {% endif %}
                            <tr class="bg-white">
                                <th scope="row" class="px-4 py-3 font-normal text-theme-secondarytextcolor whitespace-nowrap align-top">Distinguished name</th>
                                <td class="px-4 py-3 font-mono text-xs font-medium text-theme-bodycolor break-words text-right">{{ certificate.subjectDn }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                {# actions - on phones every button stretches to share its row evenly
                   (max-sm:grow max-sm:basis-[calc(50%-0.25rem)]), so wherever the row wraps it stays symmetrical #}
                <div class="mt-5 flex items-center gap-2 sm:gap-2.5 flex-wrap">
                    <a href="{{ path('app_certificate_download', {id: certificate.id}) }}" data-no-loader
                       class="btn {{ helpers.action_class('download') }} inline-flex items-center justify-center gap-2 max-sm:grow max-sm:basis-[calc(50%-0.25rem)]">
                        <i class="ti ti-download text-base leading-none" aria-hidden="true"></i>
                        Download .crt
                    </a>
                    {% if status.active %}
                        <a href="{{ path('app_certificate_change_pin', {id: certificate.id}) }}"
                           class="btn {{ helpers.action_class('change_pin') }} inline-flex items-center justify-center gap-2 max-sm:grow max-sm:basis-[calc(50%-0.25rem)]">
                            <i class="ti ti-lock text-base leading-none" aria-hidden="true"></i>
                            Change PIN
                        </a>
                    {% endif %}
                    {% if status.locked %}
                        <a href="{{ path('app_certificate_unlock', {id: certificate.id}) }}"
                           class="btn {{ helpers.action_class('unlock') }} inline-flex items-center justify-center gap-2 max-sm:grow max-sm:basis-[calc(50%-0.25rem)]">
                            <i class="ti ti-lock-open text-base leading-none" aria-hidden="true"></i>
                            Unlock certificate
                        </a>
                    {% endif %}
                    {% if not status.revoked %}
                        <div class="flex-1 min-w-3 max-sm:hidden"></div>

                        {% if status.active %}
                            {# 72h hold - the "certificateHold" story: pause signing without burning the identity #}
                            <div data-controller="confirm" class="contents">
                                <button type="button" data-action="confirm#open"
                                        class="btn {{ helpers.action_class('hold') }} inline-flex items-center justify-center gap-2 max-sm:grow max-sm:basis-[calc(50%-0.25rem)]">
                                    <i class="ti ti-player-pause text-base leading-none" aria-hidden="true"></i>
                                    Hold
                                </button>
                                {{ ui.action_modal(
                                    path('app_certificate_hold', {id: certificate.id}),
                                    holdForm,
                                    'bg-warning-500/10 text-warning-600', 'ti ti-player-pause',
                                    'Put this certificate on hold?',
                                    'Signing with this certificate will be disabled for the next ' ~ constant('App\\Certificate\\Entity\\Certificate::HOLD_HOURS') ~ ' hours. It resumes automatically after that - or earlier, with your PIN. Confirm with your PIN to place the hold.',
                                    'Put on hold', 'btn-warning', true
                                ) }}
                            </div>
                        {% elseif status.onHold %}
                            <div data-controller="confirm" class="contents">
                                <button type="button" data-action="confirm#open"
                                        class="btn {{ helpers.action_class('resume') }} inline-flex items-center justify-center gap-2 max-sm:grow max-sm:basis-[calc(50%-0.25rem)]">
                                    <i class="ti ti-player-play text-base leading-none" aria-hidden="true"></i>
                                    Resume
                                </button>
                                {{ ui.action_modal(
                                    path('app_certificate_resume', {id: certificate.id}),
                                    resumeForm,
                                    'bg-success-500/10 text-success-600', 'ti ti-player-play',
                                    'Resume this certificate?',
                                    'The hold ends now and signing with this certificate is enabled again. Confirm with your PIN.',
                                    'Resume', 'btn-success', true
                                ) }}
                            </div>
                        {% endif %}

                        {# PIN required while the certificate is otherwise usable; a locked/expired
                           one is revocable without it (the PIN may be lost - re-issue starts here) #}
                        <div data-controller="confirm" class="contents">
                            <button type="button" data-action="confirm#open"
                                    class="btn {{ helpers.action_class('revoke') }} inline-flex items-center justify-center gap-2 max-sm:grow max-sm:basis-[calc(50%-0.25rem)]">
                                <i class="ti ti-ban text-base leading-none" aria-hidden="true"></i>
                                Revoke
                            </button>
                            {{ ui.action_modal(
                                path('app_certificate_revoke', {id: certificate.id}),
                                revokeForm,
                                'bg-danger-500/10 text-danger-600', 'ti ti-alert-triangle',
                                'Revoke this certificate?',
                                'Revoking is permanent. This signing identity will immediately stop working and can\'t be reactivated - you\'d need to issue a new one.' ~ (status.pinGuarded ? ' Confirm with your PIN.' : ''),
                                'Revoke certificate', 'btn-danger', status.pinGuarded
                            ) }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
