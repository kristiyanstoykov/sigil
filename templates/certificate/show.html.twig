{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}Certificate - Sigil{% endblock %}

{% block content %}
    {% set status = certificate.status.value %}
    <div class="max-w-3xl mx-auto" data-controller="confirm">
        {{ helpers.back_link(path('app_certificates'), 'Back to certificates') }}

        <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
            <div class="h-1.5 {{ helpers.accent_class(status) }}"></div>
            <div class="p-6">
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <div class="text-xs font-medium uppercase tracking-wide text-gray-400">Signing certificate</div>
                        <h1 class="mt-1 text-2xl font-bold text-gray-900">{{ certificate.user.firstName }} {{ certificate.user.lastName }}</h1>
                        {% if certificate.user.company %}
                            <div class="mt-1 text-sm text-gray-500">{{ certificate.user.position ? certificate.user.position ~ ' · ' }}{{ certificate.user.company }}</div>
                        {% endif %}
                    </div>
                    <span class="shrink-0">{{ helpers.badge(status, true) }}</span>
                </div>

                {% if status == 'locked' %}
                    <div class="flex items-start gap-3 p-4 mt-5 text-sm text-red-800 border border-red-200 rounded-lg bg-red-50" role="alert">
                        <svg class="shrink-0 w-4 h-4 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                        <div><strong>This certificate is locked.</strong> It was locked after too many failed PIN attempts. <a href="{{ path('app_certificate_unlock', {id: certificate.id}) }}" class="font-semibold underline">Unlock it</a> by re-verifying your identity.</div>
                    </div>
                {% elseif status == 'revoked' %}
                    <div class="flex items-start gap-3 p-4 mt-5 text-sm text-gray-800 border border-gray-200 rounded-lg bg-gray-50" role="alert">
                        <svg class="shrink-0 w-4 h-4 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></svg>
                        <div><strong>This certificate has been revoked.</strong> It can no longer be used to sign. Revoked on {{ certificate.revokedAt|date('d M Y') }}.</div>
                    </div>
                {% elseif status == 'expired' %}
                    <div class="flex items-start gap-3 p-4 mt-5 text-sm text-yellow-800 border border-yellow-200 rounded-lg bg-yellow-50" role="alert">
                        <svg class="shrink-0 w-4 h-4 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        <div><strong>This certificate has expired.</strong> Issue a new certificate to keep signing.</div>
                    </div>
                {% endif %}

                {# facts #}
                <div class="mt-5 relative overflow-x-auto border border-gray-200 rounded-lg">
                    <table class="w-full text-sm text-left text-gray-500">
                        <tbody>
                            <tr class="bg-white border-b border-gray-100">
                                <th scope="row" class="px-4 py-3 font-normal text-gray-500 whitespace-nowrap align-top">Serial number</th>
                                <td class="px-4 py-3 font-mono text-xs font-medium text-gray-900 break-all text-right">{{ certificate.serialNumber|upper }}</td>
                            </tr>
                            <tr class="bg-gray-50 border-b border-gray-100">
                                <th scope="row" class="px-4 py-3 font-normal text-gray-500 whitespace-nowrap">Algorithm</th>
                                <td class="px-4 py-3 font-medium text-gray-900 text-right">{{ algorithm_label }}</td>
                            </tr>
                            <tr class="bg-white border-b border-gray-100">
                                <th scope="row" class="px-4 py-3 font-normal text-gray-500 whitespace-nowrap">Valid from</th>
                                <td class="px-4 py-3 font-medium text-gray-900 text-right">{{ certificate.notBefore|date('d M Y, H:i') }} UTC</td>
                            </tr>
                            <tr class="bg-gray-50 border-b border-gray-100">
                                <th scope="row" class="px-4 py-3 font-normal text-gray-500 whitespace-nowrap">Valid until</th>
                                <td class="px-4 py-3 font-medium text-right {{ status == 'expired' ? 'text-yellow-700' : 'text-gray-900' }}">{{ certificate.notAfter|date('d M Y, H:i') }} UTC</td>
                            </tr>
                            {% if certificate.revokedAt %}
                                <tr class="bg-white border-b border-gray-100">
                                    <th scope="row" class="px-4 py-3 font-normal text-gray-500 whitespace-nowrap">Revoked</th>
                                    <td class="px-4 py-3 font-medium text-gray-900 text-right">{{ certificate.revokedAt|date('d M Y, H:i') }} UTC</td>
                                </tr>
                                <tr class="bg-gray-50 border-b border-gray-100">
                                    <th scope="row" class="px-4 py-3 font-normal text-gray-500 whitespace-nowrap">Reason</th>
                                    <td class="px-4 py-3 font-medium text-gray-900 text-right">{{ certificate.revocationReason }}</td>
                                </tr>
                            {% endif %}
                            <tr class="bg-white">
                                <th scope="row" class="px-4 py-3 font-normal text-gray-500 whitespace-nowrap align-top">Distinguished name</th>
                                <td class="px-4 py-3 font-mono text-xs font-medium text-gray-700 break-words text-right">{{ certificate.subjectDn }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                {# actions #}
                <div class="mt-5 flex items-center gap-2.5 flex-wrap">
                    <a href="{{ path('app_certificate_download', {id: certificate.id}) }}" data-no-loader
                       class="inline-flex items-center gap-2 text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-4 py-2.5">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M5 21h14"/></svg>
                        Download .crt
                    </a>
                    {% if status == 'active' %}
                        <a href="{{ path('app_certificate_change_pin', {id: certificate.id}) }}"
                           class="inline-flex items-center gap-2 py-2.5 px-4 text-sm font-medium text-gray-900 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-primary-700">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                            Change PIN
                        </a>
                    {% endif %}
                    {% if status == 'locked' %}
                        <a href="{{ path('app_certificate_unlock', {id: certificate.id}) }}"
                           class="inline-flex items-center gap-2 py-2.5 px-4 text-sm font-medium text-gray-900 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-primary-700">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 7.5-1.5"/></svg>
                            Unlock certificate
                        </a>
                    {% endif %}
                    {% if status != 'revoked' %}
                        <div class="flex-1 min-w-3"></div>
                        <button type="button" data-action="confirm#open"
                                class="inline-flex items-center gap-2 py-2.5 px-4 text-sm font-medium text-red-700 bg-white rounded-lg border border-red-300 hover:bg-red-50 cursor-pointer">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></svg>
                            Revoke
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>

    {# revoke confirm modal (Stimulus confirm_controller - animated open AND close) #}
    {% if status != 'revoked' %}
        <div data-confirm-target="dialog" tabindex="-1" aria-hidden="true"
             data-action="click->confirm#backdropClose keydown.esc@window->confirm#close"
             class="hidden overflow-y-auto overflow-x-hidden fixed inset-0 z-50 flex justify-center items-center w-full h-full bg-gray-900/50 modal-backdrop-fade">
            <div data-confirm-target="card" class="relative w-full max-w-md p-6 m-5 bg-white rounded-lg shadow-lg modal-card">
                <div class="inline-flex w-11 h-11 items-center justify-center rounded-lg bg-red-100 text-red-700 mb-4">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
                </div>
                <h2 class="text-lg font-semibold text-gray-900 mb-2">Revoke this certificate?</h2>
                <p class="text-sm text-gray-500 leading-relaxed mb-5">Revoking is permanent. This signing identity will immediately stop working and can't be reactivated - you'd need to issue a new one.</p>
                <div class="flex gap-2.5">
                    <button type="button" data-action="confirm#close"
                            class="flex-1 py-2.5 px-5 text-sm font-medium text-gray-900 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 cursor-pointer">Cancel</button>
                    <form method="post" action="{{ path('app_certificate_revoke', {id: certificate.id}) }}" class="flex-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('revoke-certificate-' ~ certificate.id) }}">
                        <button type="submit"
                                class="w-full text-white bg-red-600 hover:bg-red-700 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 cursor-pointer">Revoke certificate</button>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}
    </div>
{% endblock %}
