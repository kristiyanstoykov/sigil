{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}Certificate — Sigil{% endblock %}

{% block content %}
    {% set status = certificate.status.value %}
    <div class="max-w-[720px] mx-auto" data-controller="confirm">
        {{ helpers.back_link(path('app_certificates'), 'Back to certificates') }}

        <div class="bg-surface border border-line rounded-2xl overflow-hidden shadow-sm">
            <div class="h-1.5 {{ helpers.accent_class(status) }}"></div>
            <div class="px-6.5 py-6">
                <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0">
                        <div class="text-[11px] font-extrabold tracking-[.14em] uppercase text-[color:var(--sigil-text-disabled)]">Signing certificate</div>
                        <h1 class="mt-1.5 text-[23px] font-extrabold tracking-tight text-body">{{ certificate.user.firstName }} {{ certificate.user.lastName }}</h1>
                        {% if certificate.user.company %}
                            <div class="mt-1.5 text-[14px] text-label">{{ certificate.user.position ? certificate.user.position ~ ' · ' }}{{ certificate.user.company }}</div>
                        {% endif %}
                    </div>
                    <span class="shrink-0">{{ helpers.badge(status, true) }}</span>
                </div>

                {% if status == 'locked' %}
                    <div class="flex gap-3 px-4 py-3.5 mt-5 rounded-xl bg-danger/6 border border-danger/25">
                        <span class="shrink-0 inline-flex w-7.5 h-7.5 items-center justify-center rounded-[9px] bg-danger/12 text-[color:#B91C1C]">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                        </span>
                        <div class="text-[13px] leading-relaxed text-[color:#7F1D1D]"><strong>This certificate is locked.</strong> It was locked after too many failed PIN attempts. <a href="{{ path('app_certificate_unlock', {id: certificate.id}) }}" class="text-[color:#B91C1C] font-bold underline">Unlock it</a> by re-verifying your identity.</div>
                    </div>
                {% elseif status == 'revoked' %}
                    <div class="flex gap-3 px-4 py-3.5 mt-5 rounded-xl bg-[color:rgba(100,116,139,.08)] border border-[color:rgba(100,116,139,.24)]">
                        <span class="shrink-0 inline-flex w-7.5 h-7.5 items-center justify-center rounded-[9px] bg-[color:rgba(100,116,139,.16)] text-label">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></svg>
                        </span>
                        <div class="text-[13px] leading-relaxed text-label"><strong>This certificate has been revoked.</strong> It can no longer be used to sign. Revoked on {{ certificate.revokedAt|date('d M Y') }}.</div>
                    </div>
                {% elseif status == 'expired' %}
                    <div class="flex gap-3 px-4 py-3.5 mt-5 rounded-xl bg-warning/8 border border-warning/26">
                        <span class="shrink-0 inline-flex w-7.5 h-7.5 items-center justify-center rounded-[9px] bg-warning/16 text-[color:#B45309]">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        </span>
                        <div class="text-[13px] leading-relaxed text-[color:#78350F]"><strong>This certificate has expired.</strong> Issue a new certificate to keep signing.</div>
                    </div>
                {% endif %}

                {# facts #}
                <div class="mt-5.5 border border-[color:#F1F5F9] rounded-xl overflow-hidden">
                    <div class="flex justify-between gap-6 px-4 py-3.25 text-[13px] bg-[color:#FBFCFE]"><span class="shrink-0 text-[color:var(--sigil-text-disabled)]">Serial number</span><span class="font-semibold font-mono text-[12px] break-all text-right">{{ certificate.serialNumber|upper }}</span></div>
                    <div class="flex justify-between px-4 py-3.25 text-[13px] border-t border-[color:#F1F5F9]"><span class="text-[color:var(--sigil-text-disabled)]">Algorithm</span><span class="font-semibold">{{ algorithm_label }}</span></div>
                    <div class="flex justify-between px-4 py-3.25 text-[13px] border-t border-[color:#F1F5F9] bg-[color:#FBFCFE]"><span class="text-[color:var(--sigil-text-disabled)]">Valid from</span><span class="font-semibold">{{ certificate.notBefore|date('d M Y, H:i') }} UTC</span></div>
                    <div class="flex justify-between px-4 py-3.25 text-[13px] border-t border-[color:#F1F5F9]"><span class="text-[color:var(--sigil-text-disabled)]">Valid until</span><span class="font-semibold {{ status == 'expired' ? 'text-warning' }}">{{ certificate.notAfter|date('d M Y, H:i') }} UTC</span></div>
                    {% if certificate.revokedAt %}
                        <div class="flex justify-between px-4 py-3.25 text-[13px] border-t border-[color:#F1F5F9] bg-[color:#FBFCFE]"><span class="text-[color:var(--sigil-text-disabled)]">Revoked</span><span class="font-semibold">{{ certificate.revokedAt|date('d M Y, H:i') }} UTC</span></div>
                        <div class="flex justify-between px-4 py-3.25 text-[13px] border-t border-[color:#F1F5F9]"><span class="text-[color:var(--sigil-text-disabled)]">Reason</span><span class="font-semibold">{{ certificate.revocationReason }}</span></div>
                    {% endif %}
                    <div class="px-4 py-3 text-[12px] border-t border-[color:#F1F5F9] bg-[color:#FBFCFE]">
                        <div class="text-[color:var(--sigil-text-disabled)] mb-1">Distinguished name</div>
                        <div class="font-medium font-mono text-label break-words leading-normal">{{ certificate.subjectDn }}</div>
                    </div>
                </div>

                {# actions #}
                <div class="mt-5.5 flex items-center gap-2.5 flex-wrap">
                    <a href="{{ path('app_certificate_download', {id: certificate.id}) }}" data-no-loader
                       class="btn-primary w-auto inline-flex items-center gap-2 px-4 py-2.75 text-[13.5px] font-semibold rounded-[11px] text-white">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M8 11l4 4 4-4"/><path d="M5 21h14"/></svg>
                        Download .crt
                    </a>
                    {% if status == 'active' %}
                        <a href="{{ path('app_certificate_change_pin', {id: certificate.id}) }}"
                           class="inline-flex items-center gap-2 px-4 py-2.75 border border-line rounded-[11px] bg-surface text-[13.5px] font-semibold text-label hover:border-primary/40 transition-colors">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                            Change PIN
                        </a>
                    {% endif %}
                    {% if status == 'locked' %}
                        <a href="{{ path('app_certificate_unlock', {id: certificate.id}) }}"
                           class="inline-flex items-center gap-2 px-4 py-2.75 border border-line rounded-[11px] bg-surface text-[13.5px] font-semibold text-label hover:border-primary/40 transition-colors">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 7.5-1.5"/></svg>
                            Unlock certificate
                        </a>
                    {% endif %}
                    {% if status != 'revoked' %}
                        <div class="flex-1 min-w-3"></div>
                        <button type="button" data-action="confirm#open"
                                class="inline-flex items-center gap-2 px-4 py-2.75 border border-danger/40 rounded-[11px] bg-surface text-[13.5px] font-semibold text-danger hover:bg-danger/5 transition-colors cursor-pointer">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></svg>
                            Revoke
                        </button>
                    {% endif %}
                </div>
            </div>
        </div>

    {# revoke confirm modal (Stimulus confirm_controller — animated open AND close) #}
    {% if status != 'revoked' %}
        <div data-confirm-target="dialog" tabindex="-1" aria-hidden="true"
             data-action="click->confirm#backdropClose keydown.esc@window->confirm#close"
             class="hidden overflow-y-auto overflow-x-hidden fixed inset-0 z-50 flex justify-center items-center w-full h-full bg-[color:rgba(15,23,42,.42)] backdrop-blur-[4px] modal-backdrop-fade">
            <div data-confirm-target="card" class="relative w-full max-w-105 p-6.5 m-5 rounded-[18px] modal-card">
                <div class="inline-flex w-11 h-11 items-center justify-center rounded-[13px] bg-danger/12 text-[color:#B91C1C] mb-3.5">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
                </div>
                <h2 class="text-lg font-extrabold text-body mb-2">Revoke this certificate?</h2>
                <p class="text-[13.5px] text-label leading-relaxed mb-5.5">Revoking is permanent. This signing identity will immediately stop working and can't be reactivated — you'd need to issue a new one.</p>
                <div class="flex gap-2.5">
                    <button type="button" data-action="confirm#close"
                            class="flex-1 py-2.75 border border-line rounded-[11px] bg-surface text-[13.5px] font-semibold text-label cursor-pointer">Cancel</button>
                    <form method="post" action="{{ path('app_certificate_revoke', {id: certificate.id}) }}" class="flex-1">
                        <input type="hidden" name="_token" value="{{ csrf_token('revoke-certificate-' ~ certificate.id) }}">
                        <button type="submit" class="w-full py-2.75 border-none rounded-[11px] bg-danger text-[13.5px] font-bold text-white cursor-pointer shadow-[0_8px_20px_-8px_rgba(220,38,38,.6)]">Revoke certificate</button>
                    </form>
                </div>
            </div>
        </div>
    {% endif %}
    </div>
{% endblock %}
