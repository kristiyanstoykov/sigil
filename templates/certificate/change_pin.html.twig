{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}Change PIN - Sigil{% endblock %}

{% block content %}
    <div class="max-w-md mx-auto mt-2">
        {{ helpers.back_link(path('app_certificate_show', {id: certificate.id}), 'Back to certificate') }}

        <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="inline-flex w-10 h-10 items-center justify-center rounded-lg bg-primary-100 text-primary-700">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                </span>
                <h1 class="text-xl font-bold text-gray-900">Change your PIN</h1>
            </div>
            <p class="text-sm text-gray-500 leading-relaxed mb-5">Enter your current PIN, then choose a new one. Your key and certificate stay the same.</p>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {% set label_class = 'block mb-2 text-sm font-medium text-gray-900' %}
            {% set pin_class = 'bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 text-sm font-mono tracking-[0.3em]' %}
            {% set current = constant('App\\Certificate\\Form\\ChangePinForm::E_CURRENT_PIN') %}
            {% set new = constant('App\\Certificate\\Form\\ChangePinForm::E_NEW_PIN') %}

            <div class="mb-4">
                {{ form_label(form[current], null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form[current], {attr: {class: pin_class, placeholder: '••••••'}}) }}
                {{ form_errors(form[current]) }}
            </div>
            <div class="flex gap-3">
                <div class="flex-1">
                    {{ form_label(form[new].first, null, {label_attr: {class: label_class}}) }}
                    {{ form_widget(form[new].first, {attr: {class: pin_class, placeholder: '6–8 digits'}}) }}
                </div>
                <div class="flex-1">
                    {{ form_label(form[new].second, null, {label_attr: {class: label_class}}) }}
                    {{ form_widget(form[new].second, {attr: {class: pin_class, placeholder: 'Repeat'}}) }}
                </div>
            </div>
            {# RepeatedType maps violations to its FIRST child #}
            <div class="mb-2">
                {{ form_errors(form[new]) }}
                {{ form_errors(form[new].first) }}
                {{ form_errors(form[new].second) }}
            </div>
            <p class="text-xs text-gray-400 mb-5">5 wrong attempts within an hour lock the certificate.</p>

            <button type="submit"
                    class="w-full text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 cursor-pointer">Update PIN</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
