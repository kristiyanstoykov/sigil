{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}Change PIN - Sigil{% endblock %}

{% block content %}
    <div class="max-w-md mx-auto mt-2">
        {{ helpers.back_link(path('app_certificate_show', {id: certificate.id}), 'Back to certificate') }}

        <div class="card !mb-0 p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="inline-flex w-10 h-10 items-center justify-center rounded-lg bg-primary-500/10 text-primary-500">
                    <i class="ti ti-lock text-xl leading-none" aria-hidden="true"></i>
                </span>
                <h1 class="text-xl font-bold text-theme-headings">Change your PIN</h1>
            </div>
            <p class="text-sm text-theme-secondarytextcolor leading-relaxed mb-5">Enter your current PIN, then choose a new one. Your key and certificate stay the same.</p>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {% set label_class = 'form-label text-sm font-medium' %}
            {% set pin_class = 'form-control font-mono tracking-[0.3em]' %}
            {% set current = constant('App\\Certificate\\Form\\ChangePinForm::E_CURRENT_PIN') %}
            {% set new = constant('App\\Certificate\\Form\\ChangePinForm::E_NEW_PIN') %}

            <div class="mb-4">
                {{ form_label(form[current], null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form[current], {attr: {class: pin_class, placeholder: '••••••'}}) }}
                {{ form_errors(form[current]) }}
            </div>
            <div class="flex gap-3">
                <div class="flex-1">
                    {{ form_label(form[new].first, null, {label_attr: {class: label_class}}) }}
                    {{ form_widget(form[new].first, {attr: {class: pin_class, placeholder: '6–8 digits'}}) }}
                </div>
                <div class="flex-1">
                    {{ form_label(form[new].second, null, {label_attr: {class: label_class}}) }}
                    {{ form_widget(form[new].second, {attr: {class: pin_class, placeholder: 'Repeat'}}) }}
                </div>
            </div>
            {# RepeatedType maps violations to its FIRST child #}
            <div class="mb-2">
                {{ form_errors(form[new]) }}
                {{ form_errors(form[new].first) }}
                {{ form_errors(form[new].second) }}
            </div>
            <p class="text-xs text-theme-secondarytextcolor mb-5">5 wrong attempts within an hour lock the certificate.</p>

            <button type="submit" class="btn btn-primary w-full">Update PIN</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
