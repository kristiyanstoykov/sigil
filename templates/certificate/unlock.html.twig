{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}Unlock certificate — Sigil{% endblock %}

{% block content %}
    <div class="max-w-[460px] mx-auto mt-2">
        {{ helpers.back_link(path('app_certificate_show', {id: certificate.id}), 'Back to certificate') }}

        <div class="bg-surface border border-line rounded-2xl shadow-sm p-6.5">
            <div class="flex items-center gap-3 mb-1.5">
                <span class="inline-flex w-10 h-10 items-center justify-center rounded-xl bg-danger/8 text-[color:#B91C1C]">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 7.5-1.5"/></svg>
                </span>
                <h1 class="text-xl font-extrabold tracking-tight text-body">Unlock certificate</h1>
            </div>
            <p class="text-[13.5px] text-muted leading-relaxed mb-5">Unlocking resets the failed-PIN counter. Because this is a security action, re-prove your identity — being signed in isn't enough.</p>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {% set label_class = 'block text-[12.5px] font-semibold mb-1.5 text-label' %}
            {% set password = constant('App\\Certificate\\Form\\UnlockCertificateForm::E_PASSWORD') %}
            {% set totp = constant('App\\Certificate\\Form\\UnlockCertificateForm::E_TOTP_CODE') %}

            <div class="mb-4">
                {{ form_label(form[password], null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form[password], {attr: {class: 'form-input', placeholder: '••••••••'}}) }}
                {{ form_errors(form[password]) }}
            </div>
            <div class="mb-4.5">
                {{ form_label(form[totp], null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form[totp], {attr: {class: 'form-input text-center font-mono text-xl tracking-[.4em]', placeholder: '000000'}}) }}
                {{ form_errors(form[totp]) }}
            </div>

            <button type="submit" class="btn-primary w-full py-3 text-[14px] font-bold rounded-[11px] text-white">Unlock</button>
            {{ form_end(form) }}

            <div class="mt-4 flex gap-2.5 items-start text-[12px] text-muted leading-normal">
                <svg class="shrink-0 mt-px text-success" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                Your key and certificate are untouched — this only resets the PIN counter.
            </div>
        </div>
    </div>
{% endblock %}
