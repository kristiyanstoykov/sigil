{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}Unlock certificate - Sigil{% endblock %}

{% block content %}
    <div class="max-w-md mx-auto mt-2">
        {{ helpers.back_link(path('app_certificate_show', {id: certificate.id}), 'Back to certificate') }}

        <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="inline-flex w-10 h-10 items-center justify-center rounded-lg bg-red-100 text-red-700">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 7.5-1.5"/></svg>
                </span>
                <h1 class="text-xl font-bold text-gray-900">Unlock certificate</h1>
            </div>
            <p class="text-sm text-gray-500 leading-relaxed mb-5">Unlocking resets the failed-PIN counter. Because this is a security action, re-prove your identity - being signed in isn't enough.</p>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {% set label_class = 'block mb-2 text-sm font-medium text-gray-900' %}
            {% set input_class = 'bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 text-sm' %}
            {% set password = constant('App\\Certificate\\Form\\UnlockCertificateForm::E_PASSWORD') %}
            {% set totp = constant('App\\Certificate\\Form\\UnlockCertificateForm::E_TOTP_CODE') %}

            <div class="mb-4">
                {{ form_label(form[password], null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form[password], {attr: {class: input_class, placeholder: '••••••••'}}) }}
                {{ form_errors(form[password]) }}
            </div>
            <div class="mb-5">
                {{ form_label(form[totp], null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form[totp], {attr: {class: input_class ~ ' text-center font-mono text-xl tracking-[.4em]', placeholder: '000000'}}) }}
                {{ form_errors(form[totp]) }}
            </div>

            <button type="submit"
                    class="w-full text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 cursor-pointer">Unlock</button>
            {{ form_end(form) }}

            <div class="mt-4 flex gap-2.5 items-start text-xs text-gray-500 leading-normal">
                <svg class="shrink-0 mt-px w-3.5 h-3.5 text-green-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                Your key and certificate are untouched - this only resets the PIN counter.
            </div>
        </div>
    </div>
{% endblock %}
