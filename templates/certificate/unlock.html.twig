{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}Unlock certificate - Sigil{% endblock %}

{% block content %}
    <div class="max-w-md mx-auto mt-2">
        {{ helpers.back_link(path('app_certificate_show', {id: certificate.id}), 'Back to certificate') }}

        <div class="card !mb-0 p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="inline-flex w-10 h-10 items-center justify-center rounded-lg bg-danger-500/10 text-danger-600">
                    <i class="ti ti-lock-open text-xl leading-none" aria-hidden="true"></i>
                </span>
                <h1 class="text-xl font-bold text-theme-headings">Unlock certificate</h1>
            </div>
            <p class="text-sm text-theme-secondarytextcolor leading-relaxed mb-5">Unlocking resets the failed-PIN counter. Because this is a security action, re-prove your identity - being signed in isn't enough.</p>

            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
            {% set label_class = 'form-label text-sm font-medium' %}
            {% set input_class = 'form-control' %}
            {% set password = constant('App\\Certificate\\Form\\UnlockCertificateForm::E_PASSWORD') %}
            {% set totp = constant('App\\Certificate\\Form\\UnlockCertificateForm::E_TOTP_CODE') %}

            <div class="mb-4">
                {{ form_label(form[password], null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form[password], {attr: {class: input_class, placeholder: '••••••••'}}) }}
                {{ form_errors(form[password]) }}
            </div>
            <div class="mb-5">
                {{ form_label(form[totp], null, {label_attr: {class: label_class}}) }}
                {{ form_widget(form[totp], {attr: {class: input_class ~ ' text-center font-mono !text-xl tracking-[.4em]', placeholder: '000000'}}) }}
                {{ form_errors(form[totp]) }}
            </div>

            <button type="submit" class="btn btn-primary w-full">Unlock</button>
            {{ form_end(form) }}

            <div class="mt-4 flex gap-2.5 items-start text-xs text-theme-secondarytextcolor leading-normal">
                <i class="ti ti-shield-check shrink-0 mt-px text-sm leading-none text-success-600" aria-hidden="true"></i>
                Your key and certificate are untouched - this only resets the PIN counter.
            </div>
        </div>
    </div>
{% endblock %}
