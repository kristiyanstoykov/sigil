{# Shared bits for the Certificate pages. Status labels and colors live on the
   CertificateDisplayStatus enum (label/badgeClass/dotClass/accentClass) -
   templates never hardcode a status string or its color. #}

{% macro badge(status, big = false) %}
    {% set size = big ? 'text-sm px-3 py-1' : 'text-xs px-2.5 py-0.5' %}
    <span class="inline-flex items-center gap-1.5 font-medium rounded-full whitespace-nowrap {{ status.badgeClass }} {{ size }}"><span class="w-1.5 h-1.5 rounded-full {{ status.dotClass }}"></span>{{ status.label }}</span>
{% endmacro %}

{# One place that says which Able Pro button variant each certificate action
   wears - severity language: primary=main, info=routine, warning=caution
   (pause/recover), success=go, danger=destroy. #}
{% macro action_class(action) %}
    {{- {
        download: 'btn-primary',
        change_pin: 'btn-outline-info',
        unlock: 'btn-outline-warning',
        hold: 'btn-outline-warning',
        resume: 'btn-outline-success',
        revoke: 'btn-danger',
    }[action] -}}
{% endmacro %}

{# First 16 hex chars of the serial, uppercased, grouped in fours: 5F12 9E3F C4F2 5132 #}
{% macro serial_short(serial) %}
    {%- set s = serial|upper -%}
    {{- [s|slice(0, 4), s|slice(4, 4), s|slice(8, 4), s|slice(12, 4)]|join(' ') -}}
{% endmacro %}

{% macro back_link(href, label) %}
    <a href="{{ href }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-theme-secondarytextcolor hover:text-theme-headings mb-4">
        <i class="ti ti-arrow-left text-sm leading-none" aria-hidden="true"></i>{{ label }}
    </a>
{% endmacro %}
