{# Shared bits for the Certificate pages - Flowbite badges.
   Status colors: active=green, locked=red, revoked=gray, expired=yellow. #}

{% macro badge(status, big = false) %}
    {% set size = big ? 'text-sm px-3 py-1' : 'text-xs px-2.5 py-0.5' %}
    {% if status == 'active' %}
        <span class="inline-flex items-center gap-1.5 font-medium rounded-full whitespace-nowrap bg-green-100 text-green-800 {{ size }}"><span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Active</span>
    {% elseif status == 'locked' %}
        <span class="inline-flex items-center gap-1.5 font-medium rounded-full whitespace-nowrap bg-red-100 text-red-800 {{ size }}"><span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>Locked</span>
    {% elseif status == 'revoked' %}
        <span class="inline-flex items-center gap-1.5 font-medium rounded-full whitespace-nowrap bg-gray-100 text-gray-800 {{ size }}"><span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Revoked</span>
    {% else %}
        <span class="inline-flex items-center gap-1.5 font-medium rounded-full whitespace-nowrap bg-yellow-100 text-yellow-800 {{ size }}"><span class="w-1.5 h-1.5 rounded-full bg-yellow-500"></span>Expired</span>
    {% endif %}
{% endmacro %}

{% macro accent_class(status) %}{{ status == 'active' ? 'bg-green-500' : (status == 'locked' ? 'bg-red-500' : (status == 'expired' ? 'bg-yellow-400' : 'bg-gray-400')) }}{% endmacro %}

{# First 16 hex chars of the serial, uppercased, grouped in fours: 5F12 9E3F C4F2 5132 #}
{% macro serial_short(serial) %}
    {%- set s = serial|upper -%}
    {{- [s|slice(0, 4), s|slice(4, 4), s|slice(8, 4), s|slice(12, 4)]|join(' ') -}}
{% endmacro %}

{% macro back_link(href, label) %}
    <a href="{{ href }}" class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-gray-900 mb-4">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>{{ label }}
    </a>
{% endmacro %}
