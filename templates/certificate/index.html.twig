{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}Certificates - Sigil{% endblock %}

{% block content %}
    {% set visible = certificates|filter(c => not c.displayStatus.revoked) %}
    {% set at_limit = visible|length >= max_certificates %}
    <div class="max-w-5xl mx-auto">

        {# header row #}
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 mb-6">
            <h1 class="text-2xl font-bold text-theme-headings">Your certificates</h1>
            <div class="flex items-center gap-3 shrink-0 max-sm:w-full max-sm:justify-between">
                <span class="text-sm text-theme-secondarytextcolor whitespace-nowrap">{{ visible|length }} of {{ max_certificates }}</span>
                {% if not at_limit %}
                    <a href="{{ path('app_certificate_new') }}" class="btn btn-primary inline-flex items-center gap-2 whitespace-nowrap">
                        <i class="ti ti-plus text-base leading-none" aria-hidden="true"></i>
                        New certificate
                    </a>
                {% endif %}
            </div>
        </div>

        {# at-limit note #}
        {% if at_limit %}
            <p class="mb-5 text-sm text-theme-secondarytextcolor">You have the maximum of {{ max_certificates }} certificates. Revoke one to issue another.</p>
        {% endif %}

        {# empty state #}
        {% if certificates is empty %}
            <div class="card !mb-0 px-8 py-12 text-center">
                <h2 class="text-xl font-bold text-theme-headings">No certificates yet</h2>
                <p class="mx-auto mt-2 mb-5 text-sm text-theme-secondarytextcolor max-w-md">A certificate is your signing identity. Issuing one takes about a minute.</p>
                <a href="{{ path('app_certificate_new') }}" class="btn btn-primary inline-flex items-center gap-2 mx-auto">
                    <i class="ti ti-plus text-base leading-none" aria-hidden="true"></i>
                    Create your first certificate
                </a>
            </div>
        {% else %}
            {# ID-card tiles; glass rises on hover per the brief. Status is a dot
               and a word, echoed by the theme's left edge (membership-dashboard calendar). #}
            <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                {% for cert in certificates %}
                    {% set status = cert.displayStatus %}
                    <a href="{{ path('app_certificate_show', {id: cert.id}) }}"
                       class="card !mb-0 block overflow-hidden transition hover:bg-white/70 hover:backdrop-blur-xl hover:shadow-md hover:border-white/70{{ status.revoked ? ' opacity-60 hover:opacity-100' : '' }}">
                      <div class="p-5 border-l-4 {{ status.borderClass }}">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="text-lg font-bold text-theme-headings truncate">{{ cert.user.firstName }} {{ cert.user.lastName }}</div>
                                <div class="mt-0.5 text-sm text-theme-secondarytextcolor truncate">{{ cert.subjectDn }}</div>
                            </div>
                            {{ helpers.status_dot(status) }}
                        </div>

                        <div class="mt-5 font-mono text-sm tracking-wider text-theme-bodycolor">{{ helpers.serial_short(cert.serialNumber) }}</div>

                        <dl class="mt-5 flex items-end justify-between gap-3">
                            <div class="min-w-0">
                                <dt class="text-xs text-theme-secondarytextcolor">Valid until</dt>
                                <dd class="mt-0.5 text-sm font-medium text-theme-headings whitespace-nowrap">{{ cert.notAfter|date('d M Y') }}</dd>
                            </div>
                            <div class="min-w-0 text-right">
                                <dt class="text-xs text-theme-secondarytextcolor">Algorithm</dt>
                                <dd class="mt-0.5 text-sm font-medium text-theme-headings truncate">{{ certificate_algorithm_label(cert) }}</dd>
                            </div>
                        </dl>
                      </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
