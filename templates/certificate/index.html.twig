{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}Certificates — Sigil{% endblock %}

{% block content %}
    {% set visible = certificates|filter(c => c.status.value != 'revoked') %}
    {% set at_limit = visible|length >= max_certificates %}
    <div class="max-w-5xl mx-auto">

        {# header row #}
        <div class="flex items-end justify-between gap-4 mb-6">
            <div>
                <h1 class="text-2xl font-extrabold tracking-tight text-body">Your certificates</h1>
                <p class="mt-1 text-[14px] text-muted">Your signing identities. Each one is a private key protected by its own PIN.</p>
            </div>
            <div class="flex items-center gap-3.5 shrink-0">
                <span class="text-[12.5px] font-semibold text-muted whitespace-nowrap">{{ visible|length }} of {{ max_certificates }}</span>
                {% if not at_limit %}
                    <a href="{{ path('app_certificate_new') }}" class="btn-primary w-auto inline-flex items-center gap-2 px-4 py-2.5 text-[13.5px] font-semibold rounded-[11px] text-white whitespace-nowrap">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                        New certificate
                    </a>
                {% endif %}
            </div>
        </div>

        {# at-limit note #}
        {% if at_limit %}
            <div class="flex items-center gap-3 px-4 py-3 mb-5 bg-primary/5 border border-primary/15 rounded-xl">
                <svg class="shrink-0 text-primary" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                <span class="text-[13px] text-label">You've reached the limit of <strong>{{ max_certificates }} certificates</strong>. Revoke one to issue a new identity.</span>
            </div>
        {% endif %}

        {# empty state #}
        {% if certificates is empty %}
            <div class="bg-surface border border-line rounded-2xl shadow-sm px-8 py-13 text-center">
                <div class="inline-flex w-15 h-15 items-center justify-center rounded-[18px] text-white mb-4 bg-gradient-to-b from-[#2A4BA0] to-primary shadow-[0_12px_26px_-10px_rgba(30,58,138,.55)]">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                </div>
                <h2 class="text-xl font-extrabold tracking-tight text-body">No certificates yet</h2>
                <p class="mx-auto mt-2 mb-5.5 text-[14px] text-muted max-w-105 leading-relaxed">A certificate is your cryptographic signing identity. Create one to start signing documents — it takes about a minute.</p>
                <a href="{{ path('app_certificate_new') }}" class="btn-primary w-auto inline-flex items-center gap-2 px-5.5 py-3 text-[14.5px] font-bold rounded-xl text-white">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    Create your first certificate
                </a>
            </div>
        {% else %}
            {# ID-card tiles #}
            <div class="grid gap-4.5 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
                {% for cert in certificates %}
                    {% set status = cert.status.value %}
                    <a href="{{ path('app_certificate_show', {id: cert.id}) }}"
                       class="block text-left border border-line rounded-[14px] bg-surface overflow-hidden relative shadow-sm transition-all duration-150 hover:-translate-y-[3px] hover:shadow-[0_18px_38px_-18px_rgba(30,58,138,.4)]">
                        <div class="relative px-4.5 pt-4.5 pb-4 bg-gradient-to-br from-[#FBFCFE] to-[#F1F5FB] overflow-hidden">
                            <div class="absolute inset-0 pointer-events-none opacity-50 cert-guilloche"></div>
                            <div class="absolute top-0 inset-x-0 h-1 {{ helpers.accent_class(status) }}"></div>

                            {# top row: label + chip #}
                            <div class="relative flex items-start justify-between gap-3 mb-4">
                                <div class="flex-1 min-w-0">
                                    <div class="text-[10px] font-extrabold tracking-[.16em] uppercase text-[color:var(--sigil-text-disabled)]">Signing certificate</div>
                                    <div class="mt-2 text-lg font-extrabold tracking-tight text-body truncate">{{ cert.user.firstName }} {{ cert.user.lastName }}</div>
                                    <div class="mt-0.5 text-[12.5px] text-muted truncate">{{ cert.subjectDn }}</div>
                                </div>
                                {# EMV chip motif #}
                                <div class="shrink-0 w-9.5 h-[29px] rounded-md relative bg-gradient-to-br from-[#C7D2FE] to-[#8CA6E8] shadow-[inset_0_0_0_1px_rgba(30,58,138,.25)]">
                                    <div class="absolute inset-[5px] rounded-[3px] bg-gradient-to-br from-[#E0E7FF] to-[#A9BEF0] shadow-[inset_0_0_0_1px_rgba(30,58,138,.2)]"></div>
                                    <div class="absolute top-1/2 left-0.5 right-0.5 h-px bg-primary/30"></div>
                                    <div class="absolute left-1/2 top-0.5 bottom-0.5 w-px bg-primary/30"></div>
                                </div>
                            </div>

                            {# serial, etched #}
                            <div class="relative font-mono text-[14px] font-semibold tracking-[.08em] text-label">{{ helpers.serial_short(cert.serialNumber) }}</div>

                            {# bottom row #}
                            <div class="relative flex items-end justify-between gap-3 mt-4">
                                <div class="min-w-0">
                                    <div class="text-[10px] font-bold tracking-[.1em] uppercase text-[color:var(--sigil-text-disabled)]">Valid until</div>
                                    <div class="mt-0.5 text-[13.5px] font-bold text-body whitespace-nowrap">{{ cert.notAfter|date('d M Y') }}</div>
                                    <div class="mt-1.5 text-[11.5px] text-[color:var(--sigil-text-disabled)] whitespace-nowrap">ECDSA P-384 · SHA-384</div>
                                </div>
                                {{ helpers.badge(status) }}
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
