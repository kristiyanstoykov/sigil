{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}New certificate - Sigil{% endblock %}

{% block content %}
    {% if at_limit %}
        <div class="max-w-xl mx-auto mt-6">
            {{ helpers.back_link(path('app_certificates'), 'Back to certificates') }}
            <div class="bg-white border border-gray-200 rounded-lg shadow-sm px-8 py-9 text-center">
                <div class="inline-flex w-12 h-12 items-center justify-center rounded-lg bg-primary-100 text-primary-700 mb-4">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                </div>
                <h2 class="text-xl font-bold text-gray-900">You're at the certificate limit</h2>
                <p class="mx-auto mt-2 mb-5 text-sm text-gray-500 max-w-md">You already hold the maximum of <strong>{{ max_certificates }} certificates</strong>. To issue a new signing identity, revoke one you no longer use.</p>
                <a href="{{ path('app_certificates') }}"
                   class="inline-flex py-2.5 px-5 text-sm font-medium text-gray-900 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-primary-700">Manage certificates</a>
            </div>
        </div>
    {% else %}
        <div class="max-w-xl mx-auto">
            {{ helpers.back_link(path('app_certificates'), 'Back to certificates') }}

            {# header #}
            <div class="text-center mb-6">
                <div class="inline-flex w-12 h-12 items-center justify-center rounded-lg bg-primary-700 text-white mb-3">
                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                </div>
                <h1 class="text-2xl font-bold text-gray-900">Create your certificate</h1>
                <p class="mx-auto mt-2 text-sm text-gray-500 max-w-md">This issues your cryptographic signing identity. Review the details, then choose a PIN to protect it.</p>
            </div>

            {# (a) subject preview #}
            <div class="mb-6">
                <div class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">Certificate subject</div>
                <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
                    <div class="flex items-center gap-2 mb-3 text-gray-400 text-xs font-medium uppercase tracking-wide">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 4v16"/></svg>
                        From your profile · read-only
                    </div>
                    <div class="flex flex-col gap-2.5 text-sm">
                        {% for label, value in subject_preview %}
                            {% if value %}
                                <div class="flex justify-between gap-3">
                                    <span class="text-gray-500">{{ label }}</span>
                                    <span class="{{ loop.first ? 'font-semibold' : 'font-medium' }} text-gray-900 text-right">{{ value }}</span>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <div class="mt-4 pt-3 border-t border-gray-100 flex items-center gap-2.5 text-sm text-gray-700">
                        <svg class="shrink-0 w-4 h-4 text-primary-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/></svg>
                        <span><strong class="text-gray-900">ECDSA P-384 with SHA-384</strong> · valid 1 year</span>
                    </div>
                </div>
                <p class="mt-2 text-xs text-gray-400">Taken from your profile. Update your name or company before issuing if these aren't right.</p>
            </div>

            {# (b) PIN choice #}
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">Protect it with a PIN</div>
                <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-5">
                    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    {% set label_class = 'block mb-2 text-sm font-medium text-gray-900' %}
                    {% set pin_class = 'bg-gray-50 border border-gray-300 text-gray-900 rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 text-sm font-mono tracking-[0.3em]' %}
                    {% set pin = constant('App\\Certificate\\Form\\NewCertificateForm::E_PIN') %}

                    <div class="flex gap-3">
                        <div class="flex-1">
                            {{ form_label(form[pin].first, 'Choose a PIN', {label_attr: {class: label_class}}) }}
                            {{ form_widget(form[pin].first, {attr: {class: pin_class, placeholder: '6–8 digits'}}) }}
                        </div>
                        <div class="flex-1">
                            {{ form_label(form[pin].second, 'Confirm PIN', {label_attr: {class: label_class}}) }}
                            {{ form_widget(form[pin].second, {attr: {class: pin_class, placeholder: 'Repeat'}}) }}
                        </div>
                    </div>
                    {# RepeatedType maps violations to its FIRST child - render all three origins #}
                    <div class="mb-4">
                        {{ form_errors(form[pin]) }}
                        {{ form_errors(form[pin].first) }}
                        {{ form_errors(form[pin].second) }}
                    </div>

                    <div class="flex items-start gap-3 p-4 mb-4 text-sm text-yellow-800 border border-yellow-200 rounded-lg bg-yellow-50" role="alert">
                        <svg class="shrink-0 w-4 h-4 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                        <div>
                            <strong>Keep this PIN safe.</strong> It protects your private key and is required every time you sign. For security, we can't recover it - if you forget it, you'll simply issue a fresh certificate.
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full inline-flex items-center justify-center gap-2 text-white bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-3 cursor-pointer">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                        Generate my certificate
                    </button>
                    <p class="mt-2.5 text-center text-xs text-gray-400">Generating a key pair takes a couple of seconds.</p>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
