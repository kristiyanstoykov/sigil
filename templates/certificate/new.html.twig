{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}New certificate - Sigil{% endblock %}

{% block content %}
    {% if at_limit %}
        <div class="max-w-xl mx-auto mt-6">
            {{ helpers.back_link(path('app_certificates'), 'Back to certificates') }}
            <div class="card !mb-0 px-8 py-9 text-center">
                <div class="inline-flex w-12 h-12 items-center justify-center rounded-lg bg-primary-500/10 text-primary-500 mb-4 mx-auto">
                    <i class="ti ti-info-circle text-2xl leading-none" aria-hidden="true"></i>
                </div>
                <h2 class="text-xl font-bold text-theme-headings">You're at the certificate limit</h2>
                <p class="mx-auto mt-2 mb-5 text-sm text-theme-secondarytextcolor max-w-md">You already hold the maximum of <strong>{{ max_certificates }} certificates</strong>. To issue a new signing identity, revoke one you no longer use.</p>
                <a href="{{ path('app_certificates') }}" class="btn btn-outline-secondary inline-flex mx-auto">Manage certificates</a>
            </div>
        </div>
    {% else %}
        <div class="max-w-xl mx-auto">
            {{ helpers.back_link(path('app_certificates'), 'Back to certificates') }}

            {# header #}
            <div class="text-center mb-6">
                <div class="inline-flex w-12 h-12 items-center justify-center rounded-lg bg-primary-500 text-white mb-3">
                    <i class="ti ti-shield-check text-2xl leading-none" aria-hidden="true"></i>
                </div>
                <h1 class="text-2xl font-bold text-theme-headings">Create your certificate</h1>
                <p class="mx-auto mt-2 text-sm text-theme-secondarytextcolor max-w-md">This issues your cryptographic signing identity. Review the details, then choose a PIN to protect it.</p>
            </div>

            {# (a) subject preview #}
            <div class="mb-6">
                <div class="text-xs font-semibold uppercase tracking-wide text-theme-secondarytextcolor mb-2">Certificate subject</div>
                <div class="card !mb-0 p-5">
                    <div class="flex items-center gap-2 mb-3 text-theme-secondarytextcolor text-xs font-medium uppercase tracking-wide">
                        <i class="ti ti-id text-sm leading-none" aria-hidden="true"></i>
                        From your profile · read-only
                    </div>
                    <div class="flex flex-col gap-2.5 text-sm">
                        {% for label, value in subject_preview %}
                            {% if value %}
                                <div class="flex justify-between gap-3">
                                    <span class="text-theme-secondarytextcolor">{{ label }}</span>
                                    <span class="{{ loop.first ? 'font-semibold' : 'font-medium' }} text-theme-headings text-right">{{ value }}</span>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    <div class="mt-4 pt-3 border-t border-theme-border/60 flex items-center gap-2.5 text-sm text-theme-bodycolor">
                        <i class="ti ti-shield-lock shrink-0 text-base leading-none text-primary-500" aria-hidden="true"></i>
                        <span><strong class="text-theme-headings">ECDSA P-384 with SHA-384</strong> · valid 1 year</span>
                    </div>
                </div>
                <p class="mt-2 text-xs text-theme-secondarytextcolor">Taken from your profile. Update your name or company before issuing if these aren't right.</p>
            </div>

            {# (b) PIN choice #}
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-theme-secondarytextcolor mb-2">Protect it with a PIN</div>
                <div class="card !mb-0 p-5">
                    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    {% set label_class = 'form-label text-sm font-medium' %}
                    {% set pin_class = 'form-control font-mono tracking-[0.3em]' %}
                    {% set pin = constant('App\\Certificate\\Form\\NewCertificateForm::E_PIN') %}

                    <div class="flex gap-3">
                        <div class="flex-1">
                            {{ form_label(form[pin].first, 'Choose a PIN', {label_attr: {class: label_class}}) }}
                            {{ form_widget(form[pin].first, {attr: {class: pin_class, placeholder: '6–8 digits'}}) }}
                        </div>
                        <div class="flex-1">
                            {{ form_label(form[pin].second, 'Confirm PIN', {label_attr: {class: label_class}}) }}
                            {{ form_widget(form[pin].second, {attr: {class: pin_class, placeholder: 'Repeat'}}) }}
                        </div>
                    </div>
                    {# RepeatedType maps violations to its FIRST child - render all three origins #}
                    <div class="mb-4">
                        {{ form_errors(form[pin]) }}
                        {{ form_errors(form[pin].first) }}
                        {{ form_errors(form[pin].second) }}
                    </div>

                    <div class="alert alert-warning flex items-start gap-3 !mb-4 text-sm" role="alert">
                        <i class="ti ti-lock shrink-0 text-base leading-none mt-0.5" aria-hidden="true"></i>
                        <div>
                            <strong>Keep this PIN safe.</strong> It protects your private key and is required every time you sign. For security, we can't recover it - if you forget it, you'll simply issue a fresh certificate.
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-full inline-flex items-center justify-center gap-2 !py-3">
                        <i class="ti ti-shield-check text-base leading-none" aria-hidden="true"></i>
                        Generate my certificate
                    </button>
                    <p class="mt-2.5 text-center text-xs text-theme-secondarytextcolor">Generating a key pair takes a couple of seconds.</p>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
