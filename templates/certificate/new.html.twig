{% extends 'layout/app.html.twig' %}
{% import 'certificate/_helpers.html.twig' as helpers %}

{% block title %}New certificate — Sigil{% endblock %}

{% block content %}
    {% if at_limit %}
        <div class="max-w-[560px] mx-auto mt-6">
            {{ helpers.back_link(path('app_certificates'), 'Back to certificates') }}
            <div class="bg-surface border border-line rounded-2xl shadow-sm px-8 py-9 text-center">
                <div class="inline-flex w-13 h-13 items-center justify-center rounded-[15px] bg-primary/8 text-primary mb-3.5">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                </div>
                <h2 class="text-[19px] font-extrabold text-body">You're at the certificate limit</h2>
                <p class="mx-auto mt-2 mb-5.5 text-[14px] text-muted max-w-100 leading-relaxed">You already hold the maximum of <strong>{{ max_certificates }} certificates</strong>. To issue a new signing identity, revoke one you no longer use.</p>
                <a href="{{ path('app_certificates') }}" class="inline-flex px-5 py-2.75 border border-line rounded-[11px] bg-surface text-[13.5px] font-semibold text-label hover:border-primary/40 transition-colors">Manage certificates</a>
            </div>
        </div>
    {% else %}
        <div class="max-w-[560px] mx-auto">
            {{ helpers.back_link(path('app_certificates'), 'Back to certificates') }}

            {# ceremony header #}
            <div class="text-center mb-6.5">
                <div class="inline-flex w-[54px] h-[54px] items-center justify-center rounded-2xl text-white mb-3.5 bg-gradient-to-b from-[#2A4BA0] to-primary shadow-[0_12px_26px_-10px_rgba(30,58,138,.55)]">
                    <svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                </div>
                <h1 class="text-2xl font-extrabold tracking-tight text-body">Create your certificate</h1>
                <p class="mx-auto mt-2 text-[14px] text-muted max-w-110 leading-relaxed">This issues your cryptographic signing identity. Review the details, then choose a PIN to protect it.</p>
            </div>

            {# (a) subject preview #}
            <div class="mb-6">
                <div class="text-[11px] font-extrabold tracking-[.12em] uppercase text-[color:var(--sigil-text-disabled)] mb-2.5">Certificate subject</div>
                <div class="border border-line rounded-[14px] overflow-hidden bg-surface shadow-sm">
                    <div class="h-1 bg-success"></div>
                    <div class="px-5 py-4.5">
                        <div class="flex items-center gap-2 mb-3.5 text-[color:var(--sigil-text-disabled)] text-[11.5px] font-bold tracking-[.06em] uppercase">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M8 4v16"/></svg>
                            From your profile · read-only
                        </div>
                        <div class="flex flex-col gap-2.75 text-[13.5px]">
                            {% for label, value in subject_preview %}
                                {% if value %}
                                    <div class="flex justify-between gap-3.5">
                                        <span class="text-[color:var(--sigil-text-disabled)]">{{ label }}</span>
                                        <span class="{{ loop.first ? 'font-bold' : 'font-semibold' }} text-body text-right">{{ value }}</span>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <div class="mt-4 pt-3.5 border-t border-[color:#F1F5F9] flex items-center gap-2.5 text-[12.5px] text-label">
                            <svg class="shrink-0 text-primary" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/></svg>
                            <span><strong class="text-body">ECDSA P-384 with SHA-384</strong> · valid 1 year</span>
                        </div>
                    </div>
                </div>
                <p class="mt-2.75 px-0.5 text-[11.5px] text-[color:var(--sigil-text-disabled)] leading-normal">Taken from your profile. Update your name or company before issuing if these aren't right.</p>
            </div>

            {# (b) PIN choice #}
            <div>
                <div class="text-[11px] font-extrabold tracking-[.12em] uppercase text-[color:var(--sigil-text-disabled)] mb-2.5">Protect it with a PIN</div>
                <div class="border border-line rounded-[14px] bg-surface shadow-sm p-5">
                    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                    {% set label_class = 'block text-[12.5px] font-semibold mb-1.5 text-label' %}
                    {% set pin = constant('App\\Certificate\\Form\\NewCertificateForm::E_PIN') %}

                    <div class="flex gap-3.5">
                        <div class="flex-1">
                            {{ form_label(form[pin].first, 'Choose a PIN', {label_attr: {class: label_class}}) }}
                            {{ form_widget(form[pin].first, {attr: {class: 'form-input pin-input', placeholder: '6–8 digits'}}) }}
                        </div>
                        <div class="flex-1">
                            {{ form_label(form[pin].second, 'Confirm PIN', {label_attr: {class: label_class}}) }}
                            {{ form_widget(form[pin].second, {attr: {class: 'form-input pin-input', placeholder: 'Repeat'}}) }}
                        </div>
                    </div>
                    {# RepeatedType maps violations to its FIRST child — render all three origins #}
                    <div class="mb-4">
                        {{ form_errors(form[pin]) }}
                        {{ form_errors(form[pin].first) }}
                        {{ form_errors(form[pin].second) }}
                    </div>

                    {# warning — prominent, not scary #}
                    <div class="flex gap-3 p-3.5 rounded-xl bg-warning/7 border border-warning/25 mb-4.5">
                        <span class="shrink-0 inline-flex w-7.5 h-7.5 items-center justify-center rounded-[9px] bg-warning/14 text-[color:#B45309]">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                        </span>
                        <div class="text-[12.5px] leading-relaxed text-[color:#7C5310]">
                            <strong class="text-[color:#78350F]">Keep this PIN safe.</strong> It protects your private key and is required every time you sign. For security, we can't recover it — if you forget it, you'll simply issue a fresh certificate.
                        </div>
                    </div>

                    <button type="submit" class="btn-primary inline-flex w-full items-center justify-center gap-2 py-3.25 text-[14.5px] font-bold rounded-[11px] text-white">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
                        Generate my certificate
                    </button>
                    <p class="mt-2.75 text-center text-[11.5px] text-[color:var(--sigil-text-disabled)]">Generating a key pair takes a couple of seconds.</p>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
