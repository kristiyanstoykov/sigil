# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Tests never send real mail and have no secrets vault, so provide a null transport.
MAILER_DSN=null://null
# Tests use the local-filesystem backend - no MinIO/AWS container required.
SIGIL_STORAGE_ACTIVE_BACKEND=local
# Tests never reach a network TSA - signatures are PAdES-B-B.
SIGIL_TSA_ACTIVE_BACKEND=none
